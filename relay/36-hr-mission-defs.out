### FUNC clinic_people.leave_allowance(integer)
CREATE OR REPLACE FUNCTION clinic_people.leave_allowance(p_year integer)
 RETURNS numeric
 LANGUAGE sql
 IMMUTABLE
AS $function$ select 30::numeric $function$

### END
### FUNC clinic_people.leave_break_labels(text[])
CREATE OR REPLACE FUNCTION clinic_people.leave_break_labels(p text[])
 RETURNS text[]
 LANGUAGE sql
 IMMUTABLE
AS $function$
  select coalesce(array_agg(case u.b
      when 'short_notice' then 'إخطار أقل من المطلوب'
      when 'retroactive' then 'بأثر رجعي'
      when 'casual_pace' then 'تجاوز توزيع العارضة (يومين في الشهر و3 أيام في الربع)'
      when 'sick_retroactive' then 'مرضي اتبلّغ بعد يومه'
      when 'no_certificate' then 'مفيش شهادة طبية خلال 48 ساعة'
      when 'excused' then 'استثناء من غياب'
      when 'over_balance' then 'أكتر من رصيد الأجازات'
      else u.b end order by u.o), '{}')
  from unnest(coalesce(p, '{}')) with ordinality u(b, o)
$function$

### END
### FUNC clinic_people.leave_notice_days(numeric)
CREATE OR REPLACE FUNCTION clinic_people.leave_notice_days(p_units numeric)
 RETURNS integer
 LANGUAGE sql
 IMMUTABLE
AS $function$
  select case when p_units <= 1 then 2 when p_units <= 3 then 3 when p_units <= 7 then 7 else 14 end
$function$

### END
### FUNC clinic_people.leave_refund(uuid,uuid)
CREATE OR REPLACE FUNCTION clinic_people.leave_refund(p_request uuid, p_actor uuid)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare r clinic_people.requests%rowtype; p clinic_people.people%rowtype; amt numeric; v uuid; n integer;
begin
  select * into r from clinic_people.requests where id = p_request;
  select * into p from clinic_people.people where id = r.person_id;
  if r.status <> 'approved' or r.kind <> 'leave' or p.finance_subject is null or r.refund_adjustment_id is not null then return null; end if;
  select coalesce(sum(greatest(pr.absence_day - case when r.leave_type = 'excused' then 0 else clinic_people.day_wage(r.person_id, a.day) end, 0)), 0), count(*) into amt, n /* unpaid leave balance 20261117020000 */
  from clinic_people.attendance a
  join lateral (select x.absence_day from clinic_people.pay_rules x
                 where x.person_id = a.person_id and x.status = 'approved' and a.day between x.valid_from and x.valid_to
                 order by x.valid_from desc limit 1) pr on true
  where a.person_id = r.person_id and a.status = 'approved' and a.actual_start is null and a.day between r.from_date and r.to_date
    and exists (select 1 from clinic_finance.business_requests b
                 where b.kind = 'payroll' and b.subject = p.finance_subject and b.status in ('pending', 'approved')
                   and (b.payload->>'month')::date = date_trunc('month', a.day)::date);
  if amt <= 0 then return null; end if;
  insert into clinic_people.pay_adjustments(person_id, month, kind, amount, reference, note, created_by)
  values (r.person_id, date_trunc('month', now() at time zone 'Africa/Cairo')::date, 'bonus', round(amt, 2),
          'LEAVE-REFUND-' || r.id,
          'رد خصم غياب ' || n || ' يوم (' || r.from_date || ' — ' || r.to_date || ') بعد اعتماد إجازة؛ مرتب الشهر كان اتبعت للحسابات',
          p_actor)
  returning id into v;
  update clinic_people.requests set refund_adjustment_id = v where id = r.id;
  insert into clinic_people.audit(actor_id, action, record_id, after_data)
  values (p_actor, 'leave_refund', r.id, jsonb_build_object('adjustment_id', v, 'amount', round(amt, 2), 'days', n));
  return v;
end $function$

### END
### FUNC clinic_people.leave_rules()
CREATE OR REPLACE FUNCTION clinic_people.leave_rules()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare
  today date := (now() at time zone 'Africa/Cairo')::date;
  days integer := new.to_date - new.from_date + 1;
  brk text[] := '{}';
  d date;
begin
  if new.kind <> 'leave' then new.leave_type := null; return new; end if;
  new.leave_type := coalesce(new.leave_type, 'annual');
  if new.leave_type in ('casual', 'sick', 'birth', 'excused') and new.units <> days then
    raise exception 'عدد أيام الإجازة لازم يساوي أيام الفترة';
  end if;
  if new.leave_type = 'annual' then
    if new.from_date < today then brk := brk || 'retroactive'::text;
    elsif new.from_date - today < clinic_people.leave_notice_days(new.units) then brk := brk || 'short_notice'::text; end if;
  elsif new.leave_type = 'casual' then
    if days > 2 then raise exception 'الإجازة العارضة يومين بالكتير في المرة (قانون العمل م 128)'; end if;
    if clinic_people.casual_days(new.person_id, date_trunc('year', new.from_date)::date,
         (date_trunc('year', new.from_date) + interval '1 year' - interval '1 day')::date) + days > 7 then
      raise exception 'الإجازة العارضة 7 أيام في السنة بالكتير (قانون العمل م 128)';
    end if;
    if new.from_date < today then brk := brk || 'retroactive'::text; end if;
    foreach d in array array[new.from_date, new.to_date] loop
      if clinic_people.casual_days(new.person_id, date_trunc('month', d)::date, (date_trunc('month', d) + interval '1 month' - interval '1 day')::date)
           + (select count(*) from generate_series(new.from_date, new.to_date, interval '1 day') g(x) where date_trunc('month', g.x) = date_trunc('month', d)) > 2
         or clinic_people.casual_days(new.person_id, date_trunc('quarter', d)::date, (date_trunc('quarter', d) + interval '3 months' - interval '1 day')::date)
           + (select count(*) from generate_series(new.from_date, new.to_date, interval '1 day') g(x) where date_trunc('quarter', g.x) = date_trunc('quarter', d)) > 3 then
        if not brk @> array['casual_pace'] then brk := brk || 'casual_pace'::text; end if;
      end if;
    end loop;
  elsif new.leave_type = 'sick' then
    if new.from_date < today then brk := brk || 'sick_retroactive'::text; end if;
  elsif new.leave_type = 'birth' then
    if days <> 1 then raise exception 'إجازة ولادة الطفل يوم واحد'; end if;
    if (select count(*) from clinic_people.requests r where r.person_id = new.person_id and r.kind = 'leave' and r.leave_type = 'birth'
          and r.status in ('pending', 'approved')) >= 3 then
      raise exception 'إجازة ولادة الطفل 3 مرات بالكتير طول مدة الخدمة (قانون العمل م 128)';
    end if;
  elsif new.leave_type = 'excused' then
    if not clinic_people.manage() then raise exception 'الاستثناء من الغياب للإدارة'; end if;
    brk := brk || 'excused'::text;
  end if;
  if cardinality(brk) > 0 and length(trim(coalesce(new.notice_reason, ''))) < 3 then
    raise exception 'الطلب خارج القواعد (%). اكتب سبب الاستثناء علشان المراجع يقرر', array_to_string(clinic_people.leave_break_labels(brk), '، ');
  end if;
  new.rule_breaks := brk;
  return new;
end $function$

### END
### FUNC clinic_people.manage()
CREATE OR REPLACE FUNCTION clinic_people.manage()
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$select exists(select 1 from public.admins where id=public.my_admin_id() and active and (has_hr_access or public.has_role('super_admin') or public.has_role('general_manager')))$function$

### END
### FUNC clinic_people.offboarding_net(uuid)
CREATE OR REPLACE FUNCTION clinic_people.offboarding_net(p_case uuid)
 RETURNS jsonb
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
  select jsonb_build_object('to_him', t.to_him, 'on_him', t.on_him, 'net', t.to_him - t.on_him)
  from (select coalesce(sum(amount) filter (where kind = 'due_to_him'), 0) to_him,
               coalesce(sum(amount) filter (where kind = 'due_on_him' or (kind = 'custody' and resolution = 'deducted')), 0) on_him
        from clinic_people.offboarding_lines where case_id = p_case) t
$function$

### END
### FUNC clinic_people.offboarding_view()
CREATE OR REPLACE FUNCTION clinic_people.offboarding_view()
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
  select public.my_admin_id() is not null and (clinic_people.manage() or clinic_finance.allowed('create') or clinic_finance.allowed('review'))
$function$

### END
### FUNC clinic_people.overtime_can_review(uuid)
CREATE OR REPLACE FUNCTION clinic_people.overtime_can_review(p_person uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
  select public.my_admin_id() is not null
     and not exists (select 1 from clinic_people.people p where p.id = p_person and p.admin_id = public.my_admin_id())
     and (clinic_people.manage() or exists (select 1 from clinic_people.people p join clinic_people.people m on m.id = p.manager_id
                                             where p.id = p_person and m.admin_id = public.my_admin_id() and m.status <> 'ended'))
$function$

### END
### FUNC clinic_people.overtime_counted_hours(uuid,date,date)
CREATE OR REPLACE FUNCTION clinic_people.overtime_counted_hours(p_person uuid, p_from date, p_to date)
 RETURNS numeric
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
  select coalesce(sum(x.counted_min), 0) / 60.0 from clinic_people.overtime_rows(p_from, p_to, p_person) x
$function$

### END
### FUNC clinic_people.overtime_rows(date,date,uuid)
CREATE OR REPLACE FUNCTION clinic_people.overtime_rows(p_from date, p_to date, p_person uuid DEFAULT NULL::uuid)
 RETURNS TABLE(person_id uuid, day date, scheduled_end timestamp with time zone, actual_end timestamp with time zone, close_at timestamp with time zone, recorded_min integer, capped_min integer, approved_min integer, counted_min integer, requests jsonb)
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
  with att as (
    select a.person_id, a.day, a.scheduled_end, a.actual_end, clinic_people.clinic_close_at(a.day) close_at
    from clinic_people.attendance a
    where a.day between p_from and p_to and a.status = 'approved' and a.actual_end is not null and a.actual_end > a.scheduled_end
      and (p_person is null or a.person_id = p_person)
  ), req as (
    select r.person_id, r.day, coalesce(sum(r.approved_minutes) filter (where r.status = 'approved'), 0)::int approved,
           jsonb_agg(jsonb_build_object('id', r.id, 'status', r.status, 'minutes', r.minutes, 'reason', r.reason, 'approved_minutes', r.approved_minutes,
             'expected_minutes', r.expected_minutes, 'extra_reason', r.extra_reason, 'review_note', r.review_note,
             'task_id', r.task_id, 'task_title', t.title, 'task_description', left(t.description, 600),
             'reviewed_by', (select coalesce(nullif(x.name, ''), x.email) from public.admins x where x.id = r.reviewed_by),
             'created_by', (select coalesce(nullif(x.name, ''), x.email) from public.admins x where x.id = r.created_by),
             'created_at', r.created_at) order by r.created_at) list
    from clinic_people.overtime_requests r left join public.tasks t on t.id = r.task_id
    where r.day between p_from and p_to and r.status <> 'cancelled' and (p_person is null or r.person_id = p_person)
    group by r.person_id, r.day
  )
  select a.person_id, a.day, a.scheduled_end, a.actual_end, a.close_at,
    floor(extract(epoch from (a.actual_end - a.scheduled_end)) / 60)::int,
    greatest(0, floor(extract(epoch from (least(a.actual_end, coalesce(a.close_at, a.actual_end)) - a.scheduled_end)) / 60))::int,
    coalesce(q.approved, 0),
    least(greatest(0, floor(extract(epoch from (least(a.actual_end, coalesce(a.close_at, a.actual_end)) - a.scheduled_end)) / 60))::int, coalesce(q.approved, 0)),
    coalesce(q.list, '[]'::jsonb)
  from att a left join req q on q.person_id = a.person_id and q.day = a.day
$function$

### END
### FUNC clinic_people.payroll_before_overtime_control(uuid,date)
CREATE OR REPLACE FUNCTION clinic_people.payroll_before_overtime_control(p_person uuid, p_month date)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare p clinic_people.people%rowtype;r clinic_people.pay_rules%rowtype;c clinic_finance.business_requests%rowtype;dt date:=date_trunc('month',p_month)::date;last_day date:=(dt+interval '1 month'-interval '1 day')::date;late numeric;absent int;extra numeric;bonus numeric;ded numeric;comm numeric;n int;dc numeric:=0;gross numeric;offs numeric:=0;dedu numeric;unpaid numeric:=0;begin
 if not clinic_people.manage() or not clinic_finance.allowed('create') then raise exception 'تحتاج إدارة الموارد البشرية وصلاحية إنشاء استحقاق بالحسابات';end if;
 select * into p from clinic_people.people where id=p_person and status<>'ended';if not found or p.finance_subject is null then raise exception 'اربط الموظف بعقد المرتب أولًا';end if;
 select * into c from clinic_finance.business_requests where kind='employment' and status='approved' and subject=p.finance_subject and dt>=(payload->>'from')::date and last_day<=(payload->>'to')::date;
 if not found then raise exception 'يلزم عقد موظف معتمد يغطي الشهر بالكامل';end if;
 select * into r from clinic_people.pay_rules where person_id=p.id and status='approved' and dt>=valid_from and last_day<=valid_to;
 if not found then raise exception 'اعتمد قواعد أجر تغطي الشهر بالكامل';end if;
 if exists(select 1 from clinic_people.attendance where person_id=p.id and day between dt and last_day and (status='pending' or status='approved' and actual_start is not null and actual_end is null)) then raise exception 'راجع الحضور المعلق أو بصمات الخروج الناقصة أولًا';end if;
 select coalesce(sum((case when scheduled_end-scheduled_start>interval '12 hours' then 2 else 1 end)),0) /* double-shift payroll */,coalesce(sum(case when actual_start is not null then greatest(0,extract(epoch from(actual_start-case when (case when scheduled_end-scheduled_start>interval '12 hours' then 2 else 1 end)=2 and actual_start>=(scheduled_start+(scheduled_end-scheduled_start)/2) then (scheduled_start+(scheduled_end-scheduled_start)/2) else scheduled_start end))/60-r.late_grace) else 0 end),0),coalesce(sum(case when actual_start is null then (case when scheduled_end-scheduled_start>interval '12 hours' then 2 else 1 end) when (case when scheduled_end-scheduled_start>interval '12 hours' then 2 else 1 end)=2 and (actual_start>=(scheduled_start+(scheduled_end-scheduled_start)/2) or actual_end<=(scheduled_start+(scheduled_end-scheduled_start)/2)) then 1 else 0 end) filter(where not exists(select 1 from clinic_people.requests q where q.person_id=p.id and q.status='approved' and q.kind='leave' and clinic_people.attendance.day between q.from_date and q.to_date) and not clinic_people.center_closed_on(clinic_people.attendance.day)),0),coalesce(sum(case when actual_end is not null then greatest(0,extract(epoch from(actual_end-scheduled_end))/3600) else 0 end),0) into n,late,absent,extra from clinic_people.attendance where person_id=p.id and day between dt and last_day and status='approved';
 if n=0 then raise exception 'لا يوجد جدول ورديات وحضور معتمد للشهر';end if;
 select coalesce(sum(amount) filter(where kind='bonus'),0),coalesce(sum(amount) filter(where kind='deduction'),0),coalesce(sum(amount) filter(where kind='commission'),0) into bonus,ded,comm from clinic_people.pay_adjustments where person_id=p.id and month=dt and status='approved';
 if exists(select 1 from clinic_people.pay_adjustments where person_id=p.id and month=dt and status='pending') then raise exception 'راجع المكافآت والخصومات والنسب المعلقة أولًا';end if;
 -- Guaranteed minimum (owner decision 2026-11-15): the person receives the HIGHER of the contract salary and the commission
 -- earned in the month (doctor-ledger fees on invoices of the month + approved employee commission adjustments), never the sum.
 -- The doctor ledger keeps paying its fees; payroll pays only what is left of the salary: offset = least(commission, base).
 if r.guaranteed_minimum then
  if p.doctor_key is not null then
   select coalesce(sum(x.delta),0) into dc from clinic_finance.doctor_accruals x join clinic_finance.invoices i on i.id=x.invoice_id
    where x.doctor_key=p.doctor_key and (i.created_at at time zone 'Africa/Cairo')::date between dt and last_day;
  end if;
  offs:=round(least(greatest(dc,0)+comm,c.amount),2);
 end if;
 gross:=round(c.amount+bonus+comm+extra*r.overtime_hour,2);
 -- unpaid leave balance 20261117020000: approved leave (not excused) is unpaid: one day's wage per leave day, closures excluded.
 select coalesce(sum(q.units/(q.to_date-q.from_date+1)::numeric*(select count(*) from generate_series(greatest(q.from_date,dt),least(q.to_date,last_day),interval '1 day') g where not clinic_people.center_closed_on(g::date))),0) into unpaid
   from clinic_people.requests q where q.person_id=p.id and q.kind='leave' and q.status='approved' and q.leave_type<>'excused' and q.from_date<=last_day and q.to_date>=dt;
 dedu:=least(round(ded+late*r.late_minute+absent*r.absence_day+offs+unpaid*c.amount/30,2),gross);
 return jsonb_build_object('person_id',p.id,'subject',p.finance_subject,'contract_id',c.id,'month',dt,'base',c.amount,'rule_id',r.id,'approved_shifts',n,'late_minutes',round(late,2),'absent_shifts',absent,'overtime_hours',round(extra,2),'bonus',bonus,'commission',comm,'allowance',round(bonus+comm+extra*r.overtime_hour,2),'salary_deduction',dedu,'pre_tax_net',gross-dedu,'guaranteed_minimum',r.guaranteed_minimum,'doctor_commission',round(dc,2),'guarantee_offset',offs,'unpaid_leave_days',round(unpaid,2),'unpaid_leave_deduction',round(unpaid*c.amount/30,2),'scope','المحاسبة تشمل الورديات المسجلة والمعتمدة فقط؛ راجع اكتمال جدول الشهر','doctor_commission_separate',p.doctor_key is not null);
end $function$

### END
### FUNC clinic_people.role_holder(text)
CREATE OR REPLACE FUNCTION clinic_people.role_holder(p_role text)
 RETURNS uuid
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
  select a.id from public.admins a
   where a.active and public.has_role_for(a.id, p_role)
   order by (a.role = p_role) desc, a.created_at, a.id
   limit 1
$function$

### END
### FUNC clinic_people.salary_visible()
CREATE OR REPLACE FUNCTION clinic_people.salary_visible()
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
  select public.my_admin_id() is not null and (public.has_role('super_admin') or public.has_role('accountant') or public.has_role('financial_manager'))
$function$

### END
### FUNC clinic_people.swap_conflict(clinic_people.shift_swaps)
CREATE OR REPLACE FUNCTION clinic_people.swap_conflict(s clinic_people.shift_swaps)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
  select exists (
    select 1 from (values (s.requester_id, s.day_a), (s.partner_id, s.day_a), (s.requester_id, s.day_b), (s.partner_id, s.day_b)) v(pid, d)
    where v.d is not null and v.pid is not null and (
      exists (select 1 from clinic_people.shift_overrides o where o.active and o.person_id = v.pid and o.day = v.d)
      or exists (select 1 from clinic_people.shift_swaps x where x.id <> s.id and x.status in ('pending_partner', 'pending_manager', 'approved')
                   and (v.pid = x.requester_id or v.pid = x.partner_id) and (v.d = x.day_a or v.d = x.day_b))))
$function$

### END
### FUNC clinic_people.swap_first_start(clinic_people.shift_swaps)
CREATE OR REPLACE FUNCTION clinic_people.swap_first_start(s clinic_people.shift_swaps)
 RETURNS timestamp with time zone
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
  select min((x.day + t.start_time) at time zone 'Africa/Cairo')
  from (select p.person_id, p.day, p.template_id as tid from clinic_people.swap_plan(s) p
        union all select p.person_id, p.day, (clinic_people.weekly_slot(p.person_id, p.day)).template_id from clinic_people.swap_plan(s) p) x
  join clinic_people.shift_templates t on t.id = x.tid
$function$

### END
### FUNC clinic_people.swap_notify(uuid,text)
CREATE OR REPLACE FUNCTION clinic_people.swap_notify(p_person uuid, p_message text)
 RETURNS void
 LANGUAGE sql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
  insert into public.task_notifications(recipient_id, task_id, kind, message)
  select p.admin_id, null, 'status', p_message from clinic_people.people p join public.admins a on a.id = p.admin_id and a.active where p.id = p_person
$function$

### END
### FUNC clinic_people.swap_plan(clinic_people.shift_swaps)
CREATE OR REPLACE FUNCTION clinic_people.swap_plan(s clinic_people.shift_swaps)
 RETURNS TABLE(person_id uuid, day date, template_id uuid)
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare ra record; pa record; rb record; pb record;
begin
  select * into ra from clinic_people.weekly_slot(s.requester_id, s.day_a);
  if not ra.scheduled then raise exception 'لازم يكون لصاحب الطلب جدول ورديات في يوم التبديل'; end if;
  if s.kind = 'credit_use' then
    if ra.template_id is null then raise exception 'اختر يوم شغل لاستخدام اليوم البديل'; end if;
    return query select s.requester_id, s.day_a, null::uuid;
    return;
  end if;
  select * into pa from clinic_people.weekly_slot(s.partner_id, s.day_a);
  if not pa.scheduled then raise exception 'لازم يكون للطرفين جدول ورديات في يوم التبديل'; end if;
  if s.kind = 'same_day' then
    if ra.template_id is not distinct from pa.template_id then raise exception 'نفس الوردية للطرفين؛ لا يوجد ما يُبدَّل'; end if;
    return query select s.requester_id, s.day_a, pa.template_id union all select s.partner_id, s.day_a, ra.template_id;
  elsif s.kind = 'cover' then
    if ra.template_id is null then raise exception 'صاحب الطلب ليس عنده وردية في هذا اليوم'; end if;
    if pa.template_id is not null then raise exception 'الزميل يعمل أصلًا في هذا اليوم'; end if;
    return query select s.requester_id, s.day_a, null::uuid union all select s.partner_id, s.day_a, ra.template_id;
  else
    select * into rb from clinic_people.weekly_slot(s.requester_id, s.day_b);
    select * into pb from clinic_people.weekly_slot(s.partner_id, s.day_b);
    if not rb.scheduled or not pb.scheduled then raise exception 'لازم يكون للطرفين جدول ورديات في اليومين'; end if;
    if ra.template_id is null then raise exception 'طالب التبديل ليس عنده وردية في اليوم الأول'; end if;
    if pb.template_id is null then raise exception 'الزميل ليس عنده وردية في اليوم الثاني'; end if;
    if pa.template_id is not null then raise exception 'الزميل يعمل أصلًا في اليوم الأول'; end if;
    if rb.template_id is not null then raise exception 'طالب التبديل يعمل أصلًا في اليوم الثاني'; end if;
    return query select s.requester_id, s.day_a, null::uuid union all select s.requester_id, s.day_b, pb.template_id
      union all select s.partner_id, s.day_b, null::uuid union all select s.partner_id, s.day_a, ra.template_id;
  end if;
end $function$

### END
### FUNC clinic_people.visible(uuid)
CREATE OR REPLACE FUNCTION clinic_people.visible(p_person uuid)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$select public.my_admin_id() is not null and exists(select 1 from clinic_people.people where id=p_person and (clinic_people.manage() or admin_id=public.my_admin_id()))$function$

### END
### FUNC clinic_people.weekly_slot(uuid,date)
CREATE OR REPLACE FUNCTION clinic_people.weekly_slot(p_person uuid, p_day date, OUT scheduled boolean, OUT template_id uuid)
 RETURNS record
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
  select count(x.*) > 0, max(x.template_id::text)::uuid from (
    select ps.template_id from clinic_people.person_shifts ps
     where ps.person_id = p_person and ps.dow = extract(dow from p_day)::int and ps.valid_from <= p_day and (ps.valid_to is null or ps.valid_to >= p_day)
     order by ps.valid_from desc, ps.id desc limit 1) x
$function$

### END
### FUNC administrative_assistant_payroll_audit(date)
CREATE OR REPLACE FUNCTION public.administrative_assistant_payroll_audit(p_month date DEFAULT NULL::date)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare
  dt date := coalesce(date_trunc('month',p_month)::date,date_trunc('month',current_date)::date);
begin
  if not public.business_manager() then raise exception 'غير مصرح'; end if;
  return coalesce((
    select jsonb_agg(row_to_json(x)::jsonb order by x.created_at desc)
    from (
      select
        br.id,
        br.subject,
        br.amount,
        br.status,
        br.created_at,
        br.payload->>'month' as month,
        coalesce((br.payload->'hr_calculation'->>'base')::numeric,0) as base_salary,
        coalesce((br.payload->'hr_calculation'->>'allowance')::numeric,0) as allowance,
        coalesce((br.payload->'hr_calculation'->>'salary_deduction')::numeric,0) as salary_deduction,
        coalesce((br.payload->'hr_calculation'->>'late_minutes')::numeric,0) as late_minutes,
        coalesce((br.payload->'hr_calculation'->>'absent_shifts')::int,0) as absent_shifts,
        coalesce((br.payload->'hr_calculation'->>'approved_shifts')::int,0) as approved_shifts,
        prev.amount as previous_amount,
        case when prev.amount is null then null else round(br.amount-prev.amount,2) end as amount_difference,
        (br.payload->'hr_calculation' is null) as missing_hr_calculation,
        (
          br.payload->'hr_calculation' is null
          or coalesce((br.payload->'hr_calculation'->>'salary_deduction')::numeric,0) < 0
          or (coalesce((br.payload->'hr_calculation'->>'absent_shifts')::int,0)>0 and coalesce((br.payload->'hr_calculation'->>'salary_deduction')::numeric,0)=0)
          or (prev.amount is not null and br.amount<>prev.amount)
        ) as requires_owner_review,
        case
          when br.payload->'hr_calculation' is null then 'كشف المرتب لا يحتوي على حساب الموارد البشرية المعتمد'
          when coalesce((br.payload->'hr_calculation'->>'absent_shifts')::int,0)>0 and coalesce((br.payload->'hr_calculation'->>'salary_deduction')::numeric,0)=0 then 'يوجد غياب مسجل ولا يظهر خصم في حساب المرتب؛ يحتاج قرار المالك'
          when prev.amount is not null and br.amount<>prev.amount then 'قيمة المرتب مختلفة عن آخر كشف؛ اعرض الفرق على المالك'
          else 'مطابق للفحص الأولي ويمكن اعتباره طبيعيًا إذا لم توجد ملاحظات أخرى'
        end as assistant_reason
      from clinic_finance.business_requests br
      left join lateral (
        select p.amount
        from clinic_finance.business_requests p
        where p.kind='payroll' and p.subject=br.subject and p.id<>br.id and p.status='approved' and p.created_at<br.created_at
        order by p.created_at desc limit 1
      ) prev on true
      where br.kind='payroll'
        and coalesce(nullif(br.payload->>'month','')::date,date_trunc('month',br.created_at)::date)=dt
        and br.status in ('pending','approved')
    ) x
  ),'[]'::jsonb);
end $function$

### END
### FUNC clinic_booking_shift(text,jsonb,uuid)
CREATE OR REPLACE FUNCTION public.clinic_booking_shift(p_action text, p_payload jsonb, p_token uuid)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare me uuid:=clinic_finance.booking_access('create');s clinic_finance.shifts%rowtype;v uuid;c record;total numeric:=0;begin perform clinic_finance.lock_day();
if p_action='open' then select * into s from clinic_finance.shifts where cashier_id=me and token=p_token;if found then return s.id;end if;
 insert into clinic_finance.shifts(register_id,cashier_id,token,opening_book) select r.id,me,p_token,coalesce((select sum(l.debit-l.credit) from clinic_finance.lines l join clinic_finance.entries e on e.id=l.entry_id join clinic_finance.shifts sh on sh.id=e.shift_id where sh.register_id=r.id and clinic_finance.is_cash_account(l.account)),0) from clinic_finance.registers r where r.id=(p_payload->>'register_id')::uuid returning id into v;if v is null then raise exception 'اختر خزينة مسجلة';end if;
elsif p_action='close' then
 v:=(p_payload->>'shift_id')::uuid;perform clinic_finance.check_shift(v);if clinic_finance.has_pending_shift(v) then raise exception 'توجد طلبات معلقة على الوردية';end if;
 if jsonb_typeof(p_payload->'counts') is distinct from 'object' or p_payload->'counts'='{}'::jsonb then raise exception 'أدخل جرد الفئات';end if;
 for c in select key,value from jsonb_each_text(p_payload->'counts') loop if c.key not in ('200','100','50','20','10','5','1','0.5','0.25') or c.value is null or c.value!~'^[0-9]{1,7}$' then raise exception 'الفئات أو أعدادها غير صالحة';end if;total:=total+c.key::numeric*c.value::numeric;end loop;
 update clinic_finance.shifts set counted=total,denominations=p_payload->'counts',note=left(coalesce(p_payload->>'note',''),1000),status='submitted',closed_at=now() where id=v;
else raise exception 'إجراء غير معروف';end if;insert into clinic_finance.audit(actor,action,entity_id) values(me,'reception_shift_'||p_action,v);return v;end $function$

### END
### FUNC clinic_finance_close_shift(uuid,jsonb,text)
CREATE OR REPLACE FUNCTION public.clinic_finance_close_shift(p_shift uuid, p_counts jsonb, p_note text)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$begin perform clinic_finance.require_access('create');perform clinic_finance.lock_day();if clinic_finance.has_pending_shift(p_shift) then raise exception 'توجد طلبات معلقة على الوردية';end if;return clinic_finance.advance_close_shift_base(p_shift,p_counts,p_note);end $function$

### END
### FUNC clinic_finance_my_shift_collections()
CREATE OR REPLACE FUNCTION public.clinic_finance_my_shift_collections()
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare me uuid:=public.my_admin_id();
begin
 if me is null or not exists(select 1 from public.admins where id=me and active) then raise exception 'سجل الدخول' using errcode='42501';end if;
 return coalesce((select jsonb_agg(jsonb_build_object('shift_id',fs.id,'register_name',reg.name,'opened_at',fs.opened_at,
   'methods',coalesce((select jsonb_agg(jsonb_build_object('method',m.method,'receipts',m.n,'amount',m.total) order by m.method) from (
      select x.method,count(*) n,sum(x.amount) total from (
        select rp.method,rp.amount from clinic_reception.payments rp join clinic_reception.shifts rs on rs.id=rp.shift_id where rs.finance_shift_id=fs.id
        union all
        select fp.method,fp.amount from clinic_finance.payments fp where fp.shift_id=fs.id and not exists(select 1 from clinic_reception.payments rp2 where rp2.finance_payment_id=fp.id)
      ) x group by x.method) m),'[]'::jsonb)) order by fs.opened_at)
  from clinic_finance.shifts fs join clinic_finance.registers reg on reg.id=fs.register_id
  where fs.cashier_id=me and fs.status='open'),'[]'::jsonb);
end $function$

### END
### FUNC clinic_finance_open_shift(uuid,uuid)
CREATE OR REPLACE FUNCTION public.clinic_finance_open_shift(p_register uuid, p_token uuid)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare me uuid:=clinic_finance.require_access('create');r clinic_finance.shifts%rowtype;v_id uuid;opening numeric;
begin perform clinic_finance.lock_day();select * into r from clinic_finance.shifts where cashier_id=me and token=p_token;if found then if r.register_id is distinct from p_register then raise exception 'مفتاح الطلب مستخدم لعملية مختلفة';end if;return r.id;end if;
 perform 1 from clinic_finance.registers where id=p_register;if not found then raise exception 'الخزينة غير موجودة';end if;
 select coalesce(sum(l.debit-l.credit),0) into opening from clinic_finance.lines l join clinic_finance.entries e on e.id=l.entry_id join clinic_finance.shifts s on s.id=e.shift_id where s.register_id=p_register and clinic_finance.is_cash_account(l.account);
 insert into clinic_finance.shifts(register_id,cashier_id,token,opening_book) values(p_register,me,p_token,opening) returning id into v_id;insert into clinic_finance.audit(actor,action,entity_id) values(me,'shift_opened',v_id);return v_id;end $function$

### END
### FUNC clinic_finance_review_shift(uuid,text)
CREATE OR REPLACE FUNCTION public.clinic_finance_review_shift(p_shift uuid, p_note text)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare me uuid:=clinic_finance.require_access('review');s clinic_finance.shifts%rowtype;
begin perform clinic_finance.lock_day();select * into s from clinic_finance.shifts where id=p_shift for update;
 if found and s.status='reviewed' and s.reviewed_by=me and s.review_note=trim(p_note) then return p_shift;end if;
 if not found or s.status<>'submitted' then raise exception 'الوردية غير جاهزة للمراجعة';end if;if s.cashier_id=me then raise exception 'لا يمكن مراجعة ورديتك بنفسك';end if;
 if length(trim(coalesce(p_note,'')))<3 then raise exception 'سجل نتيجة المراجعة حتى عند وجود فرق';end if;
 update clinic_finance.shifts set status='reviewed',review_note=trim(p_note),reviewed_by=me,reviewed_at=now() where id=p_shift;
 insert into clinic_finance.audit(actor,action,entity_id,detail) values(me,'shift_reviewed',p_shift,jsonb_build_object('difference',s.counted-clinic_finance.shift_cash(p_shift),'note',trim(p_note)));return p_shift;end $function$

### END
### FUNC clinic_finance_shift_expense(text,jsonb)
CREATE OR REPLACE FUNCTION public.clinic_finance_shift_expense(p_action text, p jsonb DEFAULT '{}'::jsonb)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare me uuid := public.my_admin_id(); sh record; it jsonb; amt numeric; left_ numeric; cash numeric; ev text; v uuid; r clinic_finance.requests%rowtype;
  why text; f date; t date;
begin
  if me is null then raise exception 'سجل الدخول'; end if;
  if p_action = 'status' then
    select s.id, s.register_id, x.name, x.shift_expense_allowance a, x.shift_expense_max m into sh
      from clinic_finance.shifts s join clinic_finance.registers x on x.id = s.register_id
      where s.cashier_id = me and s.status = 'open' order by s.opened_at desc limit 1;
    if not found then return jsonb_build_object('open', false); end if;
    return jsonb_build_object('open', true, 'shift_id', sh.id, 'register', sh.name, 'allowance', sh.a, 'max', sh.m,
      'spent', clinic_finance.shift_expense_spent(sh.id), 'cash', clinic_finance.shift_cash(sh.id), 'items', clinic_finance.shift_expense_items(),
      'expenses', coalesce((select jsonb_agg(jsonb_build_object('id', q.id, 'at', q.created_at, 'amount', q.amount, 'item', q.payload->>'item_label',
          'reason', q.reason, 'vendor', q.payload->>'vendor', 'post_review', q.post_review) order by q.created_at desc)
        from clinic_finance.requests q where q.shift_id = sh.id and q.payload->>'source' = 'shift_allowance'), '[]'));
  elsif p_action = 'spend' then
    perform clinic_finance.lock_day();
    select * into r from clinic_finance.requests q where q.created_by = me and q.token = nullif(p->>'token', '')::uuid;
    if found then return jsonb_build_object('id', r.id, 'amount', r.amount, 'duplicate', true); end if;
    select s.id, s.register_id, x.shift_expense_allowance a, x.shift_expense_max m into sh
      from clinic_finance.shifts s join clinic_finance.registers x on x.id = s.register_id
      where s.id = nullif(p->>'shift_id', '')::uuid and s.cashier_id = me and s.status = 'open' for update of s;
    if not found then raise exception 'اختار ورديتك المفتوحة'; end if;
    if sh.a <= 0 or sh.m <= 0 then raise exception 'مصروفات الوردية مش مفعّلة للخزنة دي — كلّم الحسابات'; end if;
    select e into it from jsonb_array_elements(clinic_finance.shift_expense_items()) e where e->>'key' = p->>'item';
    if it is null then raise exception 'اختار البند'; end if;
    amt := round(coalesce(nullif(p->>'amount', '')::numeric, 0), 2);
    why := btrim(coalesce(p->>'reason', ''));
    if amt <= 0 then raise exception 'اكتب المبلغ'; end if;
    if length(why) < 3 then raise exception 'اكتب السبب / التفاصيل'; end if;
    if amt > sh.m then raise exception 'المبلغ أكبر من حد المصروف الواحد (% جنيه) — اطلبه من الحسابات', sh.m using hint = 'over_max'; end if;
    left_ := sh.a - clinic_finance.shift_expense_spent(sh.id);
    if amt > left_ then raise exception 'المبلغ أكبر من الباقي من مصروفات الوردية (% جنيه) — اطلبه من الحسابات', greatest(left_, 0) using hint = 'over_allowance'; end if;
    cash := clinic_finance.shift_cash(sh.id);
    if amt > cash then raise exception 'النقدية اللي في الوردية (% جنيه) أقل من المبلغ', cash using hint = 'over_cash'; end if;
    ev := btrim(coalesce(p->>'receipt_path', ''));
    if coalesce((it->>'no_receipt')::boolean, false) then
      if ev <> '' then raise exception 'البند ده من غير إيصال — شيل الصورة'; end if;
      if length(why) < 5 then raise exception 'اكتب سبب الإكرامية بالتفصيل (لمين وليه)'; end if;
      ev := 'no-receipt';   -- requests.evidence is required (2..200): a fixed marker, the screen shows «من غير إيصال»
    elsif ev = '' or split_part(ev, '/', 1) <> auth.uid()::text
       or not exists (select 1 from storage.objects o where o.bucket_id = 'shift-expense-receipts' and o.name = ev) then
      raise exception 'صوّر الإيصال وارفعه الأول';
    end if;
    insert into clinic_finance.requests(kind, shift_id, amount, reason, evidence, payload, created_by, token, status, reviewed_at, review_note, post_review)
      values ('expense', sh.id, amt, left(it->>'label' || ' — ' || why, 1000), left(ev, 200),
        jsonb_build_object('source', 'shift_allowance', 'item', it->>'key', 'item_label', it->>'label', 'account', it->>'account',
          'vendor', left(btrim(coalesce(p->>'vendor', '')), 120)),
        me, coalesce(nullif(p->>'token', '')::uuid, gen_random_uuid()), 'approved', now(), 'اعتماد تلقائي — في حدود مصروفات الوردية', 'pending')
      returning id into v;
    perform clinic_finance.post('shift_expense', v, 'مصروفات الوردية — ' || (it->>'label'), sh.id, it->>'account', '1111', amt);
    insert into clinic_finance.audit(actor, action, entity_id, detail) values (me, 'shift_expense', v, jsonb_build_object('amount', amt, 'item', it->>'key', 'shift', sh.id));
    return jsonb_build_object('id', v, 'amount', amt, 'left', left_ - amt);
  elsif p_action = 'list' then
    if not clinic_finance.allowed('view') then raise exception 'للحسابات بس' using errcode = '42501'; end if;
    f := coalesce(nullif(p->>'from', '')::date, date_trunc('month', now() at time zone 'Africa/Cairo')::date);
    t := coalesce(nullif(p->>'to', '')::date, (now() at time zone 'Africa/Cairo')::date);
    return jsonb_build_object('from', f, 'to', t, 'can_review', clinic_finance.allowed('review'), 'items', clinic_finance.shift_expense_items(),
      'registers', coalesce((select jsonb_agg(jsonb_build_object('id', x.id, 'name', x.name, 'kind', x.treasury_kind, 'allowance', x.shift_expense_allowance, 'max', x.shift_expense_max) order by x.name)
        from clinic_finance.registers x), '[]'),
      'expenses', coalesce((select jsonb_agg(jsonb_build_object('id', q.id, 'at', q.created_at, 'amount', q.amount, 'item', q.payload->>'item_label',
          'reason', q.reason, 'vendor', q.payload->>'vendor', 'receipt', q.evidence, 'by', ad.name, 'register', x.name, 'post_review', q.post_review,
          'reviewed_by', rv.name, 'review_note', q.post_review_note, 'own', q.created_by = me) order by q.created_at desc)
        from clinic_finance.requests q join clinic_finance.shifts s on s.id = q.shift_id join clinic_finance.registers x on x.id = s.register_id
        left join public.admins ad on ad.id = q.created_by left join public.admins rv on rv.id = q.post_reviewed_by
        where q.payload->>'source' = 'shift_allowance' and (q.created_at at time zone 'Africa/Cairo')::date between f and t), '[]'));
  elsif p_action = 'review' then
    if not clinic_finance.allowed('review') then raise exception 'مراجعة مصروفات الورديات للحسابات بس' using errcode = '42501'; end if;
    select * into r from clinic_finance.requests where id = nullif(p->>'id', '')::uuid and payload->>'source' = 'shift_allowance' for update;
    if not found then raise exception 'المصروف مش موجود'; end if;
    if r.created_by = me then raise exception 'مينفعش تراجع مصروف صرفته بنفسك'; end if;
    if coalesce((p->>'ok')::boolean, true) = false and length(btrim(coalesce(p->>'note', ''))) < 3 then raise exception 'اكتب سبب الرفض'; end if;
    update clinic_finance.requests set post_review = case when coalesce((p->>'ok')::boolean, true) then 'ok' else 'rejected' end,
      post_reviewed_by = me, post_reviewed_at = now(), post_review_note = nullif(btrim(coalesce(p->>'note', '')), '') where id = r.id;
    insert into clinic_finance.audit(actor, action, entity_id, detail) values (me, 'shift_expense_review', r.id, p);
    return jsonb_build_object('ok', true);
  elsif p_action = 'set_limits' then
    if not clinic_finance.allowed('review') then raise exception 'تعديل الحدود للحسابات بس' using errcode = '42501'; end if;
    if coalesce(nullif(p->>'allowance', '')::numeric, -1) < 0 or coalesce(nullif(p->>'max', '')::numeric, -1) < 0 then raise exception 'اكتب الهامش والحد بالجنيه'; end if;
    update clinic_finance.registers set shift_expense_allowance = (p->>'allowance')::numeric, shift_expense_max = (p->>'max')::numeric
      where id = nullif(p->>'register_id', '')::uuid;
    if not found then raise exception 'الخزنة مش موجودة'; end if;
    insert into clinic_finance.audit(actor, action, entity_id, detail) values (me, 'shift_expense_limits', (p->>'register_id')::uuid, p);
    return jsonb_build_object('ok', true);
  end if;
  raise exception 'إجراء غير معروف';
end $function$

### END
### FUNC clinic_finance_shift_movements(uuid,date,date,uuid,uuid)
CREATE OR REPLACE FUNCTION public.clinic_finance_shift_movements(p_shift uuid DEFAULT NULL::uuid, p_from date DEFAULT NULL::date, p_to date DEFAULT NULL::date, p_cashier uuid DEFAULT NULL::uuid, p_register uuid DEFAULT NULL::uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare me uuid:=public.my_admin_id();manager boolean;ids uuid[];v_rows jsonb;v_shifts jsonb;
begin
 if me is null or not exists(select 1 from public.admins where id=me and active) then raise exception 'سجل الدخول' using errcode='42501';end if;
 manager:=public.has_role('super_admin') or public.has_role('general_manager') or clinic_finance.allowed('review');
 if p_shift is null and (p_from is not null or p_to is not null) then
  if p_from is null or p_to is null or p_to<p_from then raise exception 'اختار فترة صحيحة';end if;
  if p_to-p_from>30 then raise exception 'أقصى فترة ٣١ يوم';end if;
 end if;
 select array_agg(fs.id) into ids from clinic_finance.shifts fs
  where (manager or fs.cashier_id=me)
    and (p_shift is null or fs.id=p_shift)
    and (p_cashier is null or fs.cashier_id=p_cashier)
    and (p_register is null or fs.register_id=p_register)
    and (p_shift is not null
         or (p_from is not null and (fs.opened_at at time zone 'Africa/Cairo')::date between p_from and p_to)
         or (p_from is null and fs.cashier_id=me and fs.status='open'));
 if p_shift is not null and ids is null then raise exception 'الوردية مش متاحة لك' using errcode='42501';end if;
 ids:=coalesce(ids,'{}');

 select coalesce(jsonb_agg(jsonb_build_object('id',fs.id,'register_name',reg.name,'cashier_name',coalesce(nullif(trim(to_jsonb(ad)->>'name'),''),'موظف'),'opened_at',fs.opened_at,'status',fs.status) order by fs.opened_at),'[]')
   into v_shifts from clinic_finance.shifts fs join clinic_finance.registers reg on reg.id=fs.register_id left join public.admins ad on ad.id=fs.cashier_id where fs.id=any(ids);

 with fsh as (
   select fs.id,fs.cashier_id,fs.opened_at,coalesce(fs.closed_at,now()) until_at,reg.name register_name,coalesce(nullif(trim(to_jsonb(ad)->>'name'),''),'موظف') cashier_name
   from clinic_finance.shifts fs join clinic_finance.registers reg on reg.id=fs.register_id left join public.admins ad on ad.id=fs.cashier_id where fs.id=any(ids)),
 rsh as (select rs.id rid,f.* from clinic_reception.shifts rs join fsh f on f.id=rs.finance_shift_id),
 -- reception receipts: in the drawer (cash/card) or recorded by the cashier during the shift (instapay/bank/wallet)
 rpay as (
   select rp.*,f.id fid,f.register_name,f.cashier_name from clinic_reception.payments rp join rsh f on f.rid=rp.shift_id
   union all
   select rp.*,f.id,f.register_name,f.cashier_name from clinic_reception.payments rp join fsh f on rp.shift_id is null and rp.created_by=f.cashier_id and rp.created_at between f.opened_at and f.until_at),
 r_in as (
   select p.created_at at_time,p.fid shift_id,p.cashier_name,p.register_name,'in' direction,
     case when ins.payer is not null then 'insurance' else 'self' end kind,
     pt.name title,
     concat_ws(' · ',nullif(coalesce(inv.descr,case when p.package_id is not null then 'دفعة باكج' else 'رصيد مقدم للمريض' end),''),case when pt.file_no is not null then 'ملف '||pt.file_no end) detail,
     p.method,p.reference,p.amount::numeric amount,
     case when ins.payer is not null then jsonb_build_object('payer',ins.payer,'claim',ins.claim,'total',ins.total,'cover',case when ins.total>0 then round(ins.claim*100/ins.total) end) end insurance,
     p.id source_id
   from rpay p join clinic_reception.patients pt on pt.id=p.patient_id
   left join lateral (select string_agg(distinct i.description,' + ') descr from clinic_reception.allocations a join clinic_reception.invoices i on i.id=a.invoice_id where a.payment_id=p.id) inv on true
   left join lateral (select e.name payer,c.amount claim,i.amount total from clinic_reception.allocations a join clinic_reception.invoices i on i.id=a.invoice_id join clinic_reception.claims c on c.invoice_id=i.id join clinic_reception.entities e on e.id=c.entity_id where a.payment_id=p.id order by c.amount desc limit 1) ins on true),
 -- finance-desk receipts not already mirrored from reception
 f_in as (
   select fp.created_at,f.id,f.cashier_name,f.register_name,'in','self',coalesce(nullif(fi.patient_ref,''),'تحصيل الخزينة'),fi.description,fp.method,fp.reference,fp.amount::numeric,null::jsonb,fp.id
   from clinic_finance.payments fp join fsh f on f.id=fp.shift_id join clinic_finance.invoices fi on fi.id=fp.invoice_id
   where not exists(select 1 from clinic_reception.payments rp where rp.finance_payment_id=fp.id)),
 -- money out of a reception drawer (refunds, expenses, payouts): credit on a money account, tagged with the shift
 r_out as (
   select j.created_at,f.id,f.cashier_name,f.register_name,'out','out',
     coalesce(pt.name,case j.source when 'refund' then 'استرداد' when 'expense' then 'مصروف' when 'doctor_payout' then 'صرف أتعاب طبيب' when 'supplier_payout' then 'سداد مورد' else 'صرف' end),
     j.description,case l.account when '1111' then 'cash' when '1114' then 'pos' when '1115' then 'wallet' else 'bank' end,coalesce(j.dimensions->>'reference',''),-l.credit,null::jsonb,j.id
   from clinic_reception.journal j join clinic_reception.journal_lines l on l.entry_id=j.id and l.credit>0 and l.account in ('1111','1114','1115','1112')
   join rsh f on f.rid=nullif(j.dimensions->>'shift_id','')::uuid
   left join clinic_reception.patients pt on pt.id=nullif(j.dimensions->>'patient_id','')::uuid
   where j.source not in ('method_fix')),
 -- money out recorded on the finance side (petty cash, refunds, handover to the main treasury …)
 f_out as (
   select e.created_at,f.id,f.cashier_name,f.register_name,'out','out',e.description,e.source,'cash','',-l.credit,null::jsonb,e.id
   from clinic_finance.entries e join fsh f on f.id=e.shift_id join clinic_finance.lines l on l.entry_id=e.id and clinic_finance.is_cash_account(l.account) and l.credit>0
   where e.source not like 'reception\_%'),
 -- approved payment-method corrections on receipts of these shifts
 fixes as (
   select j.created_at,f.id,f.cashier_name,f.register_name,'fix','fix',coalesce(pt.name,'تصحيح طريقة الدفع'),
     'تصحيح طريقة الدفع لإيصال '||coalesce(rp.reference,''),coalesce(j.dimensions->>'method_from','')||'>'||coalesce(j.dimensions->>'method_to',''),'',l.debit,null::jsonb,j.id
   from clinic_reception.journal j join clinic_reception.journal_lines l on l.entry_id=j.id and l.debit>0
   join rsh f on f.rid=nullif(j.dimensions->>'shift_id','')::uuid
   left join clinic_reception.payments rp on rp.id=nullif(j.dimensions->>'payment_id','')::uuid
   left join clinic_reception.patients pt on pt.id=rp.patient_id
   where j.source='method_fix'),
 p_in as (
   select e.created_at,f.id,f.cashier_name,f.register_name,'in','handover','استلام تحصيل من زميل',e.description,'cash','',l.debit,null::jsonb,e.id
   from clinic_finance.entries e join fsh f on f.id=e.shift_id join clinic_finance.lines l on l.entry_id=e.id and clinic_finance.is_cash_account(l.account) and l.debit>0
   where e.source='treasury_peer_in'),
 allrows as (select * from r_in union all select * from f_in union all select * from r_out union all select * from f_out union all select * from fixes union all select * from p_in)
 select coalesce(jsonb_agg(jsonb_build_object('at',a.at_time,'shift_id',a.shift_id,'cashier_name',a.cashier_name,'register_name',a.register_name,'direction',a.direction,'kind',a.kind,'title',a.title,'detail',a.detail,'method',a.method,'reference',a.reference,'amount',a.amount,'insurance',a.insurance,'source_id',a.source_id,'receipt_no',(select rp.receipt_no from clinic_reception.payments rp where rp.id = a.source_id),'wallet_kind',(select rp.wallet_kind from clinic_reception.payments rp where rp.id = a.source_id)) order by a.at_time),'[]')
   into v_rows from (select * from allrows order by at_time limit 3000) a;

 return jsonb_build_object('shifts',v_shifts,'movements',v_rows,'manager',manager,'capped',jsonb_array_length(v_rows)>=3000);
end $function$

### END
### FUNC clinic_reception_shift_guard()
CREATE OR REPLACE FUNCTION public.clinic_reception_shift_guard()
 RETURNS jsonb
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$ select clinic_reception.shift_guard_state() $function$

### END
### FUNC clinic_reception_shift_reminder()
CREATE OR REPLACE FUNCTION public.clinic_reception_shift_reminder()
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare me uuid := public.my_admin_id(); pid uuid; d date := (now() at time zone 'Africa/Cairo')::date;
  e record; s record; has_e boolean := false; last_in timestamptz; last_out timestamptz; out_now boolean := false; ended boolean := false;
  closed_today boolean;
begin
  if me is null then return jsonb_build_object('show', false, 'state', 'hidden'); end if;
  if not (public.has_role('reception') or public.has_role('customer_service')) then return jsonb_build_object('show', false, 'state', 'hidden'); end if;
  select p.id into pid from clinic_people.people p where p.admin_id = me and p.status <> 'ended' limit 1;
  if pid is null then return jsonb_build_object('show', false, 'state', 'hidden', 'why', 'no_person'); end if;
  select x.first_in, x.exp_start, x.exp_end, x.status into e from clinic_people.attendance_eval(d, now()) x where x.person_id = pid limit 1;
  has_e := found;
  if to_regclass('clinic_people.device_punches') is not null then
    execute 'select max(dp.ts) filter (where dp.punch in (0,3,4)), max(dp.ts) filter (where dp.punch in (1,5))
               from clinic_people.device_punches dp join clinic_people.device_user_map m on m.device_id = dp.device_id and m.device_user_id = dp.device_user_id
              where m.person_id = $1 and dp.ts >= $2' into last_in, last_out using pid, now() - interval '16 hours';
  end if;
  out_now := last_out is not null and (last_in is null or last_out > last_in);
  ended := has_e and e.exp_end is not null and now() >= e.exp_end;
  select sh.opened_at into s from clinic_reception.shifts sh where sh.cashier_id = me and sh.status = 'open' order by sh.opened_at desc limit 1;
  if found then
    return jsonb_build_object('show', false,
      'state', case when s.opened_at < now() - interval '16 hours' or ended or out_now then 'close_due' else 'open' end,
      'reason', case when s.opened_at < now() - interval '16 hours' then 'stale' when out_now then 'punched_out' when ended then 'shift_end' else null end,
      'opened_at', s.opened_at, 'exp_end', case when has_e then e.exp_end end);
  end if;
  closed_today := exists (select 1 from clinic_reception.shifts sh where sh.cashier_id = me and sh.status <> 'open' and sh.opened_at >= now() - interval '16 hours');
  if closed_today or out_now or not has_e or coalesce(e.status, '') = 'leave' or ended
     or not (e.first_in is not null or (e.exp_start is not null and now() >= e.exp_start)) then
    return jsonb_build_object('show', false, 'state', 'hidden',
      'why', case when closed_today then 'closed' when out_now then 'punched_out' when not has_e then 'no_schedule' when e.status = 'leave' then 'leave' when ended then 'ended' else 'not_yet' end,
      'exp_start', case when has_e then e.exp_start end);
  end if;
  return jsonb_build_object('show', true, 'state', 'need_open',
    'reason', case when e.first_in is not null then 'punched' else 'shift_start' end,
    'first_in', e.first_in, 'exp_start', e.exp_start, 'exp_end', e.exp_end);
end $function$

### END
### FUNC clinic_reception_shift_watch()
CREATE OR REPLACE FUNCTION public.clinic_reception_shift_watch()
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare d date := (now() at time zone 'Africa/Cairo')::date; rows jsonb := '[]'::jsonb; ids uuid[]; more uuid[];
  a record; pid uuid; s record; stale boolean; e_start timestamptz; e_end timestamptz; e_in timestamptz; e_status text;
begin
  if not (public.has_role('super_admin') or public.has_role('general_manager') or public.has_role('financial_manager')) then
    return jsonb_build_object('visible', false, 'items', '[]'::jsonb); end if;
  select coalesce(array_agg(x.id), '{}') into ids from public.admins x where x.active and x.role = 'reception';
  if to_regclass('public.admin_extra_roles') is not null then
    execute 'select coalesce(array_agg(distinct r.admin_id), ''{}'') from public.admin_extra_roles r join public.admins x on x.id = r.admin_id and x.active
              where r.role = ''reception''' into more;
    ids := ids || more;
  end if;
  for a in select x.id, coalesce(nullif(trim(x.name), ''), x.email) as name from public.admins x where x.id = any(ids) order by 2 loop
    pid := null; e_start := null; e_end := null; e_in := null; e_status := null;
    select p.id into pid from clinic_people.people p where p.admin_id = a.id and p.status <> 'ended' limit 1;
    if pid is not null then
      select x.first_in, x.exp_start, x.exp_end, x.status into e_in, e_start, e_end, e_status from clinic_people.attendance_eval(d, now()) x where x.person_id = pid limit 1;
    end if;
    select sh.opened_at, clinic_finance.shift_cash(sh.id) as expected, r.name as register into s from clinic_finance.shifts sh
      left join clinic_finance.registers r on r.id = sh.register_id
     where sh.cashier_id = a.id and sh.status = 'open' and sh.ended_at is null and not coalesce(sh.is_main, false) order by sh.opened_at desc limit 1;
    if found then
      stale := s.opened_at < now() - interval '16 hours';
      if stale or (e_end is not null and now() >= e_end + interval '1 hour' and s.opened_at < e_end) then
        rows := rows || jsonb_build_object('kind', case when stale then 'stale' else 'after_end' end, 'admin_id', a.id, 'name', a.name,
          'opened_at', s.opened_at, 'expected', s.expected, 'register', s.register, 'exp_end', e_end);
      end if;
    elsif e_start is not null and coalesce(e_status, '') <> 'leave' and now() >= e_start + interval '1 hour'
          and (e_end is null or now() < e_end)
          and not exists (select 1 from clinic_finance.shifts sh where sh.cashier_id = a.id and not coalesce(sh.is_main, false)
                            and sh.opened_at >= now() - interval '16 hours') then
      rows := rows || jsonb_build_object('kind', 'missing', 'admin_id', a.id, 'name', a.name, 'exp_start', e_start, 'first_in', e_in);
    end if;
  end loop;
  return jsonb_build_object('visible', true, 'items', rows);
end $function$

### END
### FUNC clinic_review_inbox()
CREATE OR REPLACE FUNCTION public.clinic_review_inbox()
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare
  me uuid := public.my_admin_id();
  fin_view boolean := false; fin_review boolean := false; desk boolean := false; rx boolean := false; rx_fin boolean := false;
  ws uuid; treasury jsonb; submitted jsonb := '[]'::jsonb; open_shifts jsonb := '[]'::jsonb; handovers jsonb := '[]'::jsonb;
  reqs jsonb := '[]'::jsonb; part jsonb;
begin
  if me is null or not exists (select 1 from public.admins where id = me and active) then raise exception 'سجل الدخول' using errcode = '42501'; end if;
  fin_view := clinic_finance.allowed('view');
  fin_review := clinic_finance.allowed('review');
  begin desk := clinic_finance.desk_approver(); exception when others then desk := false; end;
  select id into ws from clinic_reception.workspaces where mode = 'live' order by id limit 1;
  if ws is not null then
    begin perform clinic_reception.access(ws, 'review'); rx := true; exception when others then rx := false; end;
    if rx then begin perform clinic_reception.access(ws, 'finance_review'); rx_fin := true; exception when others then rx_fin := false; end; end if;
  end if;
  if not (fin_view or fin_review or desk or rx) then
    return jsonb_build_object('visible', false, 'requests', '[]'::jsonb, 'shifts', '[]'::jsonb, 'handovers', '[]'::jsonb,
                              'open_shifts', '[]'::jsonb, 'counts', jsonb_build_object('total', 0));
  end if;

  -- main treasury
  if fin_view then
    begin
      treasury := public.clinic_finance_main_treasury_balance();
      begin treasury := treasury || jsonb_build_object('count', public.clinic_finance_main_count_status());
      exception when others then null; end;
    exception when others then treasury := null; end;
  end if;

  -- closed shifts waiting for review (+ open ones, read-only)
  if fin_review or rx then
    begin
      select coalesce(jsonb_agg(jsonb_build_object(
          'id', s.id, 'register', r.name, 'cashier', coalesce(nullif(trim(a.name), ''), a.email), 'closed_at', s.closed_at,
          'counted', s.counted, 'expected', round(clinic_finance.shift_cash(s.id), 2),
          'difference', round(coalesce(s.counted, 0) - clinic_finance.shift_cash(s.id), 2), 'mine', s.cashier_id = me,
          'rpc', 'clinic_finance_review_shift',
          'action', case when rs.id is not null then 'shift_review' else null end,
          'target_id', coalesce(rs.id, s.id), 'workspace_id', rs.workspace_id) order by s.closed_at), '[]'::jsonb)
        into submitted
        from clinic_finance.shifts s join clinic_finance.registers r on r.id = s.register_id
        left join public.admins a on a.id = s.cashier_id
        left join clinic_reception.shifts rs on rs.finance_shift_id = s.id
       where s.status = 'submitted' and fin_review;
      select coalesce(jsonb_agg(jsonb_build_object('id', s.id, 'register', r.name, 'cashier', coalesce(nullif(trim(a.name), ''), a.email),
          'opened_at', s.opened_at, 'expected', round(clinic_finance.shift_cash(s.id), 2), 'mine', s.cashier_id = me) order by s.opened_at), '[]'::jsonb)
        into open_shifts
        from clinic_finance.shifts s join clinic_finance.registers r on r.id = s.register_id
        left join public.admins a on a.id = s.cashier_id
       where s.status = 'open' and coalesce(to_jsonb(r)->>'treasury_kind', '') <> 'main';
    exception when others then null; end;
  end if;

  -- cash handovers to the main treasury
  if fin_review then
    begin
      select coalesce(jsonb_agg(jsonb_build_object('id', t.id, 'amount', t.amount, 'reference', t.reference, 'reason', t.reason,
          'by', coalesce(nullif(trim(a.name), ''), a.email), 'at', t.created_at, 'mine', t.created_by = me,
          'rpc', 'clinic_finance_treasury_command', 'action', 'transfer_review') order by t.created_at), '[]'::jsonb)
        into handovers
        from clinic_finance.treasury_transfers t left join public.admins a on a.id = t.created_by
       where t.status = 'pending';
    exception when others then null; end;
  end if;

  -- reception correction requests (service void, visit void, method fix, refund, credit note, payouts …)
  if rx then
    begin
      select coalesce(jsonb_agg(jsonb_build_object('source', 'rx_request', 'id', q.id, 'kind', q.kind, 'amount', q.amount,
          'reason', q.reason, 'by', coalesce(nullif(trim(a.name), ''), a.email), 'at', q.created_at, 'mine', q.created_by = me,
          'visit_void', coalesce((q.payload->>'visit_void')::boolean, false), 'visit_no', v.visit_no, 'patient', pt.name,
          'rpc', 'clinic_reception_command', 'action', 'request_review', 'workspace_id', q.workspace_id) order by q.created_at), '[]'::jsonb)
        into part
        from clinic_reception.requests q
        left join public.admins a on a.id = q.created_by
        left join clinic_reception.invoices i on i.id = q.subject_id
        left join clinic_reception.orders o on o.id = i.order_id
        left join clinic_reception.visits v on v.id = coalesce(case when q.payload->>'visit_id' ~* '^[0-9a-f-]{36}$' then (q.payload->>'visit_id')::uuid end, o.visit_id)
        left join clinic_reception.patients pt on pt.id = v.patient_id
       where q.workspace_id = ws and q.status = 'pending';
      reqs := reqs || part;
    exception when others then null; end;
    begin
      select coalesce(jsonb_agg(jsonb_build_object('source', 'rx_discount', 'id', dr.id, 'kind', 'discount', 'percent', dr.percent,
          'amount', round(coalesce(o.price, 0) * coalesce(o.quantity, 1) * dr.percent / 100, 2), 'service', o.snapshot->>'name',
          'reason', dr.reason, 'by', coalesce(nullif(trim(a.name), ''), a.email), 'mine', dr.created_by = me, 'patient', pt.name,
          'visit_no', v.visit_no, 'rpc', 'clinic_reception_command', 'action', 'discount_review', 'workspace_id', dr.workspace_id)), '[]'::jsonb)
        into part
        from clinic_reception.discount_requests dr
        left join public.admins a on a.id = dr.created_by
        left join clinic_reception.orders o on o.id = dr.order_id
        left join clinic_reception.visits v on v.id = o.visit_id
        left join clinic_reception.patients pt on pt.id = v.patient_id
       where dr.workspace_id = ws and dr.status = 'pending' and (dr.percent <= 15 or rx_fin);
      reqs := reqs || part;
    exception when others then null; end;
    begin
      select coalesce(jsonb_agg(jsonb_build_object('source', 'rx_cross_payment', 'id', p.id, 'kind', 'cross_payment', 'amount', p.amount,
          'reason', p.note, 'by', coalesce(nullif(trim(ad.name), ''), ad.email), 'at', p.created_at, 'mine', p.created_by = me,
          'patient', pt.name, 'method', p.method, 'reference', p.reference, 'receipt_no', p.receipt_no,
          'patients', (select jsonb_agg(distinct x.name) from clinic_reception.allocations al join clinic_reception.invoices iv on iv.id = al.invoice_id
                        join clinic_reception.patients x on x.id = iv.patient_id where al.payment_id = p.id),
          'rpc', 'clinic_reception_command', 'action', 'cross_payment_review', 'workspace_id', p.workspace_id) order by p.created_at), '[]'::jsonb)
        into part
        from clinic_reception.payments p
        left join public.admins ad on ad.id = p.created_by
        left join clinic_reception.patients pt on pt.id = p.patient_id
       where p.workspace_id = ws and p.cross_patient and p.cross_review_status is null;
      reqs := reqs || part;
    exception when others then null; end;
  end if;

  if fin_review then
    begin
      select coalesce(jsonb_agg(jsonb_build_object('source', 'fin_request', 'id', q.id, 'kind', q.kind, 'amount', q.amount, 'reason', q.reason,
          'by', coalesce(nullif(trim(a.name), ''), a.email), 'at', q.created_at, 'mine', q.created_by = me,
          'rpc', 'clinic_finance_review_request') order by q.created_at), '[]'::jsonb)
        into part from clinic_finance.requests q left join public.admins a on a.id = q.created_by where q.status = 'pending';
      reqs := reqs || part;
    exception when others then null; end;
    begin
      select coalesce(jsonb_agg(jsonb_build_object('source', 'doctor_payout', 'id', p.id, 'kind', 'doctor_payout', 'amount', p.gross - p.withheld,
          'reason', p.reference, 'doctor', coalesce(p.payload->>'doctor_name', p.doctor_key), 'by', coalesce(nullif(trim(a.name), ''), a.email),
          'at', p.created_at, 'mine', p.created_by = me, 'rpc', 'clinic_finance_doctor_command', 'action', 'payout_review') order by p.created_at), '[]'::jsonb)
        into part from clinic_finance.doctor_payouts p left join public.admins a on a.id = p.created_by
       where p.status = 'pending' and not exists (select 1 from clinic_finance.desk_payouts d where d.payout_id = p.id);
      reqs := reqs || part;
    exception when undefined_table then
      select coalesce(jsonb_agg(jsonb_build_object('source', 'doctor_payout', 'id', p.id, 'kind', 'doctor_payout', 'amount', p.gross - p.withheld,
          'reason', p.reference, 'doctor', coalesce(p.payload->>'doctor_name', p.doctor_key), 'by', coalesce(nullif(trim(a.name), ''), a.email),
          'at', p.created_at, 'mine', p.created_by = me, 'rpc', 'clinic_finance_doctor_command', 'action', 'payout_review') order by p.created_at), '[]'::jsonb)
        into part from clinic_finance.doctor_payouts p left join public.admins a on a.id = p.created_by where p.status = 'pending';
      reqs := reqs || part;
    when others then null; end;
    begin
      select coalesce(jsonb_agg(jsonb_build_object('source', 'business', 'id', b.id, 'kind', b.kind, 'amount', b.amount, 'reason', b.subject,
          'by', coalesce(nullif(trim(a.name), ''), a.email), 'at', b.created_at, 'mine', b.created_by = me,
          'rpc', 'clinic_finance_business_command', 'action', 'review') order by b.created_at), '[]'::jsonb)
        into part from clinic_finance.business_requests b left join public.admins a on a.id = b.created_by where b.status = 'pending';
      reqs := reqs || part;
    exception when others then null; end;
    begin
      select coalesce(jsonb_agg(jsonb_build_object('source', 'booking_advance', 'id', x.id, 'kind', 'booking_advance', 'amount', x.amount,
          'reason', x.reference, 'patient', x.patient_ref, 'method', x.method, 'by', coalesce(nullif(trim(a.name), ''), a.email), 'at', x.created_at,
          'mine', x.created_by = me, 'rpc', 'clinic_booking_command', 'action', 'verify') order by x.created_at), '[]'::jsonb)
        into part from clinic_finance.advances x left join public.admins a on a.id = x.created_by where x.status = 'pending';
      reqs := reqs || part;
    exception when others then null; end;
    begin
      select coalesce(jsonb_agg(jsonb_build_object('source', 'supplier', 'id', s.id, 'kind', s.kind, 'amount', s.amount, 'reason', s.note,
          'supplier', su.name, 'by', coalesce(nullif(trim(a.name), ''), a.email), 'at', s.created_at, 'mine', s.created_by = me,
          'rpc', 'clinic_finance_supplier_command', 'action', 'review') order by s.created_at), '[]'::jsonb)
        into part from clinic_finance.supplier_actions s left join public.admins a on a.id = s.created_by
        left join public.inventory_suppliers su on su.id = s.supplier_id where s.status = 'pending';
      reqs := reqs || part;
    exception when others then null; end;
  end if;

  -- doctor payouts requested at the reception desk
  if desk then
    begin
      select coalesce(jsonb_agg(jsonb_build_object('source', 'desk_payout', 'id', p.id, 'kind', 'desk_payout', 'amount', p.gross - p.withheld,
          'reason', p.reference, 'doctor', pr.name, 'by', coalesce(nullif(trim(a.name), ''), a.email), 'at', p.created_at, 'mine', p.created_by = me,
          'rpc', 'clinic_reception_doctor_payout') order by p.created_at), '[]'::jsonb)
        into part from clinic_finance.doctor_payouts p join clinic_finance.desk_payouts d on d.payout_id = p.id
        left join clinic_reception.providers pr on pr.id = d.provider_id
        left join public.admins a on a.id = p.created_by where p.status = 'pending';
      reqs := reqs || part;
    exception when others then null; end;
  end if;

  return jsonb_build_object('visible', true, 'can_review', fin_review or rx or desk, 'treasury', treasury,
    'shifts', submitted, 'open_shifts', open_shifts, 'handovers', handovers, 'requests', reqs,
    'counts', jsonb_build_object(
      'shifts', (select count(*) from jsonb_array_elements(submitted) e where not coalesce((e->>'mine')::boolean, false)),
      'handovers', (select count(*) from jsonb_array_elements(handovers) e where not coalesce((e->>'mine')::boolean, false)),
      'requests', (select count(*) from jsonb_array_elements(reqs) e where not coalesce((e->>'mine')::boolean, false)),
      'total', (select count(*) from jsonb_array_elements(submitted || handovers || reqs) e where not coalesce((e->>'mine')::boolean, false))));
end $function$

### END
### FUNC hr_account_status(uuid)
CREATE OR REPLACE FUNCTION public.hr_account_status(p_person_id uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
begin
 if not clinic_people.visible(p_person_id) then raise exception 'الملف غير متاح';end if;
 return (select jsonb_build_object('job_id',id,'status',status,'sent_at',sent_at) from public.hr_account_jobs where person_id=p_person_id);
end $function$

### END
### FUNC hr_attendance_from_punches(date)
CREATE OR REPLACE FUNCTION public.hr_attendance_from_punches(p_month date)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare
  me uuid := public.my_admin_id();
  today date := (now() at time zone 'Africa/Cairo')::date;
  dt date := date_trunc('month', p_month)::date;
  upto date;
  v_rows jsonb; v_import uuid; v_existing integer; v_incomplete integer; v_unmapped jsonb; v_absent integer; v_late integer;
begin
  if me is null then raise exception 'سجل الدخول'; end if;
  if not clinic_people.manage() then raise exception 'تحتاج إدارة الموارد البشرية'; end if;
  if p_month is null then raise exception 'اختر الشهر'; end if;
  upto := least((dt + interval '1 month' - interval '1 day')::date, today - 1);
  if upto < dt then raise exception 'لا توجد أيام مكتملة في هذا الشهر بعد'; end if;

  with ev as (
    select g.d::date as day, e.*
    from generate_series(dt, upto, interval '1 day') g(d), lateral clinic_people.attendance_eval(g.d::date, now()) e),
  x as (
    select ev.*,
      (select max(d.ts) from clinic_people.device_punches d
         join clinic_people.device_user_map m on m.device_id = d.device_id and m.device_user_id = d.device_user_id
        where m.person_id = ev.person_id and d.punch in (1, 5) and ev.first_in is not null
          and d.ts > ev.first_in and d.ts <= ev.exp_end + interval '10 hours') as last_out,
      exists (select 1 from clinic_people.attendance a where a.person_id = ev.person_id and a.day = ev.day) as has_row,
      -- sick leave reported but not decided yet: wait while its certificate is still due (48 h), then it is an absence
      (select bool_or(q.created_at + interval '48 hours' > now()) from clinic_people.requests q
        where q.person_id = ev.person_id and q.kind = 'leave' and q.leave_type = 'sick' and q.status = 'pending'
          and ev.day between q.from_date and q.to_date) as sick_wait
    from ev),
  todo as (
    select x.*,
      case when x.status = 'late' and x.excused then x.exp_start else x.first_in end as a_start
    from x
    where not x.has_row and x.status in ('on_time', 'late', 'absent') and not (x.status = 'absent' and x.excused)
      and not (x.status = 'absent' and x.sick_wait is true)
      -- an arrival without an exit punch waits 10 hours after the shift end before the shift is closed at its end
      and (x.status = 'absent' or x.last_out is not null or x.exp_end + interval '10 hours' <= now()))
  select
    (select jsonb_agg(jsonb_build_object(
        'person_id', t.person_id, 'day', t.day, 'scheduled_start', t.exp_start, 'scheduled_end', t.exp_end,
        'actual_start', t.a_start,
        'actual_end', case when t.a_start is null then null
                           when t.last_out is not null and t.last_out > t.a_start then t.last_out
                           else greatest(t.exp_end, t.a_start + interval '1 minute') end,
        'note', 'بصمة' || case when t.status = 'absent' and t.sick_wait is false then ' — غياب: إجازة مرضية بدون شهادة طبية خلال 48 ساعة'
                               when t.status = 'absent' then ' — غياب بدون بصمة حضور'
                               when t.last_out is null or t.last_out <= t.a_start then ' — مفيش بصمة انصراف خلال 10 ساعات: الوردية اتقفلت على نهايتها'
                               else '' end
                        || case when t.excused then ' — إذن معتمد' else '' end)
        order by t.day, t.person_id) from todo t),
    (select count(*) from x where x.has_row),
    (select count(*) from todo t where t.a_start is not null and (t.last_out is null or t.last_out <= t.a_start)),
    (select count(*) from todo t where t.status = 'absent'),
    (select count(*) from todo t where t.status = 'late' and not t.excused),
    (select coalesce(jsonb_agg(distinct p.full_name), '[]'::jsonb) from x join clinic_people.people p on p.id = x.person_id where x.status = 'unmapped')
  into v_rows, v_existing, v_incomplete, v_absent, v_late, v_unmapped;

  if v_rows is not null then
    v_import := public.hr_payroll_command('import_attendance', jsonb_build_object(
      'filename', 'بصمات ' || to_char(dt, 'YYYY-MM') || ' حتى ' || upto,
      'checksum', 'punches-' || md5(v_rows::text),
      'rows', v_rows));
  end if;

  return jsonb_build_object('month', dt, 'through', upto, 'import_id', v_import,
    'created', coalesce(jsonb_array_length(v_rows), 0), 'already_recorded', v_existing,
    'absent', v_absent, 'late', v_late, 'missing_exit', v_incomplete, 'unmapped', v_unmapped);
end $function$

### END
### FUNC hr_attendance_range(date,date)
CREATE OR REPLACE FUNCTION public.hr_attendance_range(p_from date, p_to date)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare today date := (now() at time zone 'Africa/Cairo')::date; v_now timestamptz := now(); v_to date;
begin
  if public.my_admin_id() is null then raise exception 'سجل الدخول'; end if;
  if not clinic_people.manage() then raise exception 'تحتاج إدارة الموارد البشرية'; end if;
  if p_from is null or p_to is null or p_to < p_from then raise exception 'راجع تاريخ البداية والنهاية'; end if;
  if p_to - p_from > 365 then raise exception 'الفترة لا تزيد عن 366 يومًا'; end if;
  v_to := least(p_to, today);
  return jsonb_build_object(
    'from', p_from, 'to', v_to, 'today', today, 'now', v_now,
    'people', (select coalesce(jsonb_agg(jsonb_build_object('id', p.id, 'code', p.code, 'full_name', p.full_name, 'department', p.department, 'job_title', p.job_title) order by p.department nulls last, p.full_name), '[]'::jsonb)
      from clinic_people.people p
      where p.status <> 'ended' and p.kind <> 'doctor'
        and exists (select 1 from clinic_people.person_shifts s where s.person_id = p.id and s.valid_from <= v_to and (s.valid_to is null or s.valid_to >= p_from))),
    'rows', (
      with ev as (
        select g.d::date as day, e.person_id, e.template_name, e.color, e.exp_start, e.exp_end, e.first_in, e.status, e.late_min, e.excused
        from generate_series(p_from, v_to, interval '1 day') g(d), lateral clinic_people.attendance_eval(g.d::date, v_now) e),
      x as (
        select ev.*, (select max(d.ts) from clinic_people.device_punches d
            join clinic_people.device_user_map m on m.device_id = d.device_id and m.device_user_id = d.device_user_id
            where m.person_id = ev.person_id and d.punch in (1, 5) and ev.first_in is not null
              and d.ts >= ev.first_in and d.ts <= ev.exp_end + interval '6 hours') as last_out
        from ev)
      select coalesce(jsonb_agg(jsonb_build_object(
          'day', x.day, 'person_id', x.person_id, 'status', x.status, 'late_min', x.late_min, 'excused', x.excused,
          'template_name', x.template_name, 'color', x.color, 'first_in', x.first_in, 'last_out', x.last_out,
          'early_leave_min', case when x.last_out is not null and x.last_out < x.exp_end then floor(extract(epoch from (x.exp_end - x.last_out)) / 60)::integer else 0 end,
          'overtime_min', case when x.last_out is not null and x.last_out > x.exp_end then floor(extract(epoch from (x.last_out - x.exp_end)) / 60)::integer else 0 end,
          'incomplete', x.first_in is not null and x.last_out is null and x.exp_end < v_now)
        order by x.day, x.person_id), '[]'::jsonb)
      from x));
end $function$

### END
### FUNC hr_attendance_today(date)
CREATE OR REPLACE FUNCTION public.hr_attendance_today(p_day date DEFAULT NULL::date)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare d date := coalesce(p_day, (now() at time zone 'Africa/Cairo')::date);
begin
  if public.my_admin_id() is null then raise exception 'سجل الدخول'; end if;
  if not clinic_people.manage() then raise exception 'تحتاج إدارة الموارد البشرية'; end if;
  return jsonb_build_object(
    'day', d, 'now', now(),
    'has_schedule', exists (select 1 from clinic_people.person_shifts),
    'unscheduled', (select count(*) from clinic_people.people p where p.status <> 'ended' and p.kind <> 'doctor' and not exists (select 1 from clinic_people.person_shifts s where s.person_id = p.id)),
    'rows', (
      with weekly as (
        select e.person_id, count(*) filter (where e.status = 'late') as late_week, count(*) filter (where e.status = 'absent') as absent_week
        from generate_series(d - 6, d - 1, interval '1 day') g(x), lateral clinic_people.attendance_eval(g.x::date, now()) e group by e.person_id)
      select coalesce(jsonb_agg(jsonb_build_object(
        'person_id', e.person_id, 'full_name', p.full_name, 'code', p.code, 'department', p.department, 'job_title', p.job_title,
        'template_id', e.template_id, 'template_name', e.template_name, 'color', e.color, 'grace', e.grace,
        'exp_start', e.exp_start, 'exp_end', e.exp_end, 'first_in', e.first_in, 'status', e.status, 'late_min', e.late_min, 'since_start', e.since_start,
        'excused', e.excused, 'late_week', coalesce(w.late_week, 0), 'absent_week', coalesce(w.absent_week, 0))
        order by case e.status when 'absent' then 0 when 'late' then 1 when 'waiting' then 2 when 'on_time' then 3 when 'upcoming' then 4 when 'leave' then 5 else 6 end,
          e.since_start desc nulls last, p.full_name), '[]'::jsonb)
      from clinic_people.attendance_eval(d, now()) e join clinic_people.people p on p.id = e.person_id left join weekly w on w.person_id = e.person_id));
end $function$

### END
### FUNC hr_claim_account_job(uuid,uuid)
CREATE OR REPLACE FUNCTION public.hr_claim_account_job(p_id uuid, p_actor uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare j public.hr_account_jobs%rowtype;
begin
 if not exists(select 1 from public.admins a where a.id=p_actor and a.active and (a.has_hr_access or a.role in('super_admin','general_manager') or exists(select 1 from public.admin_extra_roles r where r.admin_id=a.id and r.role in('super_admin','general_manager')))) then raise exception 'تحتاج إدارة الموارد البشرية';end if;
 select * into j from public.hr_account_jobs where id=p_id for update;
 if not found then raise exception 'الدعوة غير متاحة';end if;
 if j.status='sending' and j.lease_until<now() then update public.hr_account_jobs set status='delivery_unknown' where id=p_id;return jsonb_build_object('status','delivery_unknown');end if;
 if j.status in('sent','sending','delivery_unknown') then return jsonb_build_object('status',j.status);end if;
 if not exists(select 1 from clinic_people.people where id=j.person_id and admin_id=j.admin_id and lower(trim(email))=j.email) then raise exception 'ربط الموظف أو بريده تغير؛ راجع الملف';end if;
 if not exists(select 1 from public.admins where id=j.admin_id and active and role=j.role and lower(trim(email))=j.email and (user_id is null or user_id=j.auth_user_id)) then raise exception 'الحساب تغير؛ راجع المستخدمين';end if;
 update public.hr_account_jobs set status='sending',lease_until=now()+interval '3 minutes' where id=p_id;
 return to_jsonb(j)||jsonb_build_object('status','claimed');
end $function$

### END
### FUNC hr_command(text,jsonb)
CREATE OR REPLACE FUNCTION public.hr_command(p_action text, p_payload jsonb)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare me uuid:=public.my_admin_id();m boolean:=clinic_people.manage();pid uuid:=nullif(p_payload->>'person_id','')::uuid;v uuid;oldp clinic_people.people%rowtype;r clinic_people.requests%rowtype;a clinic_people.attendance%rowtype;prior jsonb;afterj jsonb;balance numeric;brk text[];begin
 if me is null then raise exception 'سجل الدخول';end if;
 if p_action='person' then
  if not m then raise exception 'لا تملك إدارة الموارد البشرية';end if;
  v:=nullif(p_payload->>'id','')::uuid;
  if v is not null then select * into oldp from clinic_people.people where id=v for update;if not found or oldp.revision<>coalesce((p_payload->>'revision')::int,0) then raise exception 'الملف تغير؛ أعد تحميله قبل الحفظ';end if;prior:=to_jsonb(oldp);end if;
  if length(trim(coalesce(p_payload->>'full_name','')))<3 or trim(p_payload->>'full_name') !~ '[[:space:]]' then raise exception 'اكتب الاسم الثنائي على الأقل';end if;
  if nullif(p_payload->>'doctor_key','') is not null and not exists(select 1 from clinic_finance.doctor_contracts where doctor_key=p_payload->>'doctor_key') then raise exception 'اختر كود الطبيب الموجود في الحسابات';end if;
  if nullif(p_payload->>'finance_subject','') is not null and not exists(select 1 from clinic_finance.business_requests where kind='employment' and status='approved' and subject=p_payload->>'finance_subject') then raise exception 'اختر معرف الموظف من عقد الحسابات المعتمد';end if;
  if nullif(p_payload->>'manager_id','') is not null then
   if exists(with recursive chain as(select id,manager_id from clinic_people.people where id=(p_payload->>'manager_id')::uuid union select p.id,p.manager_id from clinic_people.people p join chain c on p.id=c.manager_id) select 1 from chain where id=v) then raise exception 'التبعية الإدارية دائرية';end if;
  end if;
  if v is null then insert into clinic_people.people(full_name,created_by) values(trim(p_payload->>'full_name'),me) returning id into v;end if;
  update clinic_people.people set full_name=trim(p_payload->>'full_name'),admin_id=nullif(p_payload->>'admin_id','')::uuid,phone=coalesce(p_payload->>'phone',''),email=coalesce(p_payload->>'email',''),kind=coalesce(p_payload->>'kind','employee'),doctor_key=nullif(p_payload->>'doctor_key',''),finance_subject=nullif(p_payload->>'finance_subject',''),department=coalesce(p_payload->>'department',''),job_title=coalesce(p_payload->>'job_title',''),branch=coalesce(p_payload->>'branch',''),manager_id=nullif(p_payload->>'manager_id','')::uuid,start_date=nullif(p_payload->>'start_date','')::date,end_date=nullif(p_payload->>'end_date','')::date,birth_date=nullif(p_payload->>'birth_date','')::date,emergency_name=coalesce(p_payload->>'emergency_name',''),emergency_phone=coalesce(p_payload->>'emergency_phone',''),status=coalesce(p_payload->>'status','active'),notes=coalesce(p_payload->>'notes',''),revision=revision+1,updated_at=now() where id=v returning to_jsonb(clinic_people.people.*) into afterj;
 elsif p_action='document' then
  if not m then raise exception 'إضافة المستندات لإدارة الموارد البشرية';end if;
  insert into clinic_people.documents(person_id,title,document_url,expires_on,created_by) values(pid,p_payload->>'title',p_payload->>'document_url',nullif(p_payload->>'expires_on','')::date,me) returning id,to_jsonb(clinic_people.documents.*) into v,afterj;
 elsif p_action='request' then
  if not clinic_people.visible(pid) or not exists(select 1 from clinic_people.people where id=pid and status<>'ended') then raise exception 'ملف الموظف غير متاح';end if;
  if p_payload->>'kind'='leave_credit' and not m then raise exception 'إضافة رصيد الإجازات للموارد البشرية';end if;
  if p_payload->>'kind' in ('leave','leave_credit') and ((p_payload->>'units')::numeric>1+(p_payload->>'to_date')::date-(p_payload->>'from_date')::date or extract(year from (p_payload->>'from_date')::date)<>extract(year from (p_payload->>'to_date')::date)) then raise exception 'راجع عدد أيام الإجازة وسنة الرصيد';end if;
  insert into clinic_people.requests(person_id,kind,from_date,to_date,units,note,created_by,leave_type,notice_reason) values(pid,p_payload->>'kind',(p_payload->>'from_date')::date,(p_payload->>'to_date')::date,(p_payload->>'units')::numeric,p_payload->>'note',me,case when p_payload->>'kind'='leave' then coalesce(nullif(p_payload->>'leave_type',''),'annual') end,nullif(trim(coalesce(p_payload->>'notice_reason','')),'')) returning id,to_jsonb(clinic_people.requests.*) into v,afterj;
 elsif p_action='request_review' then
  if not m then raise exception 'المراجعة للموارد البشرية';end if;
  select * into r from clinic_people.requests where id=(p_payload->>'id')::uuid for update;
  if not found or r.status<>'pending' or r.created_by=me or length(trim(coalesce(p_payload->>'review_note','')))<3 or p_payload->>'decision' not in ('approved','rejected') then raise exception 'الطلب يحتاج مراجعًا آخر وسبب القرار';end if;
  perform 1 from clinic_people.people where id=r.person_id for update;
  if p_payload->>'decision'='approved' and r.kind='leave' then
   -- Leave rules (20261116100000): only annual and casual leave use the annual balance (Labor Law 14/2025 art. 128).
   -- unpaid leave balance 20261117020000: every leave type except excused uses one yearly unpaid balance; over it → owner-level only.
   if r.leave_type<>'excused' then
    select clinic_people.leave_allowance(extract(year from r.from_date)::int)+coalesce(sum(case when kind='leave_credit' then units when kind='leave' and leave_type<>'excused' then -units else 0 end),0) into balance from clinic_people.requests where person_id=r.person_id and status='approved' and extract(year from from_date)=extract(year from r.from_date);
    if balance<r.units and not clinic_people.is_owner_level() then raise exception 'الطلب أكتر من رصيد الأجازات (المتاح % يوم)؛ محتاج اعتماد المدير العام أو السوبر أدمن',greatest(balance,0);end if;
   end if;
   -- Out-of-rule requests: the reviewer's reason is the written exception. Sick leave without a certificate within 48 h,
   -- late sick leave and excused absences need an owner-level reviewer (super admin or general manager).
   brk:=r.rule_breaks||case when r.leave_type='sick' and (r.certificate_url is null or r.certificate_at>r.created_at+interval '48 hours') then array['no_certificate'] else '{}'::text[] end||case when r.leave_type<>'excused' and balance<r.units then array['over_balance'] else '{}'::text[] end;
   if brk&&array['sick_retroactive','no_certificate','excused'] and not clinic_people.is_owner_level() then raise exception 'الطلب ده محتاج اعتماد استثنائي من المدير العام أو السوبر أدمن (%)',array_to_string(clinic_people.leave_break_labels(brk),'، ');end if;
   if exists(select 1 from clinic_people.requests where person_id=r.person_id and kind='leave' and status='approved' and daterange(from_date,to_date,'[]')&&daterange(r.from_date,r.to_date,'[]')) then raise exception 'توجد إجازة متداخلة';end if;
  end if;
  prior:=to_jsonb(r);update clinic_people.requests set status=p_payload->>'decision',reviewed_by=me,review_note=p_payload->>'review_note',exception_by=case when p_payload->>'decision'='approved' and cardinality(coalesce(brk,'{}'))>0 then me end where id=r.id returning id,to_jsonb(clinic_people.requests.*) into v,afterj;
  if p_payload->>'decision'='approved' and r.kind='leave' then perform clinic_people.leave_refund(r.id,me);select to_jsonb(q) into afterj from clinic_people.requests q where q.id=r.id;end if;
 elsif p_action='attendance' then
  if not m then raise exception 'تسجيل الحضور للموارد البشرية';end if;
  insert into clinic_people.attendance(person_id,day,scheduled_start,scheduled_end,actual_start,actual_end,note,created_by) values(pid,(p_payload->>'day')::date,(p_payload->>'scheduled_start')::timestamptz,(p_payload->>'scheduled_end')::timestamptz,nullif(p_payload->>'actual_start','')::timestamptz,nullif(p_payload->>'actual_end','')::timestamptz,coalesce(p_payload->>'note',''),me) returning id,to_jsonb(clinic_people.attendance.*) into v,afterj;
 elsif p_action='attendance_review' then
  if not m then raise exception 'المراجعة للموارد البشرية';end if;
  select * into a from clinic_people.attendance where id=(p_payload->>'id')::uuid for update;
  if not found or a.status<>'pending' or a.created_by=me or length(trim(coalesce(p_payload->>'review_note','')))<3 or p_payload->>'decision' not in ('approved','rejected') then raise exception 'الحضور يحتاج مراجعًا آخر وسبب القرار';end if;
  prior:=to_jsonb(a);update clinic_people.attendance set status=p_payload->>'decision',reviewed_by=me,review_note=p_payload->>'review_note' where id=a.id returning id,to_jsonb(clinic_people.attendance.*) into v,afterj;
 elsif p_action='sick_certificate' then
  select * into r from clinic_people.requests where id=(p_payload->>'id')::uuid for update;
  if not found or r.kind<>'leave' or r.leave_type<>'sick' or r.status<>'pending' or not clinic_people.visible(r.person_id) then raise exception 'اختر إجازة مرضية قيد المراجعة';end if;
  if coalesce(p_payload->>'certificate_url','') !~ '^https://[^[:space:]]{8,}$' then raise exception 'الصق رابط الشهادة الطبية (يبدأ بـ https://)';end if;
  prior:=to_jsonb(r);update clinic_people.requests set certificate_url=p_payload->>'certificate_url',certificate_at=now() where id=r.id returning id,to_jsonb(clinic_people.requests.*) into v,afterj;
 else raise exception 'إجراء غير متاح';end if;
 insert into clinic_people.audit(actor_id,action,record_id,before_data,after_data) values(me,p_action,v,prior,afterj);return v;
end $function$

### END
### FUNC hr_custody_command(text,jsonb)
CREATE OR REPLACE FUNCTION public.hr_custody_command(p_action text, p_payload jsonb)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare
  me uuid := public.my_admin_id();
  today date := (now() at time zone 'Africa/Cairo')::date;
  it clinic_people.custody_items%rowtype;
  hp clinic_people.people%rowtype;
  v uuid := nullif(p_payload->>'id', '')::uuid;
  hid uuid := nullif(p_payload->>'holder_id', '')::uuid;
  rid uuid := nullif(p_payload->>'request_id', '')::uuid;
  act text := p_action;
  nt text := trim(coalesce(p_payload->>'note', ''));
  d date;
  val numeric;
  prior jsonb;
  afterj jsonb;
  mv_from uuid;
  mv_to uuid;
  mv_date date;
begin
  if me is null then raise exception 'سجل الدخول'; end if;
  if not clinic_people.manage() then raise exception 'سجل العهد لإدارة الموارد البشرية'; end if;
  if act not in ('create', 'issue', 'transfer', 'return', 'lost', 'damaged', 'update') then raise exception 'إجراء غير متاح'; end if;

  if act = 'create' then
    if rid is not null then select id into v from clinic_people.custody_items where request_id = rid; if found then return v; end if; end if;
    if length(trim(coalesce(p_payload->>'item_name', ''))) < 2 then raise exception 'اكتب اسم البند'; end if;
    val := coalesce(nullif(p_payload->>'value', '')::numeric, 0);
    if val < 0 or val >= 100000000 or val::text in ('NaN', 'Infinity') then raise exception 'راجع قيمة العهدة'; end if;
    insert into clinic_people.custody_items(request_id, item_name, category, description, serial_ref, value, note, created_by)
      values (rid, trim(p_payload->>'item_name'), coalesce(nullif(p_payload->>'category', ''), 'other'), coalesce(p_payload->>'description', ''), coalesce(p_payload->>'serial_ref', ''), val, coalesce(p_payload->>'note', ''), me)
      returning * into it;
    v := it.id;
    insert into clinic_people.custody_movements(item_id, action, on_date, note, actor_id) values (v, 'create', today, nt, me);
    if hid is null then
      insert into clinic_people.audit(actor_id, action, record_id, before_data, after_data) values (me, 'custody_create', v, null, to_jsonb(it));
      return v;
    end if;
    -- created together with its first holder: continue as an issue
    act := 'issue';
    prior := to_jsonb(it);
  else
    if v is null then raise exception 'اختر البند'; end if;
    select * into it from clinic_people.custody_items where id = v for update;
    if not found then raise exception 'البند غير موجود'; end if;
    if it.revision <> coalesce((p_payload->>'revision')::int, 0) then raise exception 'البند تغير؛ أعد تحميله قبل الحفظ'; end if;
    prior := to_jsonb(it);
  end if;

  if act = 'issue' or act = 'transfer' then
    if act = 'issue' and it.status <> 'in_store' then raise exception 'البند ليس في المخزن؛ استخدم التحويل أو الإرجاع'; end if;
    if act = 'transfer' and it.status <> 'with_holder' then raise exception 'التحويل من عهدة قائمة فقط'; end if;
    select * into hp from clinic_people.people where id = hid;
    if not found or hp.status = 'ended' then raise exception 'اختر موظفًا مستمرًا في العمل'; end if;
    if hid is not distinct from it.holder_id then raise exception 'البند عند نفس الشخص بالفعل'; end if;
    d := coalesce(nullif(p_payload->>'issued_on', '')::date, today);
    if d > today then raise exception 'تاريخ التسليم لا يكون في المستقبل'; end if;
    mv_from := it.holder_id; mv_to := hid; mv_date := d;
    update clinic_people.custody_items set status = 'with_holder', holder_id = hid, came_from_id = it.holder_id,
      came_from_note = case when it.holder_id is null then coalesce(nullif(trim(p_payload->>'came_from_note'), ''), 'المخزن') else '' end,
      issued_on = d, returned_on = null, revision = revision + 1, updated_at = now() where id = v;
  elsif act = 'return' then
    if it.status = 'in_store' then raise exception 'البند في المخزن بالفعل'; end if;
    d := coalesce(nullif(p_payload->>'returned_on', '')::date, today);
    if d > today then raise exception 'تاريخ الإرجاع لا يكون في المستقبل'; end if;
    if it.issued_on is not null and d < it.issued_on then raise exception 'تاريخ الإرجاع قبل تاريخ التسليم'; end if;
    mv_from := it.holder_id; mv_to := null; mv_date := d;
    update clinic_people.custody_items set status = 'in_store', holder_id = null, came_from_id = it.holder_id, came_from_note = '',
      returned_on = d, revision = revision + 1, updated_at = now() where id = v;
  elsif act in ('lost', 'damaged') then
    if it.status <> 'with_holder' then raise exception 'التسجيل من عهدة قائمة فقط'; end if;
    if length(nt) < 3 then raise exception 'اكتب سبب الفقد أو التلف'; end if;
    mv_from := it.holder_id; mv_to := it.holder_id; mv_date := today;
    update clinic_people.custody_items set status = act, revision = revision + 1, updated_at = now() where id = v;
  elsif act = 'update' then
    if length(trim(coalesce(p_payload->>'item_name', ''))) < 2 then raise exception 'اكتب اسم البند'; end if;
    val := coalesce(nullif(p_payload->>'value', '')::numeric, 0);
    if val < 0 or val >= 100000000 or val::text in ('NaN', 'Infinity') then raise exception 'راجع قيمة العهدة'; end if;
    if val is distinct from it.value and length(nt) < 3 then raise exception 'اكتب سبب تغيير القيمة'; end if;
    mv_from := null; mv_to := null; mv_date := today;
    update clinic_people.custody_items set item_name = trim(p_payload->>'item_name'), category = coalesce(nullif(p_payload->>'category', ''), category),
      description = coalesce(p_payload->>'description', description), serial_ref = coalesce(p_payload->>'serial_ref', serial_ref), value = val,
      note = coalesce(p_payload->>'note', note), revision = revision + 1, updated_at = now() where id = v;
  end if;

  insert into clinic_people.custody_movements(item_id, action, from_person_id, to_person_id, on_date, note, actor_id) values (v, act, mv_from, mv_to, mv_date, nt, me);
  select to_jsonb(c) into afterj from clinic_people.custody_items c where id = v;
  insert into clinic_people.audit(actor_id, action, record_id, before_data, after_data) values (me, 'custody_' || p_action, v, prior, afterj);
  return v;
end $function$

### END
### FUNC hr_custody_outstanding(uuid)
CREATE OR REPLACE FUNCTION public.hr_custody_outstanding(p_person uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
begin
  if public.my_admin_id() is null then raise exception 'سجل الدخول'; end if;
  if not clinic_people.custody_view_all() then raise exception 'سجل العهد للموارد البشرية والحسابات'; end if;
  return jsonb_build_object('person_id', p_person,
    'items', (select coalesce(jsonb_agg(jsonb_build_object('id', i.id, 'code', i.code, 'item_name', i.item_name, 'category', i.category, 'description', i.description, 'serial_ref', i.serial_ref, 'value', i.value, 'status', i.status, 'issued_on', i.issued_on) order by i.issued_on), '[]'::jsonb)
      from clinic_people.custody_items i where i.holder_id = p_person and i.status in ('with_holder', 'lost', 'damaged')),
    'total_value', (select coalesce(sum(i.value), 0) from clinic_people.custody_items i where i.holder_id = p_person and i.status in ('with_holder', 'lost', 'damaged')));
end $function$

### END
### FUNC hr_custody_workspace()
CREATE OR REPLACE FUNCTION public.hr_custody_workspace()
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare me uuid := public.my_admin_id(); allv boolean := clinic_people.custody_view_all(); mine uuid;
begin
  if me is null then raise exception 'سجل الدخول'; end if;
  select id into mine from clinic_people.people where admin_id = me;
  return jsonb_build_object(
    'can_manage', clinic_people.manage(), 'can_view_all', allv, 'today', (now() at time zone 'Africa/Cairo')::date,
    'items', (select coalesce(jsonb_agg(to_jsonb(i) || jsonb_build_object('holder_name', h.full_name, 'holder_code', h.code, 'came_from_name', f.full_name) order by i.created_at desc), '[]'::jsonb)
      from clinic_people.custody_items i left join clinic_people.people h on h.id = i.holder_id left join clinic_people.people f on f.id = i.came_from_id
      where allv or (mine is not null and i.holder_id = mine)),
    'movements', (select coalesce(jsonb_agg(x order by x.id desc), '[]'::jsonb) from (
      select m.id, m.item_id, m.action, m.on_date, m.note, m.created_at, a.full_name as from_name, b.full_name as to_name
      from clinic_people.custody_movements m join clinic_people.custody_items i on i.id = m.item_id
      left join clinic_people.people a on a.id = m.from_person_id left join clinic_people.people b on b.id = m.to_person_id
      where allv or (mine is not null and i.holder_id = mine) order by m.id desc limit 2000) x),
    'people', case when clinic_people.manage() then (select coalesce(jsonb_agg(jsonb_build_object('id', p.id, 'code', p.code, 'full_name', p.full_name) order by p.full_name), '[]'::jsonb) from clinic_people.people p where p.status <> 'ended') else '[]'::jsonb end);
end $function$

### END
### FUNC hr_insurance_command(text,jsonb)
CREATE OR REPLACE FUNCTION public.hr_insurance_command(p_action text, p_payload jsonb)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare
  me uuid := public.my_admin_id();
  today date := (now() at time zone 'Africa/Cairo')::date;
  e clinic_people.insurance_enrollments%rowtype;
  v uuid := nullif(p_payload->>'id', '')::uuid;
  rid uuid := nullif(p_payload->>'request_id', '')::uuid;
  pid uuid := nullif(p_payload->>'person_id', '')::uuid;
  nt text := trim(coalesce(p_payload->>'note', ''));
  ded numeric; share numeric; d date; dl date;
  prior jsonb; afterj jsonb;
begin
  if me is null then raise exception 'سجل الدخول'; end if;
  if not clinic_people.manage() then raise exception 'سجل التأمينات لإدارة الموارد البشرية'; end if;
  if p_action not in ('create', 'update', 'stop') then raise exception 'إجراء غير متاح'; end if;

  if p_action = 'create' then
    if rid is not null then select id into v from clinic_people.insurance_enrollments where request_id = rid; if found then return v; end if; end if;
    if not exists(select 1 from clinic_people.people where id = pid and status <> 'ended') then raise exception 'اختر موظفًا مستمرًا في العمل'; end if;
    if coalesce(p_payload->>'insurance_type', '') not in ('social', 'medical') then raise exception 'اختر نوع التأمين'; end if;
    ded := coalesce(nullif(p_payload->>'employee_deduction', '')::numeric, 0); share := coalesce(nullif(p_payload->>'center_share', '')::numeric, 0);
    if ded < 0 or share < 0 or ded >= 100000000 or share >= 100000000 or ded::text in ('NaN', 'Infinity') or share::text in ('NaN', 'Infinity') or ded <> round(ded, 2) or share <> round(share, 2) then raise exception 'راجع قيمة الاستقطاع وحصة المركز'; end if;
    d := nullif(p_payload->>'started_on', '')::date; if d is null then raise exception 'اكتب تاريخ بدء الاشتراك'; end if;
    if exists(select 1 from clinic_people.insurance_enrollments where person_id = pid and insurance_type = p_payload->>'insurance_type' and status = 'active') then raise exception 'للموظف اشتراك قائم من نفس النوع؛ أوقفه أولًا'; end if;
    if exists(select 1 from clinic_people.insurance_enrollments x where x.person_id = pid and x.insurance_type = p_payload->>'insurance_type' and x.stopped_on >= d) then raise exception 'يتداخل مع اشتراك سابق من نفس النوع'; end if;
    insert into clinic_people.insurance_enrollments(request_id, person_id, insurance_type, insurance_number, employee_deduction, center_share, started_on, note, created_by)
      values (rid, pid, p_payload->>'insurance_type', trim(coalesce(p_payload->>'insurance_number', '')), ded, share, d, nt, me) returning id, to_jsonb(insurance_enrollments.*) into v, afterj;
    insert into clinic_people.audit(actor_id, action, record_id, before_data, after_data) values (me, 'insurance_create', v, null, afterj);
    return v;
  end if;

  if v is null then raise exception 'اختر الاشتراك'; end if;
  select * into e from clinic_people.insurance_enrollments where id = v for update;
  if not found then raise exception 'الاشتراك غير موجود'; end if;
  if e.revision <> coalesce((p_payload->>'revision')::int, 0) then raise exception 'الاشتراك تغير؛ أعد تحميله قبل الحفظ'; end if;
  prior := to_jsonb(e);

  if p_action = 'update' then
    dl := nullif(p_payload->>'notification_deadline', '')::date;
    if e.status = 'stopped' then
      -- a stopped enrollment keeps its amounts (they are history); only the notification details may be completed
      update clinic_people.insurance_enrollments set stop_reference = coalesce(p_payload->>'stop_reference', stop_reference), notification_deadline = dl,
        insurance_number = trim(coalesce(p_payload->>'insurance_number', insurance_number)), note = coalesce(p_payload->>'note', note), revision = revision + 1, updated_at = now() where id = v;
    else
      ded := coalesce(nullif(p_payload->>'employee_deduction', '')::numeric, 0); share := coalesce(nullif(p_payload->>'center_share', '')::numeric, 0);
      if ded < 0 or share < 0 or ded >= 100000000 or share >= 100000000 or ded::text in ('NaN', 'Infinity') or share::text in ('NaN', 'Infinity') or ded <> round(ded, 2) or share <> round(share, 2) then raise exception 'راجع قيمة الاستقطاع وحصة المركز'; end if;
      if (ded is distinct from e.employee_deduction or share is distinct from e.center_share) and length(trim(coalesce(p_payload->>'reason', ''))) < 3 then raise exception 'اكتب سبب تغيير المبلغ'; end if;
      update clinic_people.insurance_enrollments set insurance_number = trim(coalesce(p_payload->>'insurance_number', insurance_number)), employee_deduction = ded, center_share = share,
        note = coalesce(p_payload->>'note', note), revision = revision + 1, updated_at = now() where id = v;
    end if;
  else -- stop
    if e.status <> 'active' then raise exception 'الاشتراك موقوف بالفعل'; end if;
    d := nullif(p_payload->>'stopped_on', '')::date;
    if d is null or d < e.started_on then raise exception 'تاريخ الإيقاف قبل تاريخ البدء'; end if;
    if d > today + 31 then raise exception 'تاريخ الإيقاف بعيد جدًا عن اليوم'; end if;
    update clinic_people.insurance_enrollments set status = 'stopped', stopped_on = d, stop_reference = trim(coalesce(p_payload->>'stop_reference', '')),
      notification_deadline = nullif(p_payload->>'notification_deadline', '')::date, note = coalesce(nullif(nt, ''), note), revision = revision + 1, updated_at = now() where id = v;
  end if;
  select to_jsonb(x) into afterj from clinic_people.insurance_enrollments x where id = v;
  insert into clinic_people.audit(actor_id, action, record_id, before_data, after_data) values (me, 'insurance_' || p_action, v, prior, afterj);
  return v;
end $function$

### END
### FUNC hr_insurance_deduction(uuid,date)
CREATE OR REPLACE FUNCTION public.hr_insurance_deduction(p_person uuid, p_month date)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare m date := date_trunc('month', p_month)::date;
begin
  if public.my_admin_id() is null then raise exception 'سجل الدخول'; end if;
  if not (clinic_people.manage() or clinic_finance.allowed('create') or clinic_finance.allowed('review')) then raise exception 'ليس لديك صلاحية لهذه العملية' using errcode = '42501'; end if;
  return jsonb_build_object('person_id', p_person, 'month', m,
    'insurance', (select coalesce(sum(employee_deduction), 0) from clinic_people.insurance_enrollments where person_id = p_person and started_on <= (m + interval '1 month - 1 day')::date and (stopped_on is null or stopped_on >= m)),
    'items', (select coalesce(jsonb_agg(jsonb_build_object('type', insurance_type, 'number', insurance_number, 'employee_deduction', employee_deduction, 'center_share', center_share) order by insurance_type), '[]'::jsonb)
      from clinic_people.insurance_enrollments where person_id = p_person and started_on <= (m + interval '1 month - 1 day')::date and (stopped_on is null or stopped_on >= m)));
end $function$

### END
### FUNC hr_insurance_workspace()
CREATE OR REPLACE FUNCTION public.hr_insurance_workspace()
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare me uuid := public.my_admin_id(); allv boolean := clinic_people.insurance_view_all(); mine uuid;
begin
  if me is null then raise exception 'سجل الدخول'; end if;
  select id into mine from clinic_people.people where admin_id = me;
  return jsonb_build_object('can_manage', clinic_people.manage(), 'can_view_all', allv, 'today', (now() at time zone 'Africa/Cairo')::date,
    'items', (select coalesce(jsonb_agg(to_jsonb(i) - 'request_id' || jsonb_build_object('full_name', p.full_name, 'code', p.code, 'person_status', p.status) order by p.full_name, i.insurance_type, i.started_on desc), '[]'::jsonb)
      from clinic_people.insurance_enrollments i join clinic_people.people p on p.id = i.person_id where allv or (mine is not null and i.person_id = mine)),
    'people', case when clinic_people.manage() then (select coalesce(jsonb_agg(jsonb_build_object('id', p.id, 'code', p.code, 'full_name', p.full_name) order by p.full_name), '[]'::jsonb) from clinic_people.people p where p.status <> 'ended') else '[]'::jsonb end);
end $function$

### END
### FUNC hr_job_annex(uuid)
CREATE OR REPLACE FUNCTION public.hr_job_annex(p_person uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare j clinic_people.jobs%rowtype; nm text; begin
  if public.my_admin_id() is null then raise exception 'سجل الدخول'; end if;
  if not clinic_people.manage() then raise exception 'لا تملك إدارة الموارد البشرية'; end if;
  select j2.* into j from clinic_people.jobs j2 join clinic_people.people p on p.job_id = j2.id where p.id = p_person;
  if not found then raise exception 'اربط الموظف بوظيفة أولًا'; end if;
  select full_name into nm from clinic_people.people where id = p_person;
  return jsonb_build_object('full_name', nm, 'title_ar', j.title_ar, 'department', j.department, 'tasks', j.tasks, 'qualifications', j.qualifications, 'experience', j.experience);
end $function$

### END
### FUNC hr_job_assign(uuid,uuid)
CREATE OR REPLACE FUNCTION public.hr_job_assign(p_person uuid, p_job uuid)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare me uuid := public.my_admin_id(); pp clinic_people.people%rowtype; begin
  if me is null then raise exception 'سجل الدخول'; end if;
  if not clinic_people.manage() then raise exception 'لا تملك إدارة الموارد البشرية'; end if;
  select * into pp from clinic_people.people where id = p_person for update;
  if not found then raise exception 'الموظف غير موجود'; end if;
  if pp.kind = 'doctor' then raise exception 'الأطباء خارج دليل الوظائف'; end if;
  if p_job is not null and not exists(select 1 from clinic_people.jobs where id = p_job and active) then raise exception 'الوظيفة غير موجودة'; end if;
  update clinic_people.people set job_id = p_job, updated_at = now() where id = p_person;
  insert into clinic_people.audit(actor_id, action, record_id, before_data, after_data)
    values(me, 'job_assign', p_person, jsonb_build_object('job_id', pp.job_id), jsonb_build_object('job_id', p_job));
end $function$

### END
### FUNC hr_job_band(uuid)
CREATE OR REPLACE FUNCTION public.hr_job_band(p_person uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare pp clinic_people.people%rowtype; j clinic_people.jobs%rowtype; sal numeric; st text; today date := (now() at time zone 'Africa/Cairo')::date; begin
  if not clinic_people.salary_visible() then return jsonb_build_object('visible', false); end if;
  select * into pp from clinic_people.people where id = p_person;
  if not found then return jsonb_build_object('visible', true, 'status', 'no_job'); end if;
  select * into j from clinic_people.jobs where id = pp.job_id;
  if not found then return jsonb_build_object('visible', true, 'status', 'no_job'); end if;
  select (b.payload->>'base')::numeric into sal from clinic_finance.business_requests b
   where b.kind = 'employment' and b.status = 'approved' and b.subject = pp.finance_subject and pp.finance_subject is not null
     and (b.payload->>'from')::date <= today and (b.payload->>'to')::date >= today order by (b.payload->>'from')::date desc limit 1;
  st := case when j.salary_min is null or j.salary_max is null then 'no_band' when sal is null then 'no_salary'
             when sal < j.salary_min then 'below' when sal > j.salary_max then 'above' else 'within' end;
  return jsonb_build_object('visible', true, 'status', st, 'job_id', j.id, 'title_ar', j.title_ar, 'salary_min', j.salary_min, 'salary_max', j.salary_max,
    'salary_approved', j.salary_approved, 'salary', sal,
    'diff', case when st = 'below' then j.salary_min - sal when st = 'above' then sal - j.salary_max end);
end $function$

### END
### FUNC hr_job_save(jsonb)
CREATE OR REPLACE FUNCTION public.hr_job_save(p_payload jsonb)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare me uuid := public.my_admin_id(); v uuid := nullif(p_payload->>'id', '')::uuid; old clinic_people.jobs%rowtype; sv boolean := clinic_people.salary_visible();
  k jsonb; kk jsonb; begin
  if me is null then raise exception 'سجل الدخول'; end if;
  if not clinic_people.is_owner_level() then raise exception 'تعديل دليل الوظائف للإدارة العليا فقط'; end if;
  if length(trim(coalesce(p_payload->>'title_ar', ''))) < 3 then raise exception 'اكتب اسم الوظيفة'; end if;
  k := coalesce(p_payload->'kpis', '[]');
  if jsonb_typeof(k) <> 'array' or jsonb_typeof(coalesce(p_payload->'tasks', '[]')) <> 'array' or jsonb_typeof(coalesce(p_payload->'qualifications', '[]')) <> 'array' then raise exception 'صيغة غير صحيحة'; end if;
  for kk in select * from jsonb_array_elements(k) loop
    if coalesce(kk->>'kind', '') not in ('auto', 'manual') or length(trim(coalesce(kk->>'name', ''))) < 2 then raise exception 'كل مؤشر له اسم ونوع تلقائي أو يدوي'; end if;
  end loop;
  if v is null then
    insert into clinic_people.jobs(code, title_ar, title_en, department, tasks, qualifications, experience, kpis, incentive,
        salary_min, salary_max, salary_approved, salary_note, sort_order)
    values(coalesce(nullif(p_payload->>'code', ''), 'job_' || substr(gen_random_uuid()::text, 1, 8)), trim(p_payload->>'title_ar'), coalesce(p_payload->>'title_en', ''), coalesce(p_payload->>'department', ''),
      coalesce(p_payload->'tasks', '[]'), coalesce(p_payload->'qualifications', '[]'), coalesce(p_payload->>'experience', ''), k, coalesce(p_payload->>'incentive', ''),
      case when sv then nullif(p_payload->>'salary_min', '')::numeric end, case when sv then nullif(p_payload->>'salary_max', '')::numeric end,
      case when sv then nullif(p_payload->>'salary_approved', '')::numeric end, case when sv then coalesce(p_payload->>'salary_note', '') else '' end,
      coalesce(nullif(p_payload->>'sort_order', '')::int, 999)) returning id into v;
    insert into clinic_people.audit(actor_id, action, record_id, after_data) values(me, 'job_save', v, jsonb_build_object('title_ar', p_payload->>'title_ar', 'new', true));
  else
    select * into old from clinic_people.jobs where id = v for update;
    if not found or old.revision <> coalesce((p_payload->>'revision')::int, 0) then raise exception 'الوظيفة اتغيّرت؛ أعد التحميل قبل الحفظ'; end if;
    update clinic_people.jobs set title_ar = trim(p_payload->>'title_ar'), title_en = coalesce(p_payload->>'title_en', title_en), department = coalesce(p_payload->>'department', department),
      tasks = coalesce(p_payload->'tasks', tasks), qualifications = coalesce(p_payload->'qualifications', qualifications), experience = coalesce(p_payload->>'experience', experience),
      kpis = k, incentive = coalesce(p_payload->>'incentive', incentive),
      salary_min = case when sv then nullif(p_payload->>'salary_min', '')::numeric else salary_min end,
      salary_max = case when sv then nullif(p_payload->>'salary_max', '')::numeric else salary_max end,
      salary_approved = case when sv then nullif(p_payload->>'salary_approved', '')::numeric else salary_approved end,
      salary_note = case when sv then coalesce(p_payload->>'salary_note', '') else salary_note end,
      revision = revision + 1, updated_at = now() where id = v;
    -- audit carries the job title only, never the salary figures
    insert into clinic_people.audit(actor_id, action, record_id, after_data) values(me, 'job_save', v, jsonb_build_object('title_ar', p_payload->>'title_ar', 'salary_changed', sv));
  end if;
  return v;
end $function$

### END
### FUNC hr_jobs()
CREATE OR REPLACE FUNCTION public.hr_jobs()
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare sv boolean := clinic_people.salary_visible(); begin
  if public.my_admin_id() is null then raise exception 'سجل الدخول'; end if;
  if not clinic_people.manage() then raise exception 'لا تملك إدارة الموارد البشرية'; end if;
  return jsonb_build_object(
    'can_edit', clinic_people.is_owner_level(), 'salary_visible', sv,
    'jobs', (select coalesce(jsonb_agg(
        (to_jsonb(j) - 'salary_min' - 'salary_max' - 'salary_approved' - 'salary_note')
        || case when sv then jsonb_build_object('salary_min', j.salary_min, 'salary_max', j.salary_max, 'salary_approved', j.salary_approved, 'salary_note', j.salary_note) else '{}'::jsonb end
        || jsonb_build_object('people', (select coalesce(jsonb_agg(jsonb_build_object('id', p.id, 'code', p.code, 'full_name', p.full_name, 'status', p.status) order by p.full_name), '[]')
                                            from clinic_people.people p where p.job_id = j.id and p.status <> 'ended'))
      order by j.sort_order, j.title_ar), '[]') from clinic_people.jobs j where j.active),
    'unclassified', (select coalesce(jsonb_agg(jsonb_build_object('id', p.id, 'code', p.code, 'full_name', p.full_name, 'job_title', p.job_title) order by p.full_name), '[]')
                       from clinic_people.people p where p.job_id is null and p.kind = 'employee' and p.status <> 'ended'));
end $function$

### END
### FUNC hr_my_job()
CREATE OR REPLACE FUNCTION public.hr_my_job()
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare me uuid := public.my_admin_id(); j clinic_people.jobs%rowtype; begin
  if me is null then raise exception 'سجل الدخول'; end if;
  select j2.* into j from clinic_people.jobs j2 join clinic_people.people p on p.job_id = j2.id where p.admin_id = me and p.status <> 'ended' limit 1;
  if not found then return jsonb_build_object('job', null); end if;
  return jsonb_build_object('job', jsonb_build_object('title_ar', j.title_ar, 'title_en', j.title_en, 'department', j.department, 'tasks', j.tasks,
    'qualifications', j.qualifications, 'experience', j.experience,
    'kpis', (select coalesce(jsonb_agg(jsonb_build_object('name', x->>'name', 'kind', x->>'kind')), '[]') from jsonb_array_elements(j.kpis) x)));
end $function$

### END
### FUNC hr_offboarding_command(text,jsonb)
CREATE OR REPLACE FUNCTION public.hr_offboarding_command(p_action text, p_payload jsonb)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare
  me uuid := public.my_admin_id();
  today date := (now() at time zone 'Africa/Cairo')::date;
  c clinic_people.offboarding_cases%rowtype; p clinic_people.people%rowtype; l clinic_people.offboarding_lines%rowtype;
  v uuid := nullif(p_payload->>'id', '')::uuid; rid uuid := nullif(p_payload->>'request_id', '')::uuid;
  r text; d date; amt numeric; net jsonb; tid uuid; key text; n integer; bal numeric; due numeric; adv numeric; prior jsonb; afterj jsonb;
begin
  if me is null then raise exception 'سجل الدخول'; end if;

  if p_action = 'open' then
    if not clinic_people.manage() then raise exception 'فتح إنهاء الخدمة لإدارة الموارد البشرية'; end if;
    if rid is not null then select id into v from clinic_people.offboarding_cases where request_id = rid; if found then return v; end if; end if;
    select * into p from clinic_people.people where id = nullif(p_payload->>'person_id', '')::uuid for update;
    if not found or p.status = 'ended' then raise exception 'اختر موظفًا مستمرًا في العمل'; end if;
    if exists(select 1 from clinic_people.offboarding_cases where person_id = p.id and status not in ('completed', 'cancelled')) then raise exception 'يوجد إجراء إنهاء خدمة مفتوح لهذا الشخص'; end if;
    r := p_payload->>'reason'; if r not in ('resignation', 'termination', 'contract_end', 'other') then raise exception 'اختر سبب إنهاء الخدمة'; end if;
    d := nullif(p_payload->>'last_day', '')::date;
    if d is null or d < today - 60 or d > today + 365 then raise exception 'راجع آخر يوم عمل'; end if;
    insert into clinic_people.offboarding_cases(request_id, person_id, last_day, reason, reason_note, created_by) values (rid, p.id, d, r, trim(coalesce(p_payload->>'reason_note', '')), me) returning id, to_jsonb(offboarding_cases.*) into v, afterj;
    insert into clinic_people.audit(actor_id, action, record_id, before_data, after_data) values (me, 'offboarding_open', v, null, afterj);
    return v;
  end if;

  select * into c from clinic_people.offboarding_cases where id = v for update;
  if not found then raise exception 'الإجراء غير موجود'; end if;
  prior := to_jsonb(c);
  select * into p from clinic_people.people where id = c.person_id;

  if p_action = 'cancel' then
    if not clinic_people.manage() then raise exception 'إلغاء إنهاء الخدمة لإدارة الموارد البشرية'; end if;
    if c.status not in ('requested', 'sheet_ready') then raise exception 'لا يُلغى بعد اعتماد المخالصة'; end if;
    if length(trim(coalesce(p_payload->>'reason', ''))) < 3 then raise exception 'اكتب سبب الإلغاء'; end if;
    update clinic_people.offboarding_cases set status = 'cancelled', cancel_reason = trim(p_payload->>'reason'), revision = revision + 1, updated_at = now() where id = c.id;

  elsif p_action = 'change_last_day' then
    if not clinic_people.manage() then raise exception 'تعديل آخر يوم لإدارة الموارد البشرية'; end if;
    if c.status not in ('requested', 'sheet_ready') then raise exception 'لا يُعدَّل آخر يوم بعد اعتماد المخالصة'; end if;
    d := nullif(p_payload->>'last_day', '')::date;
    if d is null or d < today - 60 or d > today + 365 then raise exception 'راجع آخر يوم عمل'; end if;
    update clinic_people.offboarding_cases set last_day = d, status = 'requested', revision = revision + 1, updated_at = now() where id = c.id;

  elsif p_action = 'load_defaults' then
    perform clinic_finance.require_access('create');
    if c.status not in ('requested', 'sheet_ready') then raise exception 'الكشف مغلق للتعديل'; end if;
    -- replace only the lines the system generated; manual lines and resolutions of manual lines are kept
    delete from clinic_people.offboarding_lines where case_id = c.id and source <> 'manual';
    key := p.doctor_key;
    if key is not null then
      bal := greatest(0, coalesce(clinic_finance.doctor_balance(key), 0));
      if bal > 0 then insert into clinic_people.offboarding_lines(case_id, kind, source, label, amount, created_by) values (c.id, 'due_to_him', 'doctor_balance', 'رصيد الطبيب المستحق (حساب الطبيب)', bal, me); end if;
    end if;
    if p.finance_subject is not null then
      due := greatest(0, coalesce(clinic_finance.employee_due(p.finance_subject), 0));
      if due > 0 then insert into clinic_people.offboarding_lines(case_id, kind, source, label, amount, created_by) values (c.id, 'due_to_him', 'payroll', 'صافي مرتبات مستحقة لم تُصرف', due, me); end if;
      adv := greatest(0, coalesce(clinic_finance.employee_advance(p.finance_subject), 0));
      if adv > 0 then insert into clinic_people.offboarding_lines(case_id, kind, source, label, amount, created_by) values (c.id, 'due_on_him', 'advance', 'سلف غير مستردة', adv, me); end if;
    end if;
    insert into clinic_people.offboarding_lines(case_id, kind, source, label, amount, ref_id, resolution, created_by)
      select c.id, 'custody', 'custody', i.item_name || ' (' || i.code || ')' || case when i.status = 'with_holder' then '' when i.status = 'lost' then ' — مفقودة' else ' — تالفة' end, i.value, i.id, 'pending', me
      from clinic_people.custody_items i where i.holder_id = c.person_id and i.status in ('with_holder', 'lost', 'damaged');
    update clinic_people.offboarding_cases set status = 'requested', sheet_by = null, sheet_at = null, revision = revision + 1, updated_at = now() where id = c.id;

  elsif p_action = 'add_line' then
    perform clinic_finance.require_access('create');
    if c.status not in ('requested', 'sheet_ready') then raise exception 'الكشف مغلق للتعديل'; end if;
    r := p_payload->>'kind'; if r not in ('due_to_him', 'due_on_him', 'custody', 'document') then raise exception 'نوع البند غير معروف'; end if;
    amt := coalesce(nullif(p_payload->>'amount', '')::numeric, 0);
    if amt < 0 or amt >= 100000000 or amt <> round(amt, 2) then raise exception 'راجع المبلغ'; end if;
    if length(trim(coalesce(p_payload->>'label', ''))) < 2 then raise exception 'اكتب وصف البند'; end if;
    if r = 'document' then amt := 0; end if;
    insert into clinic_people.offboarding_lines(case_id, kind, source, label, amount, resolution, created_by)
      values (c.id, r, 'manual', trim(p_payload->>'label'), amt, case when r in ('custody', 'document') then 'pending' else 'counted' end, me);
    update clinic_people.offboarding_cases set status = 'requested', sheet_by = null, sheet_at = null, revision = revision + 1, updated_at = now() where id = c.id;

  elsif p_action = 'remove_line' then
    perform clinic_finance.require_access('create');
    if c.status not in ('requested', 'sheet_ready') then raise exception 'الكشف مغلق للتعديل'; end if;
    delete from clinic_people.offboarding_lines where id = nullif(p_payload->>'line_id', '')::uuid and case_id = c.id and source = 'manual';
    if not found then raise exception 'يُحذف البند اليدوي فقط؛ للبند التلقائي استخدم «تحميل البيانات» من جديد'; end if;
    update clinic_people.offboarding_cases set status = 'requested', sheet_by = null, sheet_at = null, revision = revision + 1, updated_at = now() where id = c.id;

  elsif p_action = 'resolve_line' then
    perform clinic_finance.require_access('create');
    if c.status not in ('requested', 'sheet_ready') then raise exception 'الكشف مغلق للتعديل'; end if;
    select * into l from clinic_people.offboarding_lines where id = nullif(p_payload->>'line_id', '')::uuid and case_id = c.id for update;
    if not found or l.kind not in ('custody', 'document') then raise exception 'البند لا يحتاج معالجة'; end if;
    r := p_payload->>'resolution';
    if r not in ('returned', 'deducted', 'waived') or (r = 'deducted' and l.kind = 'document') then raise exception 'اختر معالجة صحيحة للبند'; end if;
    if r = 'deducted' and l.amount <= 0 then raise exception 'لا تُخصم عهدة بلا قيمة'; end if;
    if r = 'waived' and length(trim(coalesce(p_payload->>'note', ''))) < 3 then raise exception 'اكتب سبب التنازل'; end if;
    update clinic_people.offboarding_lines set resolution = r, resolution_note = trim(coalesce(p_payload->>'note', '')) where id = l.id;
    update clinic_people.offboarding_cases set status = 'requested', sheet_by = null, sheet_at = null, revision = revision + 1, updated_at = now() where id = c.id;

  elsif p_action = 'submit_sheet' then
    perform clinic_finance.require_access('create');
    if c.status <> 'requested' then raise exception 'الكشف مرسل أو مغلق'; end if;
    if not exists(select 1 from clinic_people.offboarding_lines where case_id = c.id) then raise exception 'حمّل بيانات الكشف أو أضف بندًا قبل الإرسال'; end if;
    update clinic_people.offboarding_cases set status = 'sheet_ready', sheet_by = me, sheet_at = now(), return_note = '', revision = revision + 1, updated_at = now() where id = c.id;

  elsif p_action = 'return_sheet' then
    perform clinic_finance.require_access('review');
    if c.status <> 'sheet_ready' then raise exception 'لا يوجد كشف بانتظار الاعتماد'; end if;
    if length(trim(coalesce(p_payload->>'note', ''))) < 3 then raise exception 'اكتب سبب إعادة الكشف'; end if;
    update clinic_people.offboarding_cases set status = 'requested', return_note = trim(p_payload->>'note'), sheet_by = null, sheet_at = null, revision = revision + 1, updated_at = now() where id = c.id;

  elsif p_action = 'approve' then
    perform clinic_finance.require_access('review');
    if c.status <> 'sheet_ready' then raise exception 'لا يوجد كشف بانتظار الاعتماد'; end if;
    if c.revision <> coalesce((p_payload->>'revision')::int, 0) then raise exception 'الكشف تغير؛ أعد تحميله قبل الاعتماد'; end if;
    if me = c.created_by or me = c.sheet_by then raise exception 'لا يعتمد المخالصة من فتح الإجراء أو أعدّ الكشف'; end if;
    if exists(select 1 from clinic_people.offboarding_lines where case_id = c.id and resolution = 'pending') then raise exception 'عالج كل العهد والمستندات (تسليم أو خصم أو تنازل) قبل الاعتماد'; end if;
    select id into tid from clinic_people.offboarding_templates where kind = 'settlement' and status = 'published';
    if tid is null then raise exception 'لا يوجد نص منشور للمخالصة'; end if;
    net := clinic_people.offboarding_net(c.id);
    update clinic_people.offboarding_cases set status = 'approved', approved_by = me, approved_at = now(), net_to_him = (net->>'to_him')::numeric, net_on_him = (net->>'on_him')::numeric, net_amount = (net->>'net')::numeric,
      settlement_template_id = tid, revision = revision + 1, updated_at = now() where id = c.id;

  elsif p_action = 'upload_signed' then
    if not clinic_people.manage() then raise exception 'رفع المخالصة الموقعة لإدارة الموارد البشرية'; end if;
    if c.status <> 'approved' then raise exception 'ارفع الملف بعد اعتماد المخالصة'; end if;
    if coalesce(p_payload->>'url', '') !~ '^https://' or length(p_payload->>'url') > 2000 then raise exception 'رابط الملف الموقع غير صحيح (يبدأ بـ https://)'; end if;
    update clinic_people.offboarding_cases set status = 'signed', signed_url = p_payload->>'url', signed_by = me, signed_at = now(), revision = revision + 1, updated_at = now() where id = c.id;

  elsif p_action = 'record_payment' then
    perform clinic_finance.require_access('create');
    if c.status not in ('approved', 'signed') then raise exception 'سجّل الصرف بعد اعتماد المخالصة'; end if;
    if length(trim(coalesce(p_payload->>'reference', ''))) < 2 then raise exception 'اكتب مرجع صرف صافي المخالصة'; end if;
    d := coalesce(nullif(p_payload->>'paid_on', '')::date, today);
    update clinic_people.offboarding_cases set payment_reference = trim(p_payload->>'reference'), paid_on = d, paid_by = me, revision = revision + 1, updated_at = now() where id = c.id;

  elsif p_action = 'issue_certificate' then
    if not clinic_people.manage() then raise exception 'شهادة الخبرة لإدارة الموارد البشرية'; end if;
    if c.status not in ('approved', 'signed', 'completed') then raise exception 'لا تصدر الشهادة قبل اعتماد المخالصة'; end if;
    if c.signed_url is null then
      -- HARD BLOCK: the certificate unlocks only after the signed settlement file; the single exception is the owner role with a recorded reason
      if not public.has_role('super_admin') then raise exception 'لا تصدر شهادة الخبرة قبل رفع المخالصة الموقعة'; end if;
      if length(trim(coalesce(p_payload->>'override_reason', ''))) < 5 then raise exception 'استثناء المالك يحتاج سببًا مكتوبًا'; end if;
    end if;
    select id into tid from clinic_people.offboarding_templates where kind = 'certificate' and status = 'published';
    if tid is null then raise exception 'لا يوجد نص منشور للشهادة'; end if;
    update clinic_people.offboarding_cases set cert_issued_at = coalesce(cert_issued_at, now()), cert_issued_by = coalesce(cert_issued_by, me), cert_template_id = tid,
      cert_override_reason = case when c.signed_url is null then trim(p_payload->>'override_reason') else cert_override_reason end,
      cert_override_by = case when c.signed_url is null then me else cert_override_by end, revision = revision + 1, updated_at = now() where id = c.id;

  elsif p_action = 'stop_insurance' then
    if not clinic_people.manage() then raise exception 'إيقاف التأمينات لإدارة الموارد البشرية'; end if;
    if c.status not in ('approved', 'signed', 'completed') then raise exception 'أوقف التأمينات بعد اعتماد المخالصة'; end if;
    d := nullif(p_payload->>'stopped_on', '')::date;
    if d is null or d > today + 31 then raise exception 'راجع تاريخ إيقاف التأمينات'; end if;
    update clinic_people.insurance_enrollments set status = 'stopped', stopped_on = greatest(d, started_on), stop_reference = trim(coalesce(p_payload->>'reference', '')),
      notification_deadline = nullif(p_payload->>'deadline', '')::date, revision = revision + 1, updated_at = now() where person_id = c.person_id and status = 'active';
    get diagnostics n = row_count;
    update clinic_people.offboarding_cases set insurance_stopped_on = d, insurance_reference = trim(coalesce(p_payload->>'reference', '')), insurance_deadline = nullif(p_payload->>'deadline', '')::date, revision = revision + 1, updated_at = now() where id = c.id;
    afterj := jsonb_build_object('stopped_enrollments', n);

  elsif p_action = 'complete' then
    if not clinic_people.manage() then raise exception 'إغلاق ملف الموظف لإدارة الموارد البشرية'; end if;
    if c.status not in ('approved', 'signed') then raise exception 'أغلق الملف بعد اعتماد المخالصة'; end if;
    if c.signed_url is null and c.cert_override_reason is null then raise exception 'ارفع المخالصة الموقعة أولًا (أو استثناء مسجّل من المالك)'; end if;
    if c.paid_on is null and coalesce(c.net_amount, 0) > 0 then raise exception 'سجّل صرف صافي المخالصة قبل إغلاق الملف'; end if;
    key := coalesce(p.doctor_key, p.code);
    update clinic_finance.doctor_contracts set valid_to = c.last_day where status = 'active' and doctor_key = key and valid_from <= c.last_day and valid_to > c.last_day;
    get diagnostics n = row_count;
    update clinic_people.insurance_enrollments set status = 'stopped', stopped_on = greatest(c.last_day, started_on), stop_reference = 'أُوقف عند إغلاق ملف الموظف', revision = revision + 1, updated_at = now() where person_id = c.person_id and status = 'active';
    update clinic_people.people set status = 'ended', end_date = c.last_day where id = c.person_id;
    update clinic_people.offboarding_cases set status = 'completed', completed_at = now(), completed_by = me, revision = revision + 1, updated_at = now() where id = c.id;
    afterj := jsonb_build_object('contracts_closed', n);
    if c.last_day <= today and p.admin_id is not null then
      update public.admins set active = false where id = p.admin_id;
      insert into clinic_people.audit(actor_id, action, record_id, before_data, after_data) values (me, 'offboarding_lock_account', c.id, jsonb_build_object('active', true), jsonb_build_object('active', false));
    end if;

  else
    raise exception 'إجراء غير متاح';
  end if;

  select to_jsonb(x) || coalesce(afterj, '{}'::jsonb) into afterj from clinic_people.offboarding_cases x where id = c.id;
  insert into clinic_people.audit(actor_id, action, record_id, before_data, after_data) values (me, 'offboarding_' || p_action, c.id, prior, afterj);
  return c.id;
end $function$

### END
### FUNC hr_offboarding_lock_due()
CREATE OR REPLACE FUNCTION public.hr_offboarding_lock_due()
 RETURNS integer
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare n integer := 0; c record; today date := (now() at time zone 'Africa/Cairo')::date;
begin
  if public.my_admin_id() is null then raise exception 'سجل الدخول'; end if;
  if not clinic_people.offboarding_view() then raise exception 'ليس لديك صلاحية لهذه العملية' using errcode = '42501'; end if;
  for c in select o.id, p.admin_id from clinic_people.offboarding_cases o join clinic_people.people p on p.id = o.person_id where o.status = 'completed' and o.last_day <= today and p.admin_id is not null loop
    if exists(select 1 from public.admins where id = c.admin_id and active) then
      update public.admins set active = false where id = c.admin_id;
      insert into clinic_people.audit(actor_id, action, record_id, before_data, after_data) values (public.my_admin_id(), 'offboarding_lock_account', c.id, jsonb_build_object('active', true), jsonb_build_object('active', false));
      n := n + 1;
    end if;
  end loop;
  return n;
end $function$

### END
### FUNC hr_offboarding_template(text,jsonb)
CREATE OR REPLACE FUNCTION public.hr_offboarding_template(p_action text, p_payload jsonb)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare me uuid := public.my_admin_id(); k text := p_payload->>'kind'; t clinic_people.offboarding_templates%rowtype; v uuid; nv integer;
begin
  if me is null then raise exception 'سجل الدخول'; end if;
  if not clinic_people.manage() then raise exception 'نصوص المخالصة والشهادة لإدارة الموارد البشرية'; end if;
  if p_action = 'save' then
    if k not in ('settlement', 'certificate') then raise exception 'نوع النص غير معروف'; end if;
    if length(trim(coalesce(p_payload->>'body', ''))) < 20 then raise exception 'النص قصير جدًا'; end if;
    perform pg_advisory_xact_lock(712241140);
    select coalesce(max(version), 0) + 1 into nv from clinic_people.offboarding_templates where kind = k;
    insert into clinic_people.offboarding_templates(kind, version, body, note, created_by) values (k, nv, p_payload->>'body', trim(coalesce(p_payload->>'note', '')), me) returning id into v;
    insert into clinic_people.audit(actor_id, action, record_id, before_data, after_data) values (me, 'offboarding_template_save', v, null, jsonb_build_object('kind', k, 'version', nv));
    return v;
  elsif p_action = 'publish' then
    select * into t from clinic_people.offboarding_templates where id = nullif(p_payload->>'id', '')::uuid for update;
    if not found or t.status <> 'draft' then raise exception 'اختر نسخة مسودة للنشر'; end if;
    update clinic_people.offboarding_templates set status = 'retired' where kind = t.kind and status = 'published';
    update clinic_people.offboarding_templates set status = 'published', published_by = me, published_at = now() where id = t.id;
    insert into clinic_people.audit(actor_id, action, record_id, before_data, after_data) values (me, 'offboarding_template_publish', t.id, null, jsonb_build_object('kind', t.kind, 'version', t.version));
    return t.id;
  end if;
  raise exception 'إجراء غير متاح';
end $function$

### END
### FUNC hr_offboarding_workspace()
CREATE OR REPLACE FUNCTION public.hr_offboarding_workspace()
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare me uuid := public.my_admin_id();
begin
  if me is null then raise exception 'سجل الدخول'; end if;
  if not clinic_people.offboarding_view() then raise exception 'ليس لديك صلاحية لهذه العملية' using errcode = '42501'; end if;
  return jsonb_build_object(
    'me', me, 'today', (now() at time zone 'Africa/Cairo')::date,
    'can_manage', clinic_people.manage(), 'can_prepare', clinic_finance.allowed('create'), 'can_review', clinic_finance.allowed('review'), 'is_owner', public.has_role('super_admin'),
    'cases', (select coalesce(jsonb_agg(to_jsonb(o) - 'request_id' || jsonb_build_object(
        'full_name', p.full_name, 'code', p.code, 'job_title', p.job_title, 'start_date', p.start_date, 'net', clinic_people.offboarding_net(o.id),
        'lines', (select coalesce(jsonb_agg(to_jsonb(l) - 'created_by' order by l.kind, l.created_at), '[]'::jsonb) from clinic_people.offboarding_lines l where l.case_id = o.id))
        order by o.created_at desc), '[]'::jsonb)
      from clinic_people.offboarding_cases o join clinic_people.people p on p.id = o.person_id),
    'templates', (select coalesce(jsonb_agg(jsonb_build_object('id', t.id, 'kind', t.kind, 'version', t.version, 'status', t.status, 'note', t.note, 'published_at', t.published_at,
        'body', t.body) order by t.kind, t.version desc), '[]'::jsonb) from clinic_people.offboarding_templates t),
    'people', case when clinic_people.manage() then (select coalesce(jsonb_agg(jsonb_build_object('id', p.id, 'code', p.code, 'full_name', p.full_name) order by p.full_name), '[]'::jsonb)
      from clinic_people.people p where p.status <> 'ended' and not exists(select 1 from clinic_people.offboarding_cases o where o.person_id = p.id and o.status not in ('completed', 'cancelled'))) else '[]'::jsonb end);
end $function$

### END
### FUNC hr_onboard_accounts(uuid[])
CREATE OR REPLACE FUNCTION public.hr_onboard_accounts(p_accounts uuid[])
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare a public.admins%rowtype;v uuid;created integer:=0;skipped integer:=0;begin
 if not clinic_people.manage() then raise exception 'تحتاج إدارة الموارد البشرية';end if;
 if coalesce(cardinality(p_accounts),0) not between 1 and 200 then raise exception 'اختر حسابات المستخدمين';end if;
 perform pg_advisory_xact_lock(712241025);
 for a in select * from public.admins where id=any(p_accounts) and active loop
  if exists(select 1 from clinic_people.people where admin_id=a.id) then skipped:=skipped+1;continue;end if;
  v:=public.hr_command('person',jsonb_build_object('full_name',a.name,'admin_id',a.id,'email',to_jsonb(a)->>'email','kind','unclassified','status','needs_setup','notes','ملف مبدئي من حساب دخول موجود. نوع العلاقة والعقد والراتب وتواريخ العمل تحتاج استكمالًا. دور الحساب الحالي: '||coalesce(a.role,'')));
  created:=created+1;
 end loop;return jsonb_build_object('created',created,'already_linked',skipped);
end $function$

### END
### FUNC hr_overtime(text,jsonb)
CREATE OR REPLACE FUNCTION public.hr_overtime(p_action text, p_payload jsonb)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare me uuid := public.my_admin_id(); mine uuid; pid uuid; st clinic_people.overtime_settings%rowtype; r clinic_people.overtime_requests%rowtype;
  mfrom date; mto date; mins int; exp int; hr boolean; team uuid[]; v uuid;
begin
  if me is null then raise exception 'سجل الدخول'; end if;
  select * into st from clinic_people.overtime_settings where id;
  select p.id into mine from clinic_people.people p where p.admin_id = me and p.status <> 'ended' limit 1;
  hr := clinic_people.manage();
  select coalesce(array_agg(p.id), '{}') into team from clinic_people.people p join clinic_people.people m on m.id = p.manager_id
   where m.admin_id = me and p.status <> 'ended';

  if p_action = 'workspace' then
    mfrom := date_trunc('month', coalesce(nullif(p_payload->>'month', '')::date, (now() at time zone 'Africa/Cairo')::date))::date;
    mto := (mfrom + interval '1 month' - interval '1 day')::date;
    return jsonb_build_object('is_hr', hr, 'can_settings', public.has_role('super_admin') or public.has_role('general_manager'),
      'settings', to_jsonb(st) - 'id', 'me_person', mine, 'month', mfrom,
      'people', coalesce((select jsonb_agg(jsonb_build_object('id', p.id, 'name', p.full_name, 'department', p.department) order by p.full_name)
                          from clinic_people.people p where p.status <> 'ended' and (hr or p.id = any(team) or p.id = mine)), '[]'::jsonb),
      'my_tasks', coalesce((select jsonb_agg(jsonb_build_object('id', t.id, 'title', t.title) order by t.created_at desc) from (
                     select t2.id, t2.title, t2.created_at from public.tasks t2 where t2.assignee_id = me order by t2.created_at desc limit 40) t), '[]'::jsonb),
      'mine', coalesce((select jsonb_agg(to_jsonb(q) || jsonb_build_object('task_title', (select title from public.tasks where id = q.task_id)) order by q.created_at desc)
                        from clinic_people.overtime_requests q where q.person_id = mine and q.day >= mfrom - 31), '[]'::jsonb),
      'to_review', coalesce((select jsonb_agg(to_jsonb(q) || jsonb_build_object('person_name', p.full_name, 'task_title', t.title, 'task_description', left(t.description, 600)) order by q.created_at)
                        from clinic_people.overtime_requests q join clinic_people.people p on p.id = q.person_id left join public.tasks t on t.id = q.task_id
                        where q.status = 'pending' and (hr or q.person_id = any(team)) and p.admin_id is distinct from me), '[]'::jsonb),
      'report', case when hr or cardinality(team) > 0 then coalesce((select jsonb_agg(jsonb_build_object('person_id', x.person_id, 'name', p.full_name, 'day', x.day,
                        'scheduled_end', x.scheduled_end, 'actual_end', x.actual_end, 'close_at', x.close_at, 'recorded_min', x.recorded_min, 'capped_min', x.capped_min,
                        'approved_min', x.approved_min, 'counted_min', x.counted_min, 'requests', x.requests,
                        'flag', x.approved_min = 0 and x.capped_min >= st.alert_minutes) order by x.day desc, p.full_name)
                        from clinic_people.overtime_rows(mfrom, mto, null) x join clinic_people.people p on p.id = x.person_id
                        where hr or x.person_id = any(team)), '[]'::jsonb) else '[]'::jsonb end,
      'repeaters', case when hr then coalesce((select jsonb_agg(jsonb_build_object('person_id', y.person_id, 'name', p.full_name, 'times', y.n) order by y.n desc)
                        from (select x.person_id, count(*) n from clinic_people.overtime_rows(mfrom, mto, null) x
                              where x.approved_min = 0 and x.capped_min >= st.alert_minutes group by x.person_id having count(*) >= st.repeat_count) y
                        join clinic_people.people p on p.id = y.person_id), '[]'::jsonb) else '[]'::jsonb end);

  elsif p_action = 'request' then
    pid := coalesce(nullif(p_payload->>'person_id', '')::uuid, mine);
    if pid is null then raise exception 'حسابك مش مربوط بملف موظف؛ كلّم الموارد البشرية'; end if;
    if pid <> coalesce(mine, '00000000-0000-0000-0000-000000000000'::uuid) and not (hr or pid = any(team)) then raise exception 'تقدر تطلب لنفسك أو لفريقك بس' using errcode = '42501'; end if;
    mins := (p_payload->>'minutes')::int;
    if mins is null or mins < 5 or mins > 720 then raise exception 'اكتب المدة بالدقايق (من 5 لـ 720)'; end if;
    if length(trim(coalesce(p_payload->>'reason', ''))) < 3 then raise exception 'اكتب السبب أو المهمة'; end if;
    if nullif(p_payload->>'task_id', '') is not null and not exists (select 1 from public.tasks where id = (p_payload->>'task_id')::uuid) then raise exception 'المهمة غير موجودة'; end if;
    insert into clinic_people.overtime_requests(person_id, day, minutes, reason, task_id, created_by)
    values (pid, coalesce(nullif(p_payload->>'day', '')::date, (now() at time zone 'Africa/Cairo')::date), mins, trim(p_payload->>'reason'),
            nullif(p_payload->>'task_id', '')::uuid, me) returning * into r;
    return to_jsonb(r);

  elsif p_action = 'review' then
    select * into r from clinic_people.overtime_requests where id = (p_payload->>'id')::uuid for update;
    if not found then raise exception 'الطلب غير موجود'; end if;
    if r.status <> 'pending' then return to_jsonb(r); end if;
    if not clinic_people.overtime_can_review(r.person_id) then raise exception 'الموافقة للمدير المباشر أو الموارد البشرية (ومش على طلبك إنت)' using errcode = '42501'; end if;
    if (p_payload->>'approve')::boolean is not true then
      if length(trim(coalesce(p_payload->>'note', ''))) < 3 then raise exception 'اكتب سبب الرفض'; end if;
      update clinic_people.overtime_requests set status = 'rejected', review_note = trim(p_payload->>'note'), reviewed_by = me, reviewed_at = now() where id = r.id returning * into r;
      return to_jsonb(r);
    end if;
    mins := coalesce(nullif(p_payload->>'approved_minutes', '')::int, r.minutes);
    exp := nullif(p_payload->>'expected_minutes', '')::int;
    if mins < 0 or mins > 720 then raise exception 'الدقايق المعتمدة غير صالحة'; end if;
    if r.task_id is not null and exp is null then raise exception 'اكتب الوقت المتوقع للمهمة بالدقايق'; end if;
    if exp is not null and mins > ceil(exp * (1 + st.task_tolerance_pct / 100.0)) and length(trim(coalesce(p_payload->>'extra_reason', ''))) < 3 then
      raise exception 'المعتمد أكبر من وقت المهمة المتوقع + %٪ (%) — اكتب سبب الزيادة', st.task_tolerance_pct, ceil(exp * (1 + st.task_tolerance_pct / 100.0));
    end if;
    update clinic_people.overtime_requests set status = 'approved', approved_minutes = mins, expected_minutes = exp,
      extra_reason = nullif(trim(coalesce(p_payload->>'extra_reason', '')), ''), review_note = nullif(trim(coalesce(p_payload->>'note', '')), ''),
      reviewed_by = me, reviewed_at = now() where id = r.id returning * into r;
    return to_jsonb(r);

  elsif p_action = 'cancel' then
    update clinic_people.overtime_requests set status = 'cancelled' where id = (p_payload->>'id')::uuid and created_by = me and status = 'pending' returning * into r;
    if not found then raise exception 'الطلب مش متاح للإلغاء'; end if;
    return to_jsonb(r);

  elsif p_action = 'settings' then
    if not (public.has_role('super_admin') or public.has_role('general_manager')) then raise exception 'الإعدادات للسوبر أدمن أو المدير العام' using errcode = '42501'; end if;
    update clinic_people.overtime_settings set
      pay_enabled = coalesce((p_payload->>'pay_enabled')::boolean, pay_enabled),
      task_tolerance_pct = coalesce((p_payload->>'task_tolerance_pct')::int, task_tolerance_pct),
      alert_minutes = coalesce((p_payload->>'alert_minutes')::int, alert_minutes),
      repeat_count = coalesce((p_payload->>'repeat_count')::int, repeat_count),
      updated_by = me, updated_at = now() where id returning * into st;
    return to_jsonb(st) - 'id';
  end if;
  raise exception 'إجراء غير معروف';
end $function$

### END
### FUNC hr_payroll_calculate(uuid,date)
CREATE OR REPLACE FUNCTION public.hr_payroll_calculate(p_person uuid, p_month date)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare b jsonb; rate numeric; raw numeric; counted numeric; pay_on boolean; dt date; old_allow numeric; new_allow numeric; base numeric; old_ded numeric; gross numeric; ded numeric;
begin
  b := clinic_people.payroll_before_overtime_control(p_person, p_month);
  dt := (b->>'month')::date;
  select coalesce(r.overtime_hour, 0) into rate from clinic_people.pay_rules r where r.id = (b->>'rule_id')::uuid;
  raw := coalesce((b->>'overtime_hours')::numeric, 0);
  counted := round(clinic_people.overtime_counted_hours(p_person, dt, (dt + interval '1 month' - interval '1 day')::date), 2);
  select pay_enabled into pay_on from clinic_people.overtime_settings where id;
  old_allow := coalesce((b->>'allowance')::numeric, 0);
  new_allow := round(old_allow - raw * coalesce(rate, 0) + case when pay_on then counted * coalesce(rate, 0) else 0 end, 2);
  base := coalesce((b->>'base')::numeric, 0);
  old_ded := coalesce((b->>'salary_deduction')::numeric, 0);
  gross := base + new_allow;
  ded := least(old_ded, gross);
  return b || jsonb_build_object('overtime_hours_recorded', raw, 'overtime_hours', counted, 'overtime_pay_enabled', coalesce(pay_on, false),
    'overtime_pay', case when pay_on then round(counted * coalesce(rate, 0), 2) else 0 end,
    'allowance', new_allow, 'salary_deduction', ded, 'pre_tax_net', gross - ded);
end $function$

### END
### FUNC hr_payroll_command(text,jsonb)
CREATE OR REPLACE FUNCTION public.hr_payroll_command(p_action text, p_payload jsonb)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare me uuid:=public.my_admin_id();v uuid:=nullif(p_payload->>'id','')::uuid;r clinic_people.pay_rules%rowtype;a clinic_people.pay_adjustments%rowtype;rowj jsonb;person clinic_people.people%rowtype;am numeric;import_row clinic_people.imports%rowtype;att clinic_people.attendance%rowtype;temp uuid;old clinic_people.pay_rules%rowtype;begin
 if not clinic_people.manage() then raise exception 'تحتاج إدارة الموارد البشرية';end if;
 perform pg_advisory_xact_lock(712241025);
 if p_action='rule' then
   if nullif(p_payload->>'supersedes','') is not null and not exists(select 1 from clinic_people.pay_rules x where x.id=(p_payload->>'supersedes')::uuid and x.status='approved' and x.person_id=(p_payload->>'person_id')::uuid) then raise exception 'القاعدة المستبدلة يجب أن تكون معتمدة ولنفس الموظف';end if;
  insert into clinic_people.pay_rules(supersedes,guaranteed_minimum,person_id,valid_from,valid_to,late_grace,late_minute,absence_day,overtime_hour,note,created_by) values(nullif(p_payload->>'supersedes','')::uuid,coalesce((p_payload->>'guaranteed_minimum')::boolean,false),(p_payload->>'person_id')::uuid,(p_payload->>'valid_from')::date,(p_payload->>'valid_to')::date,coalesce((p_payload->>'late_grace')::int,0),coalesce((p_payload->>'late_minute')::numeric,0),coalesce((p_payload->>'absence_day')::numeric,0),coalesce((p_payload->>'overtime_hour')::numeric,0),p_payload->>'note',me) returning id into v;
 elsif p_action='rule_review' then
  select * into r from clinic_people.pay_rules where id=v for update;
  if not found or r.status<>'pending' or r.created_by=me then raise exception 'تحتاج قاعدة معلقة ومراجعًا آخر';end if;
  if coalesce(p_payload->>'decision','') not in ('approved','rejected') or length(trim(coalesce(p_payload->>'review_note','')))<3 then raise exception 'اكتب القرار وسببه';end if;
  -- A reviewed replacement ends the approved rule it supersedes: shortened to the day before, or marked superseded
  -- when the replacement starts on/before it. Same reviewer, same transaction, audited.
  if p_payload->>'decision'='approved' and r.supersedes is not null then
   select * into old from clinic_people.pay_rules where id=r.supersedes for update;
   if not found or old.status<>'approved' or old.person_id<>r.person_id then raise exception 'القاعدة المستبدلة لم تعد معتمدة؛ أعد إنشاء القاعدة';end if;
   if r.valid_from<=old.valid_from then update clinic_people.pay_rules set status='superseded' where id=old.id;
   else update clinic_people.pay_rules set valid_to=least(old.valid_to,r.valid_from-1) where id=old.id;end if;
   insert into clinic_people.audit(actor_id,action,record_id,before_data,after_data) values(me,'rule_superseded',old.id,to_jsonb(old),(select to_jsonb(x) from clinic_people.pay_rules x where x.id=old.id));
  end if;
  if p_payload->>'decision'='approved' and exists(select 1 from clinic_people.pay_rules where person_id=r.person_id and status='approved' and daterange(valid_from,valid_to,'[]')&&daterange(r.valid_from,r.valid_to,'[]')) then raise exception 'توجد قواعد أجر متداخلة؛ راجع فترات السريان';end if;
  if coalesce(p_payload->>'decision','') not in ('approved','rejected') or length(trim(coalesce(p_payload->>'review_note','')))<3 then raise exception 'اكتب القرار وسببه';end if;
  update clinic_people.pay_rules set status=p_payload->>'decision',reviewed_by=me,review_note=p_payload->>'review_note' where id=v;
 elsif p_action='adjustment' then
  select * into person from clinic_people.people where id=(p_payload->>'person_id')::uuid and status<>'ended';if not found then raise exception 'اختر موظفًا مستمرًا';end if;
  am:=(p_payload->>'amount')::numeric;
  if p_payload->>'kind'='commission' then
   if person.doctor_key is not null then raise exception 'نسب الطبيب تصرف من مستحقات الأطباء لمنع ازدواجها بالمرتب';end if;
   if not exists(select 1 from public.pricing_services where id=(p_payload->>'service_id')::uuid and active) or (p_payload->>'percent')::numeric not between 0.0001 and 100 or (p_payload->>'basis_amount')::numeric<=0 then raise exception 'أكمل الخدمة وقيمة الأساس والنسبة';end if;
   am:=round((p_payload->>'basis_amount')::numeric*(p_payload->>'percent')::numeric/100,2);
  end if;
  insert into clinic_people.pay_adjustments(person_id,month,kind,amount,service_id,basis_amount,percent,reference,note,created_by) values(person.id,(p_payload->>'month')::date,p_payload->>'kind',am,nullif(p_payload->>'service_id','')::uuid,nullif(p_payload->>'basis_amount','')::numeric,nullif(p_payload->>'percent','')::numeric,trim(p_payload->>'reference'),p_payload->>'note',me) returning id into v;
 elsif p_action='adjustment_review' then
  select * into a from clinic_people.pay_adjustments where id=v for update;
  if not found or a.status<>'pending' or a.created_by=me or coalesce(p_payload->>'decision','') not in ('approved','rejected') or length(trim(coalesce(p_payload->>'review_note','')))<3 then raise exception 'تحتاج بندًا معلقًا ومراجعًا آخر وسبب القرار';end if;
  update clinic_people.pay_adjustments set status=p_payload->>'decision',reviewed_by=me,review_note=p_payload->>'review_note' where id=v;
 elsif p_action='attendance_import_review' then
  select * into import_row from clinic_people.imports where id=v for update;
  if not found or import_row.created_by=me then raise exception 'يلزم ملف حضور ومراجع آخر';end if;
  for att in select * from clinic_people.attendance where source_import_id=v and status='pending' for update loop perform public.hr_command('attendance_review',jsonb_build_object('id',att.id,'decision',p_payload->>'decision','review_note',p_payload->>'review_note'));end loop;
 elsif p_action='import_adjustments' then
  if jsonb_typeof(p_payload->'rows')<>'array' or jsonb_array_length(p_payload->'rows') not between 1 and 5000 or coalesce(length(p_payload->>'checksum'),0)<10 then raise exception 'راجع ملف البنود';end if;
  insert into clinic_people.imports(checksum,filename,rows_count,created_by) values(p_payload->>'checksum',p_payload->>'filename',jsonb_array_length(p_payload->'rows'),me) returning id into v;
  for rowj in select * from jsonb_array_elements(p_payload->'rows') loop perform public.hr_payroll_command('adjustment',rowj);end loop;
 elsif p_action='import_attendance' then
  if jsonb_typeof(p_payload->'rows')<>'array' or jsonb_array_length(p_payload->'rows') not between 1 and 5000 or coalesce(length(p_payload->>'checksum'),0)<10 then raise exception 'راجع عدد السطور وبصمة الملف';end if;
  insert into clinic_people.imports(checksum,filename,rows_count,created_by) values(p_payload->>'checksum',p_payload->>'filename',jsonb_array_length(p_payload->'rows'),me) returning id into v;
  for rowj in select * from jsonb_array_elements(p_payload->'rows') loop
   if not exists(select 1 from clinic_people.people where id=(rowj->>'person_id')::uuid and status<>'ended') then raise exception 'موظف غير معروف في ملف الحضور';end if;
   temp:=public.hr_command('attendance',rowj||jsonb_build_object('note','استيراد '||(p_payload->>'filename')||' / '||coalesce(rowj->>'note','')));
   update clinic_people.attendance set source_import_id=v where id=temp;
  end loop;
 elsif p_action='device' then
  insert into clinic_people.device_settings(kind,name,model,branch,note,created_by) values(p_payload->>'kind',p_payload->>'name',p_payload->>'model',coalesce(p_payload->>'branch',''),coalesce(p_payload->>'note',''),me) returning id into v;
 else raise exception 'إجراء غير متاح';end if;
 insert into clinic_people.audit(actor_id,action,record_id,after_data) values(me,p_action,v,jsonb_build_object('id',v,'source','payroll_workspace'));return v;
end $function$

### END
### FUNC hr_payroll_prepare(uuid,date,jsonb,uuid)
CREATE OR REPLACE FUNCTION public.hr_payroll_prepare(p_person uuid, p_month date, p_payload jsonb, p_token uuid)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$declare calc jsonb;begin
 perform pg_advisory_xact_lock(712241025);calc:=public.hr_payroll_calculate(p_person,p_month);
 return public.clinic_finance_business_command('request',jsonb_build_object('kind','payroll','subject',calc->>'subject','contract_id',calc->>'contract_id','month',calc->>'month','allowance',calc->'allowance','salary_deduction',calc->'salary_deduction','tax',coalesce(p_payload->'tax','0'),'insurance',coalesce(p_payload->'insurance','0'),'recovery',coalesce(p_payload->'recovery','0'),'reference',p_payload->>'reference','note',p_payload->>'note','hr_calculation',calc),p_token);end $function$

### END
### FUNC hr_payroll_workspace(date)
CREATE OR REPLACE FUNCTION public.hr_payroll_workspace(p_month date)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$declare dt date:=date_trunc('month',p_month)::date;begin
 if not clinic_people.manage() then raise exception 'تحتاج إدارة الموارد البشرية';end if;
 return jsonb_build_object('rules',(select coalesce(jsonb_agg(r),'[]') from clinic_people.pay_rules r),'adjustments',(select coalesce(jsonb_agg(a),'[]') from clinic_people.pay_adjustments a where month=dt),'devices',(select coalesce(jsonb_agg(d),'[]') from clinic_people.device_settings d),'imports',(select coalesce(jsonb_agg(x),'[]') from(select * from clinic_people.imports order by created_at desc limit 30)x),'services',(select coalesce(jsonb_agg(jsonb_build_object('id',id,'name',name,'code',canonical_code)),'[]') from public.pricing_services where active));end $function$

### END
### FUNC hr_person_duties(uuid)
CREATE OR REPLACE FUNCTION public.hr_person_duties(p_person uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare p clinic_people.people%rowtype; h uuid;
begin
  if not clinic_people.manage() then raise exception 'تحتاج إدارة الموارد البشرية'; end if;
  select * into p from clinic_people.people where id = p_person;
  if not found then raise exception 'الموظف غير موجود'; end if;
  h := case when p.manager_role is null then null else clinic_people.role_holder(p.manager_role) end;
  return jsonb_build_object('manager_role', p.manager_role, 'holder_id', h,
    'holder_name', (select coalesce(nullif(name, ''), email) from public.admins where id = h),
    'duties', coalesce((select jsonb_agg(jsonb_build_object('id', r.id, 'title', r.title, 'interval_value', r.interval_value,
        'interval_unit', r.interval_unit, 'active', r.active, 'project', (select title from public.task_projects where id = r.project_id))
        order by r.created_at) from public.task_recurrences r where r.for_person_id = p.id), '[]'::jsonb));
end $function$

### END
### FUNC hr_presence_ignore(text,integer,boolean)
CREATE OR REPLACE FUNCTION public.hr_presence_ignore(p_device_id text, p_device_user_id integer, p_ignore boolean)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare me uuid := public.my_admin_id();
begin
  if me is null then raise exception 'سجل الدخول'; end if;
  if not clinic_people.manage() then raise exception 'تحتاج إدارة الموارد البشرية'; end if;
  if coalesce(p_device_id, '') !~ '^[A-Za-z0-9_.-]{1,40}$' or coalesce(p_device_user_id, 0) <= 0 or p_ignore is null then raise exception 'راجع رقم الجهاز'; end if;
  perform pg_advisory_xact_lock(712251112);
  if p_ignore then
    delete from clinic_people.device_user_map where device_id = p_device_id and device_user_id = p_device_user_id;
    insert into clinic_people.device_user_ignore(device_id, device_user_id, created_by) values (p_device_id, p_device_user_id, me) on conflict do nothing;
  else
    delete from clinic_people.device_user_ignore where device_id = p_device_id and device_user_id = p_device_user_id;
  end if;
  insert into clinic_people.audit(actor_id, action, record_id, after_data)
    values (me, case when p_ignore then 'presence_ignore' else 'presence_unignore' end, gen_random_uuid(), jsonb_build_object('device_id', p_device_id, 'device_user_id', p_device_user_id));
end $function$

### END
### FUNC hr_presence_map(text,integer,uuid)
CREATE OR REPLACE FUNCTION public.hr_presence_map(p_device_id text, p_device_user_id integer, p_person_id uuid)
 RETURNS void
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare me uuid := public.my_admin_id();
begin
  if me is null then raise exception 'سجل الدخول'; end if;
  if not clinic_people.manage() then raise exception 'تحتاج إدارة الموارد البشرية'; end if;
  if coalesce(p_device_id, '') !~ '^[A-Za-z0-9_.-]{1,40}$' or coalesce(p_device_user_id, 0) <= 0 then raise exception 'راجع رقم الجهاز والموظف'; end if;
  perform pg_advisory_xact_lock(712251112);
  if p_person_id is null then
    delete from clinic_people.device_user_map where device_id = p_device_id and device_user_id = p_device_user_id;
    return;
  end if;
  if not exists (select 1 from clinic_people.people where id = p_person_id and status <> 'ended') then raise exception 'اختر موظفًا مستمرًا'; end if;
  if exists (select 1 from clinic_people.people where id = p_person_id and kind = 'doctor') then raise exception 'الحضور اللحظي للموظفين الإداريين فقط'; end if;
  delete from clinic_people.device_user_ignore where device_id = p_device_id and device_user_id = p_device_user_id;
  delete from clinic_people.device_user_map where device_id = p_device_id and person_id = p_person_id and device_user_id <> p_device_user_id;
  insert into clinic_people.device_user_map(device_id, device_user_id, person_id, created_by) values (p_device_id, p_device_user_id, p_person_id, me)
    on conflict (device_id, device_user_id) do update set person_id = excluded.person_id, created_by = excluded.created_by, created_at = now();
  insert into clinic_people.audit(actor_id, action, record_id, after_data)
    values (me, 'presence_map', p_person_id, jsonb_build_object('device_id', p_device_id, 'device_user_id', p_device_user_id));
end $function$

### END
### FUNC hr_presence_snapshot(integer)
CREATE OR REPLACE FUNCTION public.hr_presence_snapshot(p_lookback_hours integer DEFAULT 16)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare lb integer := least(greatest(coalesce(p_lookback_hours, 16), 1), 48);
begin
  if public.my_admin_id() is null then raise exception 'سجل الدخول'; end if;
  if not clinic_people.manage() then raise exception 'تحتاج إدارة الموارد البشرية'; end if;
  return jsonb_build_object(
    'can_manage', true,
    'now', now(),
    'lookback_hours', lb,
    'last_received_at', (select max(received_at) from clinic_people.device_punches),
    'last_seen_at', (select max(last_seen_at) from clinic_people.device_feed),
    'last_punch_at', (select max(ts) from clinic_people.device_punches),
    'people', (select coalesce(jsonb_agg(jsonb_build_object('id', p.id, 'code', p.code, 'full_name', p.full_name, 'department', p.department) order by p.full_name), '[]'::jsonb)
      from clinic_people.people p where p.status <> 'ended' and p.kind <> 'doctor'),
    'ignored', (select coalesce(jsonb_agg(jsonb_build_object('device_id', i.device_id, 'device_user_id', i.device_user_id,
        'last_punch_at', (select max(d.ts) from clinic_people.device_punches d where d.device_id = i.device_id and d.device_user_id = i.device_user_id)) order by i.device_user_id), '[]'::jsonb)
      from clinic_people.device_user_ignore i),
    'rows', (
      with recent as (
        select d.device_id, d.device_user_id,
          (array_agg(d.punch order by d.ts desc))[1] as last_punch,
          max(d.ts) as last_punch_at,
          max(d.ts) filter (where d.punch in (0, 3, 4)) as last_in_at,
          max(d.ts) filter (where d.punch in (1, 5)) as last_out_at,
          count(*) as punches
        from clinic_people.device_punches d
        where d.ts >= now() - make_interval(hours => lb)
          and not exists (select 1 from clinic_people.device_user_ignore i where i.device_id = d.device_id and i.device_user_id = d.device_user_id)
        group by d.device_id, d.device_user_id),
      known as (
        select m.device_id, m.device_user_id, m.person_id from clinic_people.device_user_map m
        join clinic_people.people p on p.id = m.person_id and p.status <> 'ended' and p.kind <> 'doctor'
        where not exists (select 1 from clinic_people.device_user_ignore i where i.device_id = m.device_id and i.device_user_id = m.device_user_id)),
      joined as (
        select coalesce(k.device_id, r.device_id) as device_id, coalesce(k.device_user_id, r.device_user_id) as device_user_id, k.person_id,
          r.last_punch, r.last_punch_at, r.last_in_at, r.last_out_at, coalesce(r.punches, 0) as punches
        from known k full join recent r on r.device_id = k.device_id and r.device_user_id = k.device_user_id)
      select coalesce(jsonb_agg(jsonb_build_object(
        'device_id', j.device_id, 'device_user_id', j.device_user_id, 'person_id', j.person_id,
        'mapped', j.person_id is not null, 'full_name', p.full_name, 'code', p.code, 'department', p.department, 'job_title', p.job_title,
        'state', case when j.last_punch is null then 'none' when j.last_punch in (0, 3, 4) then 'in' when j.last_punch = 2 then 'break' else 'out' end,
        'last_punch', j.last_punch, 'last_punch_at', j.last_punch_at, 'last_in_at', j.last_in_at, 'last_out_at', j.last_out_at, 'punches', j.punches,
        'minutes_since', case when j.last_punch_at is null then null else floor(extract(epoch from (now() - j.last_punch_at)) / 60)::integer end
      ) order by (j.last_punch in (0, 3, 4)) desc nulls last, j.last_punch_at desc nulls last, p.full_name), '[]'::jsonb)
      from joined j left join clinic_people.people p on p.id = j.person_id)
  );
end $function$

### END
### FUNC hr_save_employee(jsonb,text,text,uuid)
CREATE OR REPLACE FUNCTION public.hr_save_employee(p_payload jsonb, p_mode text DEFAULT 'existing'::text, p_role text DEFAULT NULL::text, p_request_id uuid DEFAULT gen_random_uuid())
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare
  me uuid:=public.my_admin_id();
  aid uuid;
  pid uuid;
  em text:=lower(trim(p_payload->>'email'));
  j public.hr_account_jobs%rowtype;
  linked clinic_people.people%rowtype;
  work_payload jsonb:=p_payload;
  current_pid uuid:=nullif(p_payload->>'id','')::uuid;
  adopted boolean:=false;
begin
  if me is null or not clinic_people.manage() then raise exception 'تحتاج إدارة الموارد البشرية'; end if;
  if p_mode not in('none','existing','new') then raise exception 'اختر طريقة ربط الحساب'; end if;

  if p_mode='new' then
    select * into j from public.hr_account_jobs where id=p_request_id;
    if found then
      if j.created_by<>me or j.email<>em or j.role<>p_role or j.name<>trim(p_payload->>'full_name') then raise exception 'طلب مختلف بنفس المرجع'; end if;
      return jsonb_build_object('person_id',j.person_id,'job_id',j.id,'status',j.status);
    end if;
    if em is null or length(em)>254 or em !~ '^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$' or length(trim(coalesce(p_payload->>'phone','')))<7 then raise exception 'أدخل بريدًا صحيحًا ورقم هاتف لإنشاء الحساب'; end if;
    if p_role is null or p_role not in('page_manager','designer','approver','general_manager','super_admin','reception','customer_service','nursing','head_nursing','sono_doctor','psychology_specialist','contract_manager','accountant','financial_manager') then raise exception 'اختر الدور الوظيفي'; end if;
    if p_role in('super_admin','general_manager','financial_manager') and not public.has_role('super_admin') then raise exception 'الأدوار الإدارية الحساسة يحددها السوبر أدمن'; end if;
    perform pg_advisory_xact_lock(hashtextextended('hr-account:'||em,0));
    if exists(select 1 from public.admins where lower(trim(email))=em) then raise exception 'البريد له حساب بالفعل؛ اختر ربط حساب موجود'; end if;
    if current_pid is not null and exists(select 1 from clinic_people.people where id=current_pid and admin_id is not null) then raise exception 'الملف مرتبط بحساب بالفعل'; end if;
    insert into public.admins(name,email,role,active) values(trim(p_payload->>'full_name'),em,p_role,true) returning id into aid;

  elsif p_mode='existing' then
    aid:=nullif(p_payload->>'admin_id','')::uuid;
    if aid is null or not exists(select 1 from public.admins where id=aid and active) then raise exception 'اختر حسابًا فعالًا'; end if;

    select * into linked from clinic_people.people where admin_id=aid for update;
    if found and linked.id is distinct from current_pid then
      if current_pid is null and linked.status='needs_setup' and linked.kind='unclassified' then
        work_payload:=work_payload||jsonb_build_object('id',linked.id,'revision',linked.revision);
        adopted:=true;
      else
        raise exception 'الحساب مرتبط بالفعل بملف %', linked.full_name;
      end if;
    end if;
  else
    aid:=null;
  end if;

  pid:=public.hr_command('person',work_payload||jsonb_build_object('admin_id',aid));
  if p_mode='new' then
    insert into public.hr_account_jobs(id,person_id,admin_id,created_by,email,name,role) values(p_request_id,pid,aid,me,em,trim(p_payload->>'full_name'),p_role);
  end if;
  return jsonb_build_object(
    'person_id',pid,
    'job_id',case when p_mode='new' then p_request_id end,
    'status',case when p_mode='new' then 'pending' else 'linked' end,
    'adopted_preliminary',adopted
  );
end
$function$

### END
### FUNC hr_set_manager_role(uuid,text)
CREATE OR REPLACE FUNCTION public.hr_set_manager_role(p_person uuid, p_role text)
 RETURNS jsonb
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare me uuid := public.my_admin_id(); p clinic_people.people%rowtype; role text := nullif(btrim(coalesce(p_role, '')), ''); h uuid;
begin
  if me is null or not clinic_people.manage() then raise exception 'تحتاج إدارة الموارد البشرية'; end if;
  select * into p from clinic_people.people where id = p_person for update;
  if not found then raise exception 'الموظف غير موجود'; end if;
  if p.admin_id is not null and role is not null then raise exception 'الموظف له حساب دخول؛ مهامه تُسند لحسابه مباشرة'; end if;
  if role is not null then
    if role !~ '^[a-z_]{3,40}$' then raise exception 'دور غير صالح'; end if;
    h := clinic_people.role_holder(role);
    if h is null then raise exception 'لا يوجد حساب نشط بهذا الدور الآن'; end if;
  end if;
  update clinic_people.people set manager_role = role, updated_at = now(), revision = revision + 1 where id = p.id;
  insert into clinic_people.audit(actor_id, action, record_id, before_data, after_data)
    values (me, 'manager_role', p.id, jsonb_build_object('manager_role', p.manager_role), jsonb_build_object('manager_role', role));
  perform public.task_sync_role_owners();
  return jsonb_build_object('person_id', p.id, 'manager_role', role, 'holder_id', h,
    'holder_name', (select coalesce(nullif(name, ''), email) from public.admins where id = h));
end $function$

### END
### FUNC hr_shift_swap_command(text,jsonb)
CREATE OR REPLACE FUNCTION public.hr_shift_swap_command(p_action text, p_payload jsonb)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare
  me uuid := public.my_admin_id(); hr boolean := clinic_people.manage();
  today date := (now() at time zone 'Africa/Cairo')::date;
  s clinic_people.shift_swaps%rowtype; v uuid := nullif(p_payload->>'id', '')::uuid; v_note text := btrim(coalesce(p_payload->>'note', ''));
  req clinic_people.people%rowtype; par clinic_people.people%rowtype; n integer; c uuid; first_start timestamptz;
begin
  if me is null then raise exception 'سجل الدخول'; end if;
  if jsonb_typeof(p_payload) <> 'object' then raise exception 'بيانات غير صالحة'; end if;
  perform pg_advisory_xact_lock(712261115);

  if p_action = 'request' then
    s.id := gen_random_uuid(); s.kind := p_payload->>'kind';
    if s.kind not in ('same_day', 'cross_day', 'cover', 'credit_use') then raise exception 'اختر نوع التبديل'; end if;
    select * into req from clinic_people.people where id = (p_payload->>'requester_id')::uuid and status <> 'ended' and kind <> 'doctor';
    if req.id is null then raise exception 'اختر موظفًا إداريًا مستمرًا'; end if;
    if s.kind <> 'credit_use' then
      select * into par from clinic_people.people where id = (p_payload->>'partner_id')::uuid and status <> 'ended' and kind <> 'doctor';
      if par.id is null then raise exception 'اختر زميلًا إداريًا مستمرًا'; end if;
      if lower(btrim(coalesce(req.department, ''))) is distinct from lower(btrim(coalesce(par.department, ''))) or btrim(coalesce(req.department, '')) = '' then
        raise exception 'التبديل بين موظفين من نفس القسم فقط'; end if;
    end if;
    if not hr and req.admin_id is distinct from me then raise exception 'تطلب التبديل لنفسك فقط؛ الموارد البشرية تطلبه نيابة عن غيرك'; end if;
    s.requester_id := req.id; s.partner_id := par.id;
    s.day_a := (p_payload->>'day_a')::date; s.day_b := nullif(p_payload->>'day_b', '')::date; s.note := left(v_note, 500);
    s.emergency := coalesce((p_payload->>'emergency')::boolean, false);
    if s.day_a is null then raise exception 'اختر اليوم'; end if;
    if s.kind <> 'cross_day' then s.day_b := null; elsif s.day_b is null or s.day_b = s.day_a then raise exception 'اختر يومين مختلفين'; end if;
    if least(s.day_a, coalesce(s.day_b, s.day_a)) < today - 31 then raise exception 'لا يمكن التبديل في يوم أقدم من 31 يومًا'; end if;
    perform 1 from clinic_people.swap_plan(s);
    first_start := clinic_people.swap_first_start(s);
    if first_start is not null and first_start < now() + interval '24 hours' then
      if not s.emergency then raise exception 'التبديل يُطلب قبل الوردية بـ24 ساعة على الأقل؛ الحالات الطارئة يسجلها مسؤول الموارد البشرية'; end if;
      if not hr then raise exception 'الطلب الطارئ يسجله مسؤول الموارد البشرية فقط'; end if;
    end if;
    if s.kind = 'credit_use' and clinic_people.credit_available(req.id, s.day_a) is null then raise exception 'لا يوجد يوم بديل صالح لهذا التاريخ'; end if;
    if clinic_people.swap_conflict(s) then raise exception 'يوجد تبديل آخر لنفس الشخص في نفس اليوم'; end if;
    insert into clinic_people.shift_swaps(id, kind, requester_id, partner_id, day_a, day_b, note, created_by, emergency, status)
      values (s.id, s.kind, s.requester_id, s.partner_id, s.day_a, s.day_b, s.note, me, s.emergency,
              case when s.kind = 'credit_use' then 'pending_manager' else 'pending_partner' end);
    v := s.id;
    if s.kind <> 'credit_use' then
      perform clinic_people.swap_notify(par.id, case when s.kind = 'cover' then 'طلب تغطية يوم من ' else 'طلب تبديل وردية من ' end || req.full_name
        || ' — يوم ' || s.day_a || coalesce(' و' || s.day_b, '') || '؛ وافق أو ارفض من «حضوري ووردياتي»');
    end if;
  else
    select * into s from clinic_people.shift_swaps where id = v for update;
    if not found then raise exception 'طلب التبديل غير موجود'; end if;
    select * into req from clinic_people.people where id = s.requester_id;
    select * into par from clinic_people.people where id = s.partner_id;

    if p_action = 'respond' then
      if s.status <> 'pending_partner' then raise exception 'الطلب ليس في انتظار موافقة الزميل'; end if;
      if par.admin_id is distinct from me and not (hr and me <> s.created_by) then raise exception 'الرد للزميل نفسه (أو الموارد البشرية نيابة عنه)'; end if;
      update clinic_people.shift_swaps set status = case when (p_payload->>'accept')::boolean then 'pending_manager' else 'declined' end,
        partner_by = me, partner_at = now(), partner_note = left(v_note, 500) where id = v;
      perform clinic_people.swap_notify(req.id, 'رد ' || par.full_name || ' على طلب التبديل: ' || case when (p_payload->>'accept')::boolean then 'موافق — في انتظار اعتماد الإدارة' else 'رفض' end);
    elsif p_action in ('approve', 'reject') then
      if not hr then raise exception 'الاعتماد للموارد البشرية'; end if;
      if s.status <> 'pending_manager' then raise exception 'الطلب ليس في انتظار الاعتماد'; end if;
      if me = s.created_by or me = s.partner_by then raise exception 'الاعتماد لمسؤول آخر غير مقدم الطلب ومن وافق عليه'; end if;
      if length(v_note) < 3 then raise exception 'اكتب سبب القرار'; end if;
      if p_action = 'approve' then
        if clinic_people.swap_conflict(s) then raise exception 'يوجد تبديل آخر معتمد لنفس الشخص في نفس اليوم'; end if;
        if s.kind = 'credit_use' then
          c := clinic_people.credit_available(s.requester_id, s.day_a);
          if c is null then raise exception 'لا يوجد يوم بديل صالح لهذا التاريخ'; end if;
          update clinic_people.shift_credits set used_swap_id = s.id where id = c;
        end if;
        insert into clinic_people.shift_overrides(person_id, day, template_id, swap_id) select x.person_id, x.day, x.template_id, s.id from clinic_people.swap_plan(s) x;
        if s.kind = 'cover' then
          insert into clinic_people.shift_credits(person_id, earned_swap_id, earned_day, expires_on) values (s.partner_id, s.id, s.day_a, s.day_a + 30);
          perform clinic_people.swap_notify(s.partner_id, 'لك يوم بديل عن تغطية يوم ' || s.day_a || ' — صالح حتى ' || (s.day_a + 30));
        end if;
      end if;
      update clinic_people.shift_swaps set status = case when p_action = 'approve' then 'approved' else 'rejected' end,
        decided_by = me, decided_at = now(), decision_note = v_note where id = v;
      perform clinic_people.swap_notify(req.id, 'طلب ' || case s.kind when 'credit_use' then 'اليوم البديل' when 'cover' then 'التغطية' else 'تبديل الوردية' end || ' ' || case when p_action = 'approve' then 'اعتُمد' else 'رُفض' end);
      if s.partner_id is not null then
        perform clinic_people.swap_notify(par.id, 'طلب التبديل مع ' || req.full_name || ' ' || case when p_action = 'approve' then 'اعتُمد' else 'رُفض' end);
      end if;
    elsif p_action = 'cancel' then
      if s.status not in ('pending_partner', 'pending_manager') then raise exception 'يمكن سحب الطلب قبل الاعتماد فقط'; end if;
      if me <> s.created_by and req.admin_id is distinct from me and not hr then raise exception 'السحب لمقدم الطلب أو الموارد البشرية'; end if;
      update clinic_people.shift_swaps set status = 'cancelled', decided_by = me, decided_at = now(), decision_note = left(coalesce(nullif(v_note, ''), 'سحب الطلب'), 500) where id = v;
    elsif p_action = 'reverse' then
      if not hr then raise exception 'إلغاء التبديل المعتمد للموارد البشرية'; end if;
      if s.status <> 'approved' then raise exception 'الطلب غير معتمد'; end if;
      if length(v_note) < 3 then raise exception 'اكتب سبب الإلغاء'; end if;
      if s.kind = 'cover' then
        if exists (select 1 from clinic_people.shift_credits where earned_swap_id = s.id and used_swap_id is not null) then
          raise exception 'اليوم البديل الناتج عن هذه التغطية استُخدم؛ ألغِ استخدامه أولًا'; end if;
        update clinic_people.shift_credits set voided = true where earned_swap_id = s.id;
      elsif s.kind = 'credit_use' then
        update clinic_people.shift_credits set used_swap_id = null where used_swap_id = s.id;
      end if;
      update clinic_people.shift_overrides set active = false where swap_id = v and active;
      get diagnostics n = row_count;
      update clinic_people.shift_swaps set status = 'reversed', reversed_by = me, reversed_at = now(), reverse_reason = left(v_note, 500) where id = v;
      perform clinic_people.swap_notify(req.id, 'أُلغي التبديل: ' || left(v_note, 200));
      if s.partner_id is not null then perform clinic_people.swap_notify(par.id, 'أُلغي التبديل: ' || left(v_note, 200)); end if;
    else raise exception 'إجراء غير متاح';
    end if;
  end if;
  insert into clinic_people.audit(actor_id, action, record_id, after_data)
    values (me, 'shift_swap_' || p_action, v, (select to_jsonb(x) from clinic_people.shift_swaps x where x.id = v));
  return v;
end $function$

### END
### FUNC hr_shift_swaps_list()
CREATE OR REPLACE FUNCTION public.hr_shift_swaps_list()
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare me uuid := public.my_admin_id(); hr boolean := clinic_people.manage(); mine uuid; today date := (now() at time zone 'Africa/Cairo')::date;
begin
  if me is null then raise exception 'سجل الدخول'; end if;
  select id into mine from clinic_people.people where admin_id = me;
  return jsonb_build_object('can_manage', hr, 'me', me, 'my_person_id', mine, 'today', today,
    'people', (select coalesce(jsonb_agg(jsonb_build_object('id', p.id, 'full_name', p.full_name, 'code', p.code, 'department', p.department) order by p.full_name), '[]'::jsonb)
       from clinic_people.people p where p.status <> 'ended' and p.kind <> 'doctor' and exists (select 1 from clinic_people.person_shifts s where s.person_id = p.id)),
    'swaps', (select coalesce(jsonb_agg(to_jsonb(x) || jsonb_build_object(
        'requester_name', r.full_name, 'partner_name', q.full_name, 'partner_admin', q.admin_id, 'requester_admin', r.admin_id,
        'plan', (select coalesce(jsonb_agg(jsonb_build_object('person_id', o.person_id, 'day', o.day, 'off', o.template_id is null,
                   'shift', (select t.name || ' ' || to_char(t.start_time, 'HH24:MI') || '–' || to_char(t.end_time, 'HH24:MI') from clinic_people.shift_templates t where t.id = o.template_id))
                   order by o.day), '[]'::jsonb) from clinic_people.shift_overrides o where o.swap_id = x.id))
        order by x.created_at desc), '[]'::jsonb)
       from clinic_people.shift_swaps x join clinic_people.people r on r.id = x.requester_id left join clinic_people.people q on q.id = x.partner_id
       where hr or r.admin_id = me or q.admin_id = me),
    'credits', (select coalesce(jsonb_agg(jsonb_build_object('id', c.id, 'person_id', c.person_id, 'full_name', p.full_name, 'earned_day', c.earned_day,
        'expires_on', c.expires_on, 'state', case when c.voided then 'voided' when c.used_swap_id is not null then 'used' when c.expires_on < today then 'expired' else 'available' end)
        order by c.expires_on), '[]'::jsonb)
       from clinic_people.shift_credits c join clinic_people.people p on p.id = c.person_id where hr or p.admin_id = me));
end $function$

### END
### FUNC hr_shifts_command(text,jsonb)
CREATE OR REPLACE FUNCTION public.hr_shifts_command(p_action text, p_payload jsonb)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare me uuid := public.my_admin_id(); tid uuid; pid uuid; today date := (now() at time zone 'Africa/Cairo')::date; from_d date; k text; v text; nm text; st time; en time; gr integer; colr text;
begin
  if me is null then raise exception 'سجل الدخول'; end if;
  if not clinic_people.manage() then raise exception 'تحتاج إدارة الموارد البشرية'; end if;
  if jsonb_typeof(p_payload) <> 'object' then raise exception 'بيانات غير صالحة'; end if;
  perform pg_advisory_xact_lock(712261113);
  if p_action = 'template_save' then
    nm := trim(coalesce(p_payload->>'name', ''));
    if length(nm) < 2 or length(nm) > 40 then raise exception 'اكتب اسم الوردية (2 إلى 40 حرفًا)'; end if;
    begin st := (p_payload->>'start_time')::time; en := (p_payload->>'end_time')::time; exception when others then raise exception 'راجع وقت البداية والنهاية'; end;
    if st is null or en is null or st = en then raise exception 'وقت البداية والنهاية لازم يختلفوا'; end if;
    gr := coalesce(nullif(p_payload->>'grace_minutes', '')::integer, 10);
    if gr < 0 or gr > 120 then raise exception 'السماح من 0 إلى 120 دقيقة'; end if;
    colr := coalesce(nullif(p_payload->>'color', ''), '#0F369D');
    if colr !~ '^#[0-9A-Fa-f]{6}$' then raise exception 'لون غير صالح'; end if;
    tid := nullif(p_payload->>'id', '')::uuid;
    if tid is null then
      insert into clinic_people.shift_templates(name, start_time, end_time, grace_minutes, color, created_by) values (nm, st, en, gr, colr, me) returning id into tid;
    else
      update clinic_people.shift_templates set name = nm, start_time = st, end_time = en, grace_minutes = gr, color = colr,
        active = coalesce((p_payload->>'active')::boolean, active) where id = tid;
      if not found then raise exception 'الوردية غير موجودة'; end if;
    end if;
    insert into clinic_people.audit(actor_id, action, record_id, after_data) values (me, 'shift_template', tid, p_payload);
    return tid;
  elsif p_action = 'schedule_save' then
    pid := (p_payload->>'person_id')::uuid;
    if not exists (select 1 from clinic_people.people where id = pid and status <> 'ended' and kind <> 'doctor') then raise exception 'اختر موظفًا إداريًا مستمرًا'; end if;
    from_d := coalesce(nullif(p_payload->>'valid_from', '')::date, today);
    if from_d < today - 31 then raise exception 'لا يمكن تعديل جدول أقدم من 31 يومًا'; end if;
    if jsonb_typeof(p_payload->'days') <> 'object' then raise exception 'راجع أيام الأسبوع'; end if;
    for k in select g::text from generate_series(0, 6) g loop
      if not (p_payload->'days' ? k) then raise exception 'يجب تحديد كل أيام الأسبوع (الراحة = فارغ)'; end if;
      v := nullif(p_payload->'days'->>k, '');
      if v is not null and not exists (select 1 from clinic_people.shift_templates where id = v::uuid and active) then raise exception 'وردية غير موجودة أو متوقفة'; end if;
    end loop;
    update clinic_people.person_shifts set valid_to = from_d - 1 where person_id = pid and valid_from < from_d and (valid_to is null or valid_to >= from_d);
    delete from clinic_people.person_shifts where person_id = pid and valid_from >= from_d;
    for k in select g::text from generate_series(0, 6) g loop
      insert into clinic_people.person_shifts(person_id, dow, template_id, valid_from, created_by) values (pid, k::smallint, nullif(p_payload->'days'->>k, '')::uuid, from_d, me);
    end loop;
    insert into clinic_people.audit(actor_id, action, record_id, after_data) values (me, 'shift_schedule', pid, p_payload);
    return pid;
  else raise exception 'إجراء غير متاح';
  end if;
end $function$

### END
### FUNC hr_shifts_workspace()
CREATE OR REPLACE FUNCTION public.hr_shifts_workspace()
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
begin
  if public.my_admin_id() is null then raise exception 'سجل الدخول'; end if;
  if not clinic_people.manage() then raise exception 'تحتاج إدارة الموارد البشرية'; end if;
  return jsonb_build_object(
    'can_manage', true,
    'today', (now() at time zone 'Africa/Cairo')::date,
    'templates', (select coalesce(jsonb_agg(jsonb_build_object('id', t.id, 'name', t.name, 'start_time', to_char(t.start_time, 'HH24:MI'), 'end_time', to_char(t.end_time, 'HH24:MI'),
        'grace_minutes', t.grace_minutes, 'color', t.color, 'active', t.active, 'overnight', t.end_time <= t.start_time) order by t.start_time, t.name), '[]'::jsonb) from clinic_people.shift_templates t),
    'people', (select coalesce(jsonb_agg(jsonb_build_object('id', p.id, 'code', p.code, 'full_name', p.full_name, 'department', p.department, 'job_title', p.job_title,
        'since', cur.since, 'days', coalesce(cur.days, '{}'::jsonb)) order by p.department nulls last, p.full_name), '[]'::jsonb)
      from clinic_people.people p
      left join lateral (
        select max(x.valid_from) as since, jsonb_object_agg(x.dow::text, x.template_id) as days
        from (select distinct on (ps.dow) ps.dow, ps.template_id, ps.valid_from from clinic_people.person_shifts ps
              where ps.person_id = p.id and ps.valid_from <= (now() at time zone 'Africa/Cairo')::date and (ps.valid_to is null or ps.valid_to >= (now() at time zone 'Africa/Cairo')::date)
              order by ps.dow, ps.valid_from desc, ps.id desc) x) cur on true
      where p.status <> 'ended' and p.kind <> 'doctor'));
end $function$

### END
### FUNC hr_tax_amount(uuid,date,text)
CREATE OR REPLACE FUNCTION public.hr_tax_amount(p_person uuid, p_month date, p_tax_type text DEFAULT 'salary_income'::text)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare m date := date_trunc('month', p_month)::date; e clinic_people.tax_entries%rowtype;
begin
  if public.my_admin_id() is null then raise exception 'سجل الدخول'; end if;
  if not (clinic_people.manage() or clinic_finance.allowed('create') or clinic_finance.allowed('review')) then raise exception 'ليس لديك صلاحية لهذه العملية' using errcode = '42501'; end if;
  select * into e from clinic_people.tax_entries where person_id = p_person and month = m and tax_type = p_tax_type;
  return jsonb_build_object('person_id', p_person, 'month', m, 'tax_type', p_tax_type, 'found', found, 'tax', coalesce(e.amount, 0), 'reference', coalesce(e.reference, ''));
end $function$

### END
### FUNC hr_tax_command(text,jsonb)
CREATE OR REPLACE FUNCTION public.hr_tax_command(p_action text, p_payload jsonb)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare
  me uuid := public.my_admin_id();
  cur date := date_trunc('month', (now() at time zone 'Africa/Cairo')::date)::date;
  e clinic_people.tax_entries%rowtype; p clinic_people.people%rowtype;
  v uuid := nullif(p_payload->>'id', '')::uuid; rid uuid := nullif(p_payload->>'request_id', '')::uuid; pid uuid := nullif(p_payload->>'person_id', '')::uuid;
  t text := coalesce(nullif(p_payload->>'tax_type', ''), 'salary_income'); m date; amt numeric; base numeric; prior jsonb; afterj jsonb;
begin
  if me is null then raise exception 'سجل الدخول'; end if;
  if not clinic_people.manage() then raise exception 'سجل الضريبة لإدارة الموارد البشرية'; end if;
  if p_action not in ('create', 'update') then raise exception 'إجراء غير متاح'; end if;
  if not exists(select 1 from clinic_finance.tax_types where code = t and active) then raise exception 'نوع الضريبة غير متاح'; end if;
  amt := coalesce(nullif(p_payload->>'amount', '')::numeric, -1);
  if amt < 0 or amt >= 100000000 or amt::text in ('NaN', 'Infinity') or amt <> round(amt, 2) then raise exception 'راجع مبلغ الضريبة المستقطعة'; end if;
  base := nullif(p_payload->>'taxable_base', '')::numeric;
  if base is not null and (base < 0 or base >= 100000000 or base <> round(base, 2)) then raise exception 'راجع الوعاء الخاضع'; end if;

  if p_action = 'create' then
    if rid is not null then select id into v from clinic_people.tax_entries where request_id = rid; if found then return v; end if; end if;
    select * into p from clinic_people.people where id = pid;
    if not found or p.status = 'ended' then raise exception 'اختر موظفًا مستمرًا في العمل'; end if;
    m := date_trunc('month', nullif(p_payload->>'month', '')::date)::date;
    if m is null or m > cur then raise exception 'اختر شهرًا لم يتجاوز الشهر الحالي'; end if;
    if exists(select 1 from clinic_people.tax_entries where person_id = pid and month = m and tax_type = t) then raise exception 'مسجل لهذا الموظف في هذا الشهر؛ عدّل السجل الموجود'; end if;
    if p.finance_subject is not null and exists(select 1 from clinic_finance.business_requests b where b.kind = 'payroll' and b.subject = p.finance_subject and b.payload->>'month' = m::text and b.status in ('pending', 'approved')) then
      raise exception 'يوجد استحقاق مرتب لهذا الشهر؛ الضريبة تُدخل قبل إرسال المرتب أو تُصحَّح بقيد تصحيح';
    end if;
    insert into clinic_people.tax_entries(request_id, person_id, month, tax_type, amount, taxable_base, reference, note, created_by)
      values (rid, pid, m, t, amt, base, trim(coalesce(p_payload->>'reference', '')), trim(coalesce(p_payload->>'note', '')), me) returning id, to_jsonb(tax_entries.*) into v, afterj;
    insert into clinic_people.audit(actor_id, action, record_id, before_data, after_data) values (me, 'tax_create', v, null, afterj);
    return v;
  end if;

  select * into e from clinic_people.tax_entries where id = v for update;
  if not found then raise exception 'السجل غير موجود'; end if;
  if e.revision <> coalesce((p_payload->>'revision')::int, 0) then raise exception 'السجل تغير؛ أعد تحميله قبل الحفظ'; end if;
  if amt is distinct from e.amount and length(trim(coalesce(p_payload->>'reason', ''))) < 3 then raise exception 'اكتب سبب تغيير المبلغ'; end if;
  select * into p from clinic_people.people where id = e.person_id;
  if p.finance_subject is not null and exists(select 1 from clinic_finance.business_requests b where b.kind = 'payroll' and b.subject = p.finance_subject and b.payload->>'month' = e.month::text and b.status in ('pending', 'approved')) then
    raise exception 'يوجد استحقاق مرتب لهذا الشهر؛ لا يُعدَّل المبلغ بعد إرسال المرتب';
  end if;
  prior := to_jsonb(e);
  update clinic_people.tax_entries set amount = amt, taxable_base = base, reference = trim(coalesce(p_payload->>'reference', reference)), note = trim(coalesce(p_payload->>'note', note)), revision = revision + 1, updated_at = now() where id = v;
  select to_jsonb(x) into afterj from clinic_people.tax_entries x where id = v;
  insert into clinic_people.audit(actor_id, action, record_id, before_data, after_data) values (me, 'tax_update', v, prior, afterj);
  return v;
end $function$

### END
### FUNC hr_tax_workspace(date)
CREATE OR REPLACE FUNCTION public.hr_tax_workspace(p_month date)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare me uuid := public.my_admin_id(); allv boolean := clinic_people.insurance_view_all(); mine uuid; m date := date_trunc('month', coalesce(p_month, (now() at time zone 'Africa/Cairo')::date))::date;
begin
  if me is null then raise exception 'سجل الدخول'; end if;
  select id into mine from clinic_people.people where admin_id = me;
  return jsonb_build_object('can_manage', clinic_people.manage(), 'can_view_all', allv, 'today', (now() at time zone 'Africa/Cairo')::date, 'month', m,
    'tax_types', (select coalesce(jsonb_agg(jsonb_build_object('code', code, 'name', name) order by code), '[]'::jsonb) from clinic_finance.tax_types where active),
    'items', (select coalesce(jsonb_agg(to_jsonb(t) - 'request_id' || jsonb_build_object('full_name', p.full_name, 'code', p.code) order by p.full_name), '[]'::jsonb)
      from clinic_people.tax_entries t join clinic_people.people p on p.id = t.person_id where t.month = m and (allv or (mine is not null and t.person_id = mine))),
    'people', case when clinic_people.manage() then (select coalesce(jsonb_agg(jsonb_build_object('id', p.id, 'code', p.code, 'full_name', p.full_name) order by p.full_name), '[]'::jsonb) from clinic_people.people p where p.status <> 'ended') else '[]'::jsonb end);
end $function$

### END
### FUNC hr_workspace(date)
CREATE OR REPLACE FUNCTION public.hr_workspace(p_month date DEFAULT CURRENT_DATE)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare me uuid:=public.my_admin_id();m boolean:=clinic_people.manage();dt date:=date_trunc('month',p_month)::date;begin
 if me is null then raise exception 'سجل الدخول';end if;
 return jsonb_build_object('can_manage',m,'month',dt,'owner_level',clinic_people.is_owner_level(),
 'people',(select coalesce(jsonb_agg(to_jsonb(p)||jsonb_build_object('leave_balance',coalesce((select sum(case when r.kind='leave_credit' then r.units when r.kind='leave' and r.leave_type<>'excused' then -r.units else 0 end) from clinic_people.requests r where r.person_id=p.id and r.status='approved' and r.from_date>=date_trunc('year',p_month)::date and r.from_date<(date_trunc('year',p_month)+interval '1 year')::date),0)+clinic_people.leave_allowance(extract(year from p_month)::int) /* unpaid leave balance 20261117020000 */) order by p.full_name),'[]') from clinic_people.people p where m or p.admin_id=me),
 'documents',(select coalesce(jsonb_agg(d order by d.expires_on nulls last),'[]') from clinic_people.documents d where clinic_people.visible(d.person_id)),
 'requests',(select coalesce(jsonb_agg(to_jsonb(r)||jsonb_build_object('rule_break_labels',clinic_people.leave_break_labels(r.rule_breaks),'certificate_due',case when r.leave_type='sick' then r.created_at+interval '48 hours' end) order by r.created_at desc),'[]') from clinic_people.requests r where clinic_people.visible(r.person_id) and (r.status='pending' or r.from_date between dt and (dt+interval '1 month' - interval '1 day')::date)),
 'attendance',(select coalesce(jsonb_agg(a order by a.day desc),'[]') from clinic_people.attendance a where clinic_people.visible(a.person_id) and a.day between dt and (dt+interval '1 month' - interval '1 day')::date),
 'accounts',case when m then (select coalesce(jsonb_agg(jsonb_build_object('id',id,'name',coalesce(nullif(name,''),email)) order by name),'[]') from public.admins) else '[]'::jsonb end,
 'doctor_keys',case when m then (select coalesce(jsonb_agg(x),'[]') from(select doctor_key,max(doctor_name) name from clinic_finance.doctor_contracts group by doctor_key)x) else '[]'::jsonb end,
 'employee_keys',case when m then(select coalesce(jsonb_agg(x),'[]') from(select distinct subject,payload->>'employee_name' name from clinic_finance.business_requests where kind='employment' and status='approved')x) else '[]'::jsonb end);
end $function$

### END
### FUNC insurance_open_shifts()
CREATE OR REPLACE FUNCTION public.insurance_open_shifts()
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare me uuid:=clinic_finance.require_access('view');begin
 return (select coalesce(jsonb_agg(jsonb_build_object('id',s.id,'name',r.name,'opened_at',s.opened_at,'is_main',s.is_main) order by s.opened_at desc),'[]'::jsonb) from clinic_finance.shifts s join clinic_finance.registers r on r.id=s.register_id where s.status='open' and (s.cashier_id=me or clinic_finance.allowed('review')));
end $function$

### END
### FUNC report_attendance_summary(date,date,uuid)
CREATE OR REPLACE FUNCTION public.report_attendance_summary(p_from date, p_to date, p_branch uuid DEFAULT NULL::uuid)
 RETURNS jsonb
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare v jsonb; today date := (now() at time zone 'Africa/Cairo')::date;
begin
  perform public.report_require('attendance_summary');
  perform public.report_check_period(p_from, p_to);
  with a as (
    select p.id person_id, p.full_name, p.department, at.day, at.status, at.scheduled_start, at.scheduled_end, at.actual_start, at.actual_end
      from clinic_people.attendance at join clinic_people.people p on p.id = at.person_id
     where at.day between p_from and p_to and at.status <> 'rejected'),
  g as (
    select person_id, full_name, department, count(*) scheduled_days,
           count(*) filter (where actual_start is not null) attended_days,
           count(*) filter (where actual_start is null and day < today) absent_days,
           count(*) filter (where actual_start > scheduled_start + interval '5 minutes') late_days,
           round(coalesce(sum(extract(epoch from actual_start - scheduled_start) / 60) filter (where actual_start > scheduled_start + interval '5 minutes'), 0)) late_minutes,
           round(coalesce(sum(extract(epoch from scheduled_end - actual_end) / 60) filter (where actual_end < scheduled_end - interval '5 minutes'), 0)) early_minutes
      from a group by person_id, full_name, department),
  ot as (select person_id, sum(minutes) minutes from clinic_people.overtime_requests where status = 'approved' and day between p_from and p_to group by person_id),
  ded as (select person_id, sum(amount) amount from clinic_people.pay_adjustments
           where kind = 'deduction' and month between date_trunc('month', p_from)::date and p_to group by person_id),
  r as (select g.*, coalesce(ot.minutes, 0) overtime_minutes, coalesce(ded.amount, 0) deductions
          from g left join ot on ot.person_id = g.person_id left join ded on ded.person_id = g.person_id)
  select jsonb_build_object('scope', 'company',
    'rows', coalesce((select jsonb_agg(to_jsonb(r) - 'person_id' order by absent_days desc, late_minutes desc, full_name) from r), '[]'::jsonb),
    'totals', (select jsonb_build_object('people', count(*), 'scheduled_days', coalesce(sum(scheduled_days), 0), 'attended_days', coalesce(sum(attended_days), 0),
              'absent_days', coalesce(sum(absent_days), 0), 'late_days', coalesce(sum(late_days), 0), 'late_minutes', coalesce(sum(late_minutes), 0),
              'early_minutes', coalesce(sum(early_minutes), 0), 'overtime_minutes', coalesce(sum(overtime_minutes), 0), 'deductions', coalesce(sum(deductions), 0)) from r))
    into v;
  return v;
end $function$

### END
### FUNC shift_expense_receipt_review_allowed()
CREATE OR REPLACE FUNCTION public.shift_expense_receipt_review_allowed()
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$ select coalesce(clinic_finance.allowed('review'), false) $function$

