BEGIN
Output format is unaligned.
Field separator is "	".
### FUNC clinic_people.attendance_eval(date,timestamp with time zone)
CREATE OR REPLACE FUNCTION clinic_people.attendance_eval(p_day date, p_now timestamp with time zone DEFAULT now())
 RETURNS TABLE(person_id uuid, template_id uuid, template_name text, color text, grace integer, exp_start timestamp with time zone, exp_end timestamp with time zone, device_user_id integer, first_in timestamp with time zone, status text, late_min integer, since_start integer, excused boolean)
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
  select e.person_id, e.template_id, e.template_name, e.color, e.grace, e.exp_start, e.exp_end, e.device_user_id, e.first_in,
    case when h.closed and e.status not in ('unmapped') then 'leave' else e.status end,
    case when h.closed then 0 else e.late_min end,
    e.since_start,
    case when h.closed then true else e.excused end
  from clinic_people.attendance_eval_before_closures(p_day, p_now) e cross join (select clinic_people.center_closed_on(p_day) as closed) h
$function$

### END
### FUNC clinic_people.attendance_eval_before_closures(date,timestamp with time zone)
CREATE OR REPLACE FUNCTION clinic_people.attendance_eval_before_closures(p_day date, p_now timestamp with time zone DEFAULT now())
 RETURNS TABLE(person_id uuid, template_id uuid, template_name text, color text, grace integer, exp_start timestamp with time zone, exp_end timestamp with time zone, device_user_id integer, first_in timestamp with time zone, status text, late_min integer, since_start integer, excused boolean)
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
  with wk as (
    select distinct on (ps.person_id) ps.person_id, ps.template_id
    from clinic_people.person_shifts ps
    join clinic_people.people p on p.id = ps.person_id and p.status <> 'ended' and p.kind <> 'doctor'
    where ps.dow = extract(dow from p_day)::int and ps.valid_from <= p_day and (ps.valid_to is null or ps.valid_to >= p_day)
    order by ps.person_id, ps.valid_from desc, ps.id desc),
  ov as (
    select o.person_id, o.template_id
    from clinic_people.shift_overrides o
    join clinic_people.people p on p.id = o.person_id and p.status <> 'ended' and p.kind <> 'doctor'
    where o.day = p_day and o.active),
  pat as (
    select coalesce(ov.person_id, wk.person_id) as person_id,
      (ov.person_id is not null and ov.template_id is null) as swap_off,
      case when ov.person_id is null then wk.template_id
           when ov.template_id is null then wk.template_id      -- off by swap: keep his usual times for display
           else ov.template_id end as template_id
    from wk full join ov on ov.person_id = wk.person_id),
  sched as (
    select pat.person_id, pat.swap_off, t.id as template_id,
      case when pat.swap_off then 'إجازة بتبديل' else t.name end as template_name, t.color, t.grace_minutes as grace,
      ((p_day + t.start_time) at time zone 'Africa/Cairo') as exp_start,
      ((p_day + t.end_time + case when t.end_time <= t.start_time then interval '1 day' else interval '0' end) at time zone 'Africa/Cairo') as exp_end
    from pat join clinic_people.shift_templates t on t.id = pat.template_id),
  joined as (
    select s.*, m.device_user_id,
      (select min(d.ts) from clinic_people.device_punches d
        where d.device_id = m.device_id and d.device_user_id = m.device_user_id and d.punch in (0, 3, 4)
          and d.ts between s.exp_start - interval '3 hours' and s.exp_end) as first_in
    from sched s left join clinic_people.device_user_map m on m.person_id = s.person_id),
  lv as (
    select r.person_id, bool_or(r.kind = 'leave') as leave, bool_or(r.kind = 'permission') as perm
    from clinic_people.requests r
    where r.status = 'approved' and r.kind in ('leave', 'permission') and p_day between r.from_date and r.to_date
    group by r.person_id)
  select j.person_id, j.template_id, j.template_name, j.color, j.grace, j.exp_start, j.exp_end, j.device_user_id, j.first_in,
    case
      when j.swap_off then 'leave'
      when coalesce(lv.leave, false) then 'leave'
      when j.device_user_id is null then 'unmapped'
      when j.first_in is not null then case when j.first_in > j.exp_start + make_interval(mins => j.grace) then 'late' else 'on_time' end
      when p_now < j.exp_start then 'upcoming'
      when p_now <= j.exp_start + make_interval(mins => j.grace) then 'waiting'
      else 'absent' end,
    case when not j.swap_off and j.first_in is not null and j.first_in > j.exp_start then floor(extract(epoch from (j.first_in - j.exp_start)) / 60)::integer else 0 end,
    case when p_now > j.exp_start then floor(extract(epoch from (p_now - j.exp_start)) / 60)::integer else null end,
    coalesce(lv.perm, false)
  from joined j left join lv on lv.person_id = j.person_id
$function$

### END
### FUNC clinic_people.casual_days(uuid,date,date)
CREATE OR REPLACE FUNCTION clinic_people.casual_days(p_person uuid, p_from date, p_to date)
 RETURNS integer
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
  select count(*)::integer
  from clinic_people.requests r, generate_series(r.from_date, r.to_date, interval '1 day') g(d)
  where r.person_id = p_person and r.kind = 'leave' and r.leave_type = 'casual' and r.status in ('pending', 'approved')
    and g.d::date between p_from and p_to
$function$

### END
### FUNC clinic_people.center_closed_on(date)
CREATE OR REPLACE FUNCTION clinic_people.center_closed_on(p_day date)
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
  select exists(select 1 from clinic_people.center_closures c where c.status = 'approved' and p_day between c.from_date and c.to_date)
$function$

### END
### FUNC clinic_people.clinic_close_at(date)
CREATE OR REPLACE FUNCTION clinic_people.clinic_close_at(p_day date)
 RETURNS timestamp with time zone
 LANGUAGE plpgsql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare v timestamptz;
begin
  if to_regclass('clinic_reception.appointments') is null then return null; end if;
  execute 'select max(a.ends_at) from clinic_reception.appointments a join clinic_reception.workspaces w on w.id = a.workspace_id
            where w.mode = ''live'' and a.status not in (''cancelled'',''no_show'') and (a.starts_at at time zone ''Africa/Cairo'')::date = $1' into v using p_day;
  return v;
end $function$

### END
### FUNC clinic_people.closure_reviewer()
CREATE OR REPLACE FUNCTION clinic_people.closure_reviewer()
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
  select public.my_admin_id() is not null and (public.has_role('super_admin') or public.has_role('general_manager'))
$function$

### END
### FUNC clinic_people.credit_available(uuid,date)
CREATE OR REPLACE FUNCTION clinic_people.credit_available(p_person uuid, p_day date)
 RETURNS uuid
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
  select c.id from clinic_people.shift_credits c
   where c.person_id = p_person and not c.voided and c.used_swap_id is null and c.expires_on >= p_day and c.earned_day <= p_day
     and c.expires_on >= (now() at time zone 'Africa/Cairo')::date
   order by c.expires_on, c.created_at limit 1
$function$

### END
### FUNC clinic_people.custody_view_all()
CREATE OR REPLACE FUNCTION clinic_people.custody_view_all()
 RETURNS boolean
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
  select public.my_admin_id() is not null and (clinic_people.manage() or public.has_role('accountant') or public.has_role('financial_manager'))
$function$

### END
### FUNC clinic_people.day_wage(uuid,date)
CREATE OR REPLACE FUNCTION clinic_people.day_wage(p_person uuid, p_day date)
 RETURNS numeric
 LANGUAGE sql
 STABLE SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
  select coalesce((select b.amount / 30 from clinic_finance.business_requests b join clinic_people.people p on p.finance_subject = b.subject
                    where p.id = p_person and b.kind = 'employment' and b.status = 'approved'
                      and p_day between (b.payload->>'from')::date and (b.payload->>'to')::date
                    order by b.created_at desc limit 1), 0)
$function$

### END
### FUNC clinic_people.finance_business_v1(text,jsonb,uuid)
CREATE OR REPLACE FUNCTION clinic_people.finance_business_v1(p_action text, p_payload jsonb, p_token uuid)
 RETURNS uuid
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare me uuid:=clinic_finance.require_access('create');r clinic_finance.business_requests%rowtype;c clinic_finance.business_requests%rowtype;v uuid;k text:=p_payload->>'kind';sub text:=trim(p_payload->>'subject');a numeric;ded numeric;val numeric;used numeric;debit text;credit text;sh uuid;mon date;months integer;j text;
begin perform clinic_finance.lock_day();
if p_action='request' then
 select * into r from clinic_finance.business_requests where created_by=me and token=p_token;if found then if r.payload<>p_payload then raise exception 'مفتاح الطلب مستخدم لبيانات أخرى';end if;return r.id;end if;
 if coalesce(length(trim(p_payload->>'reference')),0)<2 or coalesce(length(trim(p_payload->>'note')),0)<3 or coalesce(length(sub),0)<2 then raise exception 'المعرف والمرجع وشرح المستند مطلوبة';end if;
 foreach j in array array['amount','base','allowance','tax','insurance','recovery','residual'] loop if p_payload ? j and (p_payload->>j is null or (p_payload->>j)::numeric<0 or (p_payload->>j)::numeric<>round((p_payload->>j)::numeric,2) or p_payload->>j in ('NaN','Infinity','-Infinity')) then raise exception 'مبلغ غير صالح: %',j;end if;end loop;
 a:=coalesce((p_payload->>'amount')::numeric,0);
 if k='employment' then if nullif(p_payload->>'base','') is null or nullif(p_payload->>'from','') is null or nullif(p_payload->>'to','') is null or (p_payload->>'base')::numeric<=0 or nullif(p_payload->>'employee_name','') is null or (p_payload->>'to')::date<(p_payload->>'from')::date then raise exception 'بيانات عقد الموظف غير صالحة';end if;a:=(p_payload->>'base')::numeric;
 elsif k='payroll' then select * into c from clinic_finance.business_requests where id=(p_payload->>'contract_id')::uuid and kind='employment' and status='approved' and subject=sub;if not found then raise exception 'اختر عقد موظف معتمد';end if;mon:=(p_payload->>'month')::date;if mon is null or mon<>date_trunc('month',mon)::date or mon>date_trunc('month',now())::date or mon<date_trunc('month',(c.payload->>'from')::date)::date or mon>date_trunc('month',(c.payload->>'to')::date)::date then raise exception 'شهر المرتب خارج العقد أو في المستقبل';end if;
 a:=c.amount+coalesce((p_payload->>'allowance')::numeric,0);ded:=coalesce((p_payload->>'tax')::numeric,0)+coalesce((p_payload->>'insurance')::numeric,0)+coalesce((p_payload->>'recovery')::numeric,0);if ded>a then raise exception 'الاستقطاعات تتجاوز الإجمالي';end if;
 elsif k='asset' then if p_payload->>'residual' is null or p_payload->>'months' is null or a<=0 or (p_payload->>'residual')::numeric>=a or (p_payload->>'months')::integer not between 1 and 1200 or (p_payload->>'start')::date is null then raise exception 'تكلفة الأصل وعمره وقيمته المتبقية غير صالحة';end if;
 elsif k='depreciation' then select * into c from clinic_finance.business_requests where id=(p_payload->>'asset_id')::uuid and kind='asset' and status='approved';if not found then raise exception 'الأصل غير معتمد';end if;sub:=c.subject;mon:=(p_payload->>'month')::date;select count(*),coalesce(sum(amount),0) into months,used from clinic_finance.business_requests where kind='depreciation' and status='approved' and payload->>'asset_id'=c.id::text;months:=months+coalesce((c.payload->>'opening_elapsed')::integer,0);used:=used+coalesce((c.payload->>'opening_accumulated')::numeric,0);
 if mon is null or mon<>date_trunc('month',mon)::date or mon>date_trunc('month',now())::date or mon<>(date_trunc('month',(c.payload->>'start')::date)+make_interval(months=>months))::date then raise exception 'يجب الإهلاك شهرًا بشهر بدءًا من شهر التشغيل';end if;
 a:=least(case when months=(c.payload->>'months')::integer-1 then c.amount-(c.payload->>'residual')::numeric-used else round((c.amount-(c.payload->>'residual')::numeric)/(c.payload->>'months')::integer,2) end,c.amount-(c.payload->>'residual')::numeric-used);if a<=0 or months>=(c.payload->>'months')::integer then raise exception 'الأصل وصل حد الإهلاك';end if;
 elsif k in ('salary_payment','advance','tax','tax_payment','statutory_payment') then if a<=0 then raise exception 'المبلغ يجب أن يكون موجبًا';end if;
 else raise exception 'نوع الطلب غير معروف';end if;
 if k='advance' and not exists(select 1 from clinic_finance.business_requests where kind='employment' and status='approved' and subject=sub) then raise exception 'لا يوجد عقد معتمد لمعرف الموظف';end if;
 if k in ('salary_payment','advance','asset','tax_payment','statutory_payment') then if p_payload->>'method' not in ('cash','bank','instapay') or p_payload->>'method' is null then raise exception 'اختر قناة الصرف';end if;if p_payload->>'method'='cash' then perform clinic_finance.check_shift((p_payload->>'shift_id')::uuid);perform clinic_finance.register_direction((p_payload->>'shift_id')::uuid,'pay');end if;end if;
 if k='tax' and coalesce(p_payload->>'direction','') not in ('payable','recoverable') then raise exception 'حدد ضريبة مستحقة أو قابلة للاسترداد حسب المستند';end if;
 insert into clinic_finance.business_requests(kind,subject,reference,amount,payload,created_by,token) values(k,sub,trim(p_payload->>'reference'),a,p_payload,me,p_token) returning id into v;
elsif p_action='review' then
 perform clinic_finance.require_access('review');select * into r from clinic_finance.business_requests where id=(p_payload->>'id')::uuid for update;if not found or r.status<>'pending' or r.created_by=me or length(trim(p_payload->>'note'))<3 then raise exception 'يلزم طلب معلق ومراجع آخر وسبب القرار';end if;v:=r.id;k:=r.kind;a:=r.amount;sub:=r.subject;
 if (p_payload->>'approve')::boolean then
 if k='employment' then if exists(select 1 from clinic_finance.business_requests x where kind='employment' and status='approved' and subject=sub and daterange((x.payload->>'from')::date,(x.payload->>'to')::date,'[]')&&daterange((r.payload->>'from')::date,(r.payload->>'to')::date,'[]')) then raise exception 'يوجد عقد موظف متداخل';end if;
 elsif k='payroll' then
 val:=coalesce((r.payload->>'recovery')::numeric,0);if val>clinic_finance.employee_advance(sub) then raise exception 'استرداد السلفة يتجاوز رصيد الموظف';end if;
 perform clinic_finance.post('payroll_gross',v,'استحقاق مرتب '||sub||' '||(r.payload->>'month'),null,'5211','2131',a);
 foreach j in array array['tax','insurance','recovery'] loop val:=coalesce((r.payload->>j)::numeric,0);if val>0 then perform clinic_finance.post('payroll_'||j,v,'استقطاع موثق من المرتب '||sub,null,'2131',case j when 'tax' then '2142' when 'insurance' then '2143' else '1142' end,val);end if;end loop;
 elsif k='depreciation' then
 select * into c from clinic_finance.business_requests where id=(r.payload->>'asset_id')::uuid;select count(*),coalesce(sum(amount),0) into months,used from clinic_finance.business_requests where kind='depreciation' and status='approved' and payload->>'asset_id'=c.id::text;months:=months+coalesce((c.payload->>'opening_elapsed')::integer,0);used:=used+coalesce((c.payload->>'opening_accumulated')::numeric,0);
 if (r.payload->>'month')::date<>(date_trunc('month',(c.payload->>'start')::date)+make_interval(months=>months))::date or a>c.amount-(c.payload->>'residual')::numeric-used then raise exception 'تغير رصيد أو تسلسل الإهلاك';end if;perform clinic_finance.post('depreciation',v,'إهلاك '||sub||' '||(r.payload->>'month'),null,'5221','1291',a);
 elsif k='tax' then perform clinic_finance.post('tax_assessment',v,'إثبات ضريبة '||r.reference,null,case when r.payload->>'direction'='recoverable' then '1143' else '5231' end,case when r.payload->>'direction'='recoverable' then '5231' else '2144' end,a);
 else
 sh:=null;if r.payload->>'method'='cash' then sh:=(r.payload->>'shift_id')::uuid;perform clinic_finance.check_shift(sh,false);end if;credit:=case r.payload->>'method' when 'cash' then '1111' else '1112' end;
 if k='salary_payment' then if a>clinic_finance.employee_due(sub) then raise exception 'الصرف يتجاوز صافي المرتبات المستحقة';end if;debit:='2131';
 elsif k='advance' then debit:='1142';
 elsif k='asset' then debit:='1211';
 elsif k='statutory_payment' then debit:=r.payload->>'account';if debit not in ('2141','2142','2143') or debit is null then raise exception 'اختر حساب ضريبة الأجور أو التأمينات';end if;select coalesce(sum(l.credit-l.debit),0) into used from clinic_finance.lines l where l.account=r.payload->>'account';if a>used then raise exception 'السداد يتجاوز الالتزام المثبت';end if;
 elsif k='tax_payment' then select * into c from clinic_finance.business_requests where id=(r.payload->>'tax_id')::uuid and kind='tax' and status='approved' and payload->>'direction'='payable';if not found then raise exception 'اختر ضريبة مستحقة معتمدة';end if;select coalesce(sum(amount),0) into used from clinic_finance.business_requests where kind='tax_payment' and status='approved' and payload->>'tax_id'=c.id::text;if a>c.amount-used then raise exception 'السداد يتجاوز الضريبة المستحقة';end if;debit:='2144';end if;
 perform clinic_finance.post('business_'||k,v,r.reference||' — '||sub,sh,debit,credit,a);
 end if;end if;
 update clinic_finance.business_requests set status=case when (p_payload->>'approve')::boolean then 'approved' else 'rejected' end,reviewed_by=me,review_note=p_payload->>'note' where id=v;
else raise exception 'إجراء غير معروف';end if;
insert into clinic_finance.audit(actor,action,entity_id) values(me,'business_'||p_action,v);return v;end $function$

### END
### FUNC clinic_people.holiday_comp_grant()
CREATE OR REPLACE FUNCTION clinic_people.holiday_comp_grant()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
declare v uuid;
begin
  if new.kind = 'holiday_comp' and new.status = 'approved' and old.status <> 'approved'
     and not exists (select 1 from clinic_people.requests c where c.source_request_id = new.id) then
    insert into clinic_people.requests(person_id, kind, from_date, to_date, units, note, status, created_by, reviewed_by, review_note, source_request_id)
    values (new.person_id, 'leave_credit', new.from_date, new.from_date, 1, 'يوم بديل عن العمل في إجازة رسمية (' || new.from_date || ')',
            'approved', new.created_by, new.reviewed_by, new.review_note, new.id)
    returning id into v;
    insert into clinic_people.audit(actor_id, action, record_id, after_data)
    values (new.reviewed_by, 'holiday_comp_credit', new.id, jsonb_build_object('credit_id', v, 'day', new.from_date));
  end if;
  return new;
end $function$

### END
### FUNC clinic_people.holiday_comp_rules()
CREATE OR REPLACE FUNCTION clinic_people.holiday_comp_rules()
 RETURNS trigger
 LANGUAGE plpgsql
 SECURITY DEFINER
 SET search_path TO 'pg_catalog', 'public'
AS $function$
begin
  if new.kind <> 'holiday_comp' then return new; end if;
  if new.to_date <> new.from_date or new.units <> 1 then raise exception 'اليوم البديل عن يوم إجازة رسمية واحد'; end if;
  if new.from_date > (now() at time zone 'Africa/Cairo')::date then raise exception 'اطلب اليوم البديل بعد ما تشتغل يوم الإجازة الرسمية'; end if;
  if not clinic_people.center_closed_on(new.from_date) then raise exception 'اليوم ده مش إجازة رسمية معتمدة للمركز'; end if;
  if not exists (select 1 from clinic_people.device_punches d
                   join clinic_people.device_user_map m on m.device_id = d.device_id and m.device_user_id = d.device_user_id
                  where m.person_id = new.person_id and d.punch in (0, 3, 4) and (d.ts at time zone 'Africa/Cairo')::date = new.from_date)
     and not exists (select 1 from clinic_people.attendance a
                      where a.person_id = new.person_id and a.day = new.from_date and a.status = 'approved' and a.actual_start is not null) then
    raise exception 'مفيش بصمة أو حضور معتمد للموظف في اليوم ده';
  end if;
  return new;
end $function$

### END
