  "functions": [
    {
      "name": "contracting_partner_claim_access",
      "definition": "CREATE OR REPLACE FUNCTION public.contracting_partner_claim_access()\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'auth'\nAS $function$\ndeclare\n  v_uid uuid := auth.uid();\n  v_email text := lower(coalesce(auth.jwt()->>'email',''));\n  v_row public.contracting_partner_users%rowtype;\nbegin\n  if v_uid is null or v_email='' then raise exception 'Authentication required'; end if;\n  select * into v_row from public.contracting_partner_users\n  where active=true and lower(email)=v_email\n  order by created_at asc limit 1;\n  if v_row.id is null then raise exception 'This email is not authorized for a partner account'; end if;\n  if v_row.auth_user_id is null then\n    update public.contracting_partner_users set auth_user_id=v_uid where id=v_row.id;\n    v_row.auth_user_id:=v_uid;\n  elsif v_row.auth_user_id<>v_uid then\n    raise exception 'Partner account is linked to another user';\n  end if;\n  return jsonb_build_object('entity_id',v_row.entity_id,'name',v_row.full_name,'role',v_row.role_key);\nend;\n$function$\n",
      "identity_args": "",
      "security_definer": true,
      "acl_before_change": "{=X/postgres,postgres=X/postgres,anon=X/postgres,authenticated=X/postgres,service_role=X/postgres}",
      "proconfig_before_change": [
        "search_path=public, auth"
      ]
    },
    {
      "name": "contracting_partner_snapshot",
      "definition": "CREATE OR REPLACE FUNCTION public.contracting_partner_snapshot(p_entity_id uuid)\n RETURNS jsonb\n LANGUAGE sql\n STABLE\n SET search_path TO 'pg_catalog', 'public'\nAS $function$\n  with r as (\n    select count(*) referrals,\n      count(*) filter (where status in ('confirmed','attended','completed','collected')) confirmed,\n      count(*) filter (where status in ('attended','completed','collected')) attended,\n      count(*) filter (where status in ('completed','collected')) completed\n    from public.contracting_referrals where entity_id=p_entity_id\n  ), t as (\n    select coalesce(sum(eligible_amount) filter (where eligible),0) eligible_revenue\n    from public.contracting_partner_transactions where entity_id=p_entity_id\n  )\n  select jsonb_build_object(\n    'referrals',r.referrals,'confirmed',r.confirmed,'attended',r.attended,'completed',r.completed,\n    'eligible_revenue',t.eligible_revenue,\n    'incentive',public.contracting_progressive_incentive(t.eligible_revenue,p_entity_id,'standard')\n  ) from r,t;\n$function$\n",
      "identity_args": "p_entity_id uuid",
      "security_definer": false,
      "acl_before_change": "{=X/postgres,postgres=X/postgres,anon=X/postgres,authenticated=X/postgres,service_role=X/postgres}",
      "proconfig_before_change": null
    },
    {
      "name": "contracting_partner_staff_dashboard",
      "definition": "CREATE OR REPLACE FUNCTION public.contracting_partner_staff_dashboard()\n RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'auth'\nAS $function$\ndeclare\n  v_entity uuid;\n  v_entity_name text;\n  v_revenue numeric := 0;\n  v_incentive numeric := 0;\n  v_referrals integer := 0;\n  v_confirmed integer := 0;\n  v_attended integer := 0;\n  v_completed integer := 0;\nbegin\n  select u.entity_id into v_entity from public.contracting_partner_users u\n  where u.auth_user_id=auth.uid() and u.active=true limit 1;\n  if v_entity is null then raise exception 'Partner access is not authorized'; end if;\n  select name into v_entity_name from public.contracting_entities where id=v_entity;\n  select count(*),count(*) filter(where status in('confirmed','attended','completed','collected')),\n    count(*) filter(where status in('attended','completed','collected')),\n    count(*) filter(where status in('completed','collected'))\n  into v_referrals,v_confirmed,v_attended,v_completed\n  from public.contracting_referrals where entity_id=v_entity;\n  select coalesce(sum(eligible_amount) filter(where eligible),0) into v_revenue\n  from public.contracting_partner_transactions where entity_id=v_entity;\n  v_incentive:=public.contracting_progressive_incentive(v_revenue,v_entity,'standard');\n  return jsonb_build_object(\n    'entity_id',v_entity,'entity_name',v_entity_name,\n    'referrals',v_referrals,'confirmed',v_confirmed,'attended',v_attended,'completed',v_completed,\n    'eligible_revenue',v_revenue,'incentive',v_incentive,\n    'recent_referrals',coalesce((select jsonb_agg(x) from (\n      select id,left(coalesce(patient_name,'مريض'),1)||'***' patient,status,created_at,specialty\n      from public.contracting_referrals where entity_id=v_entity order by created_at desc limit 30\n    ) x),'[]'::jsonb),\n    'settlements',coalesce((select jsonb_agg(x) from (\n      select period_start,period_end,eligible_revenue,incentive_amount,status\n      from public.contracting_settlements where entity_id=v_entity order by period_end desc limit 12\n    ) x),'[]'::jsonb)\n  );\nend;\n$function$\n",
      "identity_args": "",
      "security_definer": true,
      "acl_before_change": "{=X/postgres,postgres=X/postgres,anon=X/postgres,authenticated=X/postgres,service_role=X/postgres}",
      "proconfig_before_change": [
        "search_path=public, auth"
      ]
    },
    {
      "name": "contracting_progressive_incentive",
      "definition": "CREATE OR REPLACE FUNCTION public.contracting_progressive_incentive(p_amount numeric, p_entity_id uuid DEFAULT NULL::uuid, p_preset_key text DEFAULT 'standard'::text)\n RETURNS numeric\n LANGUAGE plpgsql\n STABLE\n SET search_path TO 'pg_catalog', 'public'\nAS $function$\ndeclare\n  r record;\n  v_amount numeric := greatest(coalesce(p_amount,0),0);\n  v_total numeric := 0;\n  v_slice numeric;\nbegin\n  for r in\n    select min_amount,max_amount,rate_percent\n    from public.contracting_incentive_tiers\n    where active=true\n      and ((p_entity_id is not null and entity_id=p_entity_id)\n        or (entity_id is null and preset_key=p_preset_key\n            and not exists(select 1 from public.contracting_incentive_tiers z where z.entity_id=p_entity_id and z.active=true)))\n    order by sort_order,min_amount\n  loop\n    if v_amount <= r.min_amount then continue; end if;\n    v_slice := least(v_amount,coalesce(r.max_amount,v_amount)) - r.min_amount;\n    if v_slice > 0 then v_total := v_total + (v_slice * r.rate_percent / 100); end if;\n  end loop;\n  return round(v_total,2);\nend;\n$function$\n",
      "identity_args": "p_amount numeric, p_entity_id uuid, p_preset_key text",
      "security_definer": false,
      "acl_before_change": "{=X/postgres,postgres=X/postgres,anon=X/postgres,authenticated=X/postgres,service_role=X/postgres}",
      "proconfig_before_change": null
    }
